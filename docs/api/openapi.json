{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "description": "Run one action with typed arguments.",
        "properties": {
          "action": {
            "maxLength": 48,
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "args": {
            "additionalProperties": true,
            "default": {},
            "title": "Args",
            "type": "object"
          },
          "device": {
            "maxLength": 48,
            "minLength": 1,
            "title": "Device",
            "type": "string"
          },
          "kind": {
            "const": "action",
            "default": "action",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "device",
          "action"
        ],
        "title": "Action",
        "type": "object"
      },
      "DryRunBody": {
        "additionalProperties": false,
        "properties": {
          "commands": {
            "items": {
              "discriminator": {
                "mapping": {
                  "action": "#/components/schemas/Action",
                  "write": "#/components/schemas/Write"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Write"
                },
                {
                  "$ref": "#/components/schemas/Action"
                }
              ]
            },
            "maxItems": 200,
            "title": "Commands",
            "type": "array"
          }
        },
        "required": [
          "commands"
        ],
        "title": "DryRunBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PairBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 6,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PairBody",
        "type": "object"
      },
      "ReadBody": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "device": {
            "title": "Device",
            "type": "string"
          }
        },
        "required": [
          "device",
          "channel"
        ],
        "title": "ReadBody",
        "type": "object"
      },
      "ReadManyBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReadBody"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ReadManyBody",
        "type": "object"
      },
      "RejectBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "",
            "maxLength": 200,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "RejectBody",
        "type": "object"
      },
      "StopBody": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "stop requested",
            "maxLength": 200,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "StopBody",
        "type": "object"
      },
      "TightenBody": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "device": {
            "title": "Device",
            "type": "string"
          },
          "max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          }
        },
        "required": [
          "device",
          "channel"
        ],
        "title": "TightenBody",
        "type": "object"
      },
      "UnlockBody": {
        "additionalProperties": false,
        "properties": {
          "phrase": {
            "maxLength": 40,
            "title": "Phrase",
            "type": "string"
          }
        },
        "required": [
          "phrase"
        ],
        "title": "UnlockBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Write": {
        "additionalProperties": false,
        "description": "Set one write channel. Numeric values must carry a unit.",
        "properties": {
          "channel": {
            "maxLength": 48,
            "minLength": 1,
            "title": "Channel",
            "type": "string"
          },
          "device": {
            "maxLength": 48,
            "minLength": 1,
            "title": "Device",
            "type": "string"
          },
          "kind": {
            "const": "write",
            "default": "write",
            "title": "Kind",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "device",
          "channel",
          "value"
        ],
        "title": "Write",
        "type": "object"
      }
    }
