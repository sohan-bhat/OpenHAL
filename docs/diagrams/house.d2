classes: {
  box: {
    style: {
      fill: ${surface}
      stroke: ${line}
      stroke-width: 2
      border-radius: 6
      font-color: ${text}
      font-size: 14
      bold: false
    }
  }
  actor: {
    style: {
      fill: ${surface}
      stroke: ${line}
      stroke-width: 2
      border-radius: 6
      font-color: ${text}
      font-size: 14
      bold: true
    }
  }
  group: {
    style: {
      fill: transparent
      stroke: ${border}
      stroke-width: 2
      border-radius: 6
      font-color: ${text2}
      font-size: 13
      bold: true
    }
  }
  note: {
    shape: rectangle
    style: {
      fill: ${surface}
      stroke: ${border}
      stroke-width: 2
      border-radius: 6
      font-color: ${text}
      font-size: 13
    }
  }
  msg: {
    style: {
      stroke: ${text2}
      stroke-width: 2
      font: mono
      italic: false
      font-size: 13
      font-color: ${text}
    }
  }
  blocked: {
    style: {
      stroke: ${blocked}
      stroke-width: 2
      font: mono
      italic: false
      font-size: 13
      font-color: ${blocked}
    }
  }
  granted: {
    style: {
      stroke: ${ok}
      stroke-width: 2
      font: mono
      italic: false
      font-size: 13
      font-color: ${ok}
    }
  }
  notification: {
    style: {
      stroke: ${text2}
      stroke-width: 2
      stroke-dash: 4
      font: mono
      italic: false
      font-size: 13
      font-color: ${text}
    }
  }
}
