vars: @theme-light

grid-rows: 2
grid-columns: 5
horizontal-gap: 90
vertical-gap: 48

classes: {
  node: {
    width: 112
    height: 88
    label.near: top-center
    style: {
      fill: ${surface}
      stroke: ${line}
      stroke-width: 2
      border-radius: 6
      font-color: ${text}
      font-size: 15
      bold: true
    }
  }
  detail: {
    shape: text
    style: {
      font-color: ${text2}
      font-size: 13
      bold: false
    }
  }
  spacer: {
    width: 112
    height: 52
    style.opacity: 0
  }
  wire: {
    style: {
      stroke: ${accent}
      stroke-width: 2
      font: mono
      font-size: 13
      font-color: ${text2}
    }
  }
}

client: "AI client" {
  class: node
  who: "Claude, Cursor,\nany MCP client" {class: detail}
}
hub: "OpenHAL hub" {
  class: node
  files: "Device files" {
    width: 96
    height: 30
    style: {fill: ${surface}; stroke: ${line}; stroke-width: 1; border-radius: 4; font-size: 13; font-color: ${text2}; bold: false}
  }
}
kernel: "Safety kernel" {
  class: node
  checks: "units, range,\nrate, interlocks" {class: detail}
}
driver: "Driver" {
  class: node
  grant: "acts on a\nsingle-use grant" {class: detail}
}
device: "Arduino\nplant waterer" {class: node}

gap1: "" {class: spacer}
gap2: "" {class: spacer}
blocked: "Blocked" {
  class: node
  height: 52
  label.near: center-center
  style: {stroke: ${blocked}; font-color: ${blocked}; fill: ${blocked-fill}}
}
gap3: "" {class: spacer}
gap4: "" {class: spacer}

client -> hub: "hal/action" {class: wire}
hub.files -> kernel: "check" {class: wire}
kernel -> driver: "grant" {class: wire}
driver -> device: "command" {class: wire}
kernel -> blocked: "INTERLOCK_BLOCKED:\ntank empty" {class: wire; style.stroke: ${blocked}; style.font-color: ${blocked}}
client <- device: "reading" {class: wire; style.stroke: ${line}; style.stroke-width: 1}
