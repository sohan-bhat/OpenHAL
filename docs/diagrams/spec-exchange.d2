vars: @theme-light
...@house

shape: sequence_diagram

c: "Client" {class: actor}
h: "Hub" {class: actor}
k: "Safety kernel" {class: actor}
d: "Driver" {class: actor}
v: "Device" {class: actor}

c -> h: "hal/write\nnozzle 300 °C" {class: msg}
h -> k: "evaluate" {class: msg}
k -> h: "blocked\nabove_max" {class: blocked}
h -> c: "error -32010\nLIMIT_EXCEEDED" {class: blocked}

c -> h: "hal/write\nbed 70 °C" {class: msg}
h -> k: "evaluate" {class: msg}
k -> k: "checks pass,\nissue a Grant" {class: msg}
k -> d: "write bed_target\nwith the Grant" {class: granted}
d -> d: "consume it" {class: msg}
d -> v: "bed heater\nto 70 °C" {class: msg}
v -> d: "ok" {class: msg}
d -> k: "done" {class: msg}
k -> h: "done" {class: msg}
h -> c: "result\nstatus done" {class: granted}
