[3.06, "o", "\r\n"]
[3.08, "o", "config folder  ~/.openhal (mode 0700)\r\n"]
[3.1, "o", "settings       ~/.openhal/config.yaml created\r\n"]
[3.12, "o", "human token    ~/.openhal/human.token created (mode 0600)\r\n"]
[3.14, "o", "sample device  ~/.openhal/devices/plant-waterer.hal.yaml created, read-only until you confirm it\r\n"]
[3.16, "o", "Search for devices? Discovery only sends read-only identify commands. [Y/n]: "]
[3.48, "o", "n\r\nToken for your AI client. Scope read, control_low, control_medium or skip [read]: "]
[4.25, "o", "skip\r\nRun the hub in the background, starting at login? [y/N]: "]
[4.42, "o", "\r\n\r\nNext steps\r\n1. Confirm the sample's limits with openhal file confirm ~/.openhal/devices/plant-waterer.hal.yaml\r\n2. Start OpenHAL with openhal start, then check the hub with openhal status\r\n3. Create a token for your AI client with openhal token create --agent --scope control_low --name claude\r\n4. Add openhal mcp to the client. docs/interfaces/MCP.md has the config for each client\r\n5. Run openhal doctor whenever something looks wrong\r\n"]
[4.82, "o", "\u001b[2m# A simulated desk lamp joins the plant waterer, with limits a person already confirmed.\u001b[0m\r\n"]
[5.22, "o", "\u001b[2m# OpenHAL runs in a second terminal with openhal start.\u001b[0m\r\n"]
