[6.44, "o", "setup     ~/.openhal is \u001b[32mset up\u001b[0m                           \r\nhub       \u001b[32mrunning\u001b[0m at http://127.0.0.1:7431 as human:owner\r\ndevices   desk-lamp and plant-waterer \u001b[32mconnected\u001b[0m          \r\nrequests  none held for a person                         \r\n"]
[6.46, "o", "\r\n\u001b[1mNext\u001b[0m\r\n"]
[6.48, "o", "openhal file confirm  answer each limit of plant-waterer, read-only until then\r\nopenhal devices       list the devices and the channels of each               \r\nopenhal limits        see and change each device's limits                     \r\n"]
[6.5, "o", "\r\nopenhal --help lists every command.\r\n"]
