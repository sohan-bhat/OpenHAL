[1.6, "o", "\u001b[1mOpenHAL\u001b[0m 0.1.0.dev0\r\n\r\n"]
[1.62, "o", "setup  ~/.openhal is \u001b[33mnot set up\u001b[0m yet        \r\nhub    \u001b[33mnot running\u001b[0m at http://127.0.0.1:7431\r\n"]
[1.64, "o", "\r\n\u001b[1mNext\u001b[0m\r\n"]
[1.66, "o", "openhal init  set up the config folder, the human token and a simulated plant waterer\r\nopenhal demo  watch an agent babysit a simulated 3D print, with nothing to set up    \r\n"]
[1.68, "o", "\r\nopenhal --help lists every command.\r\n"]
