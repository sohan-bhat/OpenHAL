    "stale-hash": "device: Hash fan\nid: hash-fan\nconnect: { mock: fan }\nwrite:\n  speed: { unit: percent, min: 0, max: 100 }\nsafe_state: { speed: 0 }\nhazard: low\nconfirmed: { by: owner, at: 2026-10-24, sha256: deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef }\n",
    "bound-hash": "device: Hash fan\nid: hash-fan\nconnect: { mock: fan }\nwrite:\n  speed: { unit: percent, min: 0, max: 100 }\nsafe_state: { speed: 0 }\nhazard: low\nconfirmed: { by: owner, at: 2026-10-24, sha256: 67ed889d3f453287147d968aa893e8615203b8aad7b356b88d36e20ffe8a2448 }\n",
    "hot-fan": "device: Hot fan\nid: hot-fan\nconnect: { mock: fan }\nread:\n  temperature: { unit: degC, every: 1 s }\nwrite:\n  fan_speed: { unit: percent, min: 0, max: 100 }\nsafe_state: { fan_speed: 0 }\ninterlocks:\n  - if: \"fan_speed > 50 %\"\n    require: \"temperature < 35 degC\"\nhazard: low\nconfirmed: { by: owner, at: 2026-10-24 }\n",
    "waterer": "device: Parity plant waterer\nid: parity-waterer\nconnect: { mock: waterer }\nread:\n  soil_moisture: { unit: percent, every: 1 s, range: [0, 100] }\n  tank: { type: enum, values: [empty, ok], every: 1 s }\nwrite:\n  pump: { type: bool }\nactions:\n  water:\n    args:\n      duration: { unit: s, min: 1, max: 30 }\n    require:\n      - { condition: \"tank == ok\", message: \"pump can't run while tank is empty\" }\n    max_runs: { count: 3, per: 1 h }\n    effects: [pump]\nsafe_state: { pump: false }\nwatchdog:\n  heartbeat: 2 s\n  on_loss: safe_state\nhazard: low\nconfirmed: { by: owner, at: 2026-10-24 }\n"
  },
