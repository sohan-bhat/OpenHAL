---
import { specPages } from "../../lib/spec";
import { readVersions } from "../../lib/spec-meta.mjs";
import { versionRows } from "../../lib/versions";
import Picker from "./Picker.astro";

interface Props {
  place?: "header" | "menu";
}

const { place = "header" } = Astro.props;
const { versions, latest } = readVersions();
const { current, rows } = versionRows(Astro.url.pathname, versions, latest, await specPages());
const items = rows.map((row) => ({ label: row.label, href: row.href, current: row.current, page: row.href === Astro.url.pathname }));
---

{current && <Picker id={place === "menu" ? "oh-version-menu" : "oh-version"} kind="version" label="Specification version" items={items} />}
