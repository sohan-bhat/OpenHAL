---
import Default from "@astrojs/starlight/components/Footer.astro";
import { PRODUCT_NAME } from "../../config/brand";
import { REPOSITORY_URL } from "../../config/site";
---

<Default />
<div class="oh-site-footer">
  <p><strong>{PRODUCT_NAME}</strong> <span class="muted">is an open protocol, released under Apache 2.0.</span></p>
  <p class="muted">{PRODUCT_NAME} is not affiliated with Anthropic or MHS.</p>
  <p><a href={REPOSITORY_URL} rel="noopener">Source on GitHub</a></p>
</div>

<style>
  .oh-site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--text);
  }

  .oh-site-footer p {
    margin: 0;
  }

  .oh-site-footer a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
</style>
