---
import SidebarNav, { type NavEntry } from "../islands/SidebarNav";
import { inlineScript } from "../../lib/inline-script";
import { sections } from "../../lib/sections";
import sidebarSource from "../../lib/sidebar.ts?raw";
import MobileMenuFooter from "./MobileMenuFooter.astro";

type RouteEntry = typeof Astro.locals.starlightRoute.sidebar[number];

const links = await sections(Astro.url.pathname);
const route = Astro.locals.starlightRoute.sidebar;
const menuOnly = route.length === 0;

/** Starlight's route data for the island, keeping only what the sidebar shows. */
function entries(list: RouteEntry[]): NavEntry[] {
  return list.map((entry) => {
    const badge = entry.badge ? { badge: entry.badge.text } : {};
    if (entry.type === "group") return { label: entry.label, entries: entries(entry.entries), ...(entry.collapsed ? { closed: true } : {}), ...badge };
    const attrs = Object.fromEntries(Object.entries(entry.attrs).filter((pair): pair is [string, string | number | boolean] => ["string", "number", "boolean"].includes(typeof pair[1])));
    return { label: entry.label, href: entry.href, ...(entry.isCurrent ? { current: true } : {}), ...badge, ...(Object.keys(attrs).length ? { attrs } : {}) };
  });
}

/** Names a section's sidebar by its labels and links, the same on every page of the section. */
function hashOf(list: RouteEntry[]): string {
  const text = JSON.stringify(list, (key, value) => (key === "isCurrent" ? undefined : value));
  let hash = 2166136261;
  for (let index = 0; index < text.length; index++) hash = Math.imul(hash ^ text.charCodeAt(index), 16777619);
  return (hash >>> 0).toString(36);
}

const restore = menuOnly ? "" : await inlineScript(`${sidebarSource}\nrestore(document.currentScript.previousElementSibling);`, "sidebar.ts", { iife: true });
---

<ul class="oh-menu-sections md:sl-hidden" data-menu-only={menuOnly ? "" : undefined}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} aria-current={link.current ? "page" : undefined}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
{!menuOnly && <SidebarNav client:intent="mod+b" entries={entries(route)} hash={hashOf(route)} />}
{!menuOnly && <script is:inline set:html={restore} />}
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .oh-menu-sections {
    margin: 0;
    padding: 0 0 var(--s-3);
    border-bottom: 1px solid var(--border);
    list-style: none;
  }

  .oh-menu-sections li + li {
    margin-top: 2px;
  }

  .oh-menu-sections a {
    display: block;
    padding: var(--s-2) var(--s-2);
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--t-body);
    font-weight: 600;
    text-decoration: none;
  }

  .oh-menu-sections a:hover {
    background: var(--surface);
  }

  .oh-menu-sections a[aria-current="page"] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .oh-menu-sections[data-menu-only] {
    border-bottom: 0;
  }
</style>
