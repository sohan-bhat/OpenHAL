---
import SidebarNav from "../islands/SidebarNav";
import { inlineScript } from "../../lib/inline-script";
import { navEntries } from "../../lib/nav-entries";
import { sections } from "../../lib/sections";
import sidebarSource from "../../lib/sidebar.ts?raw";
import MobileMenuFooter from "./MobileMenuFooter.astro";

type RouteEntry = typeof Astro.locals.starlightRoute.sidebar[number];

const links = await sections(Astro.url.pathname);
const route = Astro.locals.starlightRoute.sidebar;
const menuOnly = route.length === 0;

/** Names a section's sidebar by its labels and links, the same on every page of the section. */
function hashOf(list: RouteEntry[]): string {
  const text = JSON.stringify(list, (key, value) => (key === "isCurrent" ? undefined : value));
  let hash = 2166136261;
  for (let index = 0; index < text.length; index++) hash = Math.imul(hash ^ text.charCodeAt(index), 16777619);
  return (hash >>> 0).toString(36);
}

const restore = menuOnly ? "" : await inlineScript(`${sidebarSource}\nrestore(document.currentScript.previousElementSibling);`, "sidebar.ts", { iife: true });
---

<ul class="oh-menu-sections md:sl-hidden" data-menu-only={menuOnly ? "" : undefined}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} aria-current={link.current ? "page" : undefined}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
{!menuOnly && <SidebarNav client:intent="tab" entries={navEntries(route)} hash={hashOf(route)} />}
{!menuOnly && <script is:inline set:html={restore} />}
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .oh-menu-sections {
    margin: 0;
    padding: 0 0 var(--s-3);
    border-bottom: 1px solid var(--border);
    list-style: none;
  }

  .oh-menu-sections li + li {
    margin-top: 2px;
  }

  .oh-menu-sections a {
    position: relative;
    display: block;
    padding: var(--s-2) var(--s-2);
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--t-body);
    font-weight: 600;
    text-decoration: none;
  }

  .oh-menu-sections a:hover {
    background: var(--surface);
  }

  .oh-menu-sections a[aria-current="page"] {
    font-weight: 700;
    background: var(--oh-highlight);
  }

  .oh-menu-sections a[aria-current="page"]::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(-1 * var(--s-2));
    width: 2px;
    background: var(--accent);
  }

  .oh-menu-sections[data-menu-only] {
    border-bottom: 0;
  }

  @media (max-width: 49.99rem) and (scripting: enabled) {
    .oh-menu-sections {
      border-bottom: 0;
    }

    :global(#starlight__sidebar [data-slot="sidebar-wrapper"]) {
      display: none;
    }
  }
</style>
