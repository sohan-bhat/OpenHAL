---
import { Icon } from "@astrojs/starlight/components";

export interface PickerItem {
  label: string;
  current: boolean;
  href?: string;
  page?: boolean;
  value?: string;
}

interface Props {
  id: string;
  kind: "version" | "theme" | "section";
  label: string;
  items: PickerItem[];
  placeholder?: string;
  align?: "start" | "end";
  class?: string;
}

const { id, kind, label, items, placeholder, align = "end", class: className } = Astro.props;
const list = `${id}-list`;
const none = !items.some((item) => item.current);
---

<oh-picker class:list={["oh-picker", className]} data-kind={kind} data-align={align}>
  <button type="button" class="oh-picker-button" popovertarget={list} aria-haspopup="menu" aria-controls={list}>
    {!(placeholder && none) && <span class="sr-only">{label}</span>}
    <span class="oh-picker-value">
      {items.map((item) => <span data-value={item.value} data-current={item.current ? "" : undefined}>{item.label}</span>)}
      {placeholder && <span data-current={none ? "" : undefined}>{placeholder}</span>}
    </span>
    <Icon name="down-caret" class="oh-picker-caret" size="1.125rem" />
  </button>
  <div id={list} class="oh-picker-list" popover="auto" role="menu" aria-label={label}>
    {
      items.map((item) =>
        item.href ? (
          <a role="menuitem" href={item.href} aria-current={item.current ? (item.page ? "page" : "true") : undefined}>{item.label}</a>
        ) : (
          <button type="button" role="menuitemradio" aria-checked={item.current ? "true" : "false"} data-value={item.value}>{item.label}</button>
        ),
      )
    }
  </div>
</oh-picker>

<style>
  .oh-picker {
    display: inline-flex;
  }

  .oh-picker-button {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 36px;
    padding: 0 var(--s-1) 0 var(--s-2);
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
  }

  .oh-picker-button:is(:hover, :has(+ :popover-open)) {
    color: var(--text);
    background: var(--surface);
  }

  .oh-picker-value {
    display: grid;
    text-align: start;
  }

  .oh-picker-value > * {
    grid-area: 1 / 1;
  }

  .oh-picker-value > :not([data-current]) {
    visibility: hidden;
  }

  .oh-picker-button :global(.oh-picker-caret) {
    flex: none;
  }

  .oh-picker-list {
    inset: auto;
    margin: 0;
    min-width: 7rem;
    padding: var(--s-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
  }

  .oh-picker-list[data-closing] {
    display: block;
    pointer-events: none;
  }

  .oh-picker-list > * {
    display: block;
    width: 100%;
    padding: 6px var(--s-3);
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: var(--t-small);
    line-height: 1.4;
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .oh-picker-list > :hover {
    background: var(--surface);
  }

  .oh-picker-list > :is([aria-current], [aria-checked="true"]) {
    background: var(--oh-highlight);
    color: var(--accent);
  }

  .oh-picker-list > :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  @supports (anchor-scope: all) and (position-area: block-end) {
    .oh-picker {
      anchor-scope: --oh-picker;
    }

    .oh-picker-button {
      anchor-name: --oh-picker;
    }

    .oh-picker-list {
      position-anchor: --oh-picker;
      position-area: block-end span-inline-start;
      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
      margin-block-start: var(--s-1);
      min-width: max(anchor-size(width), 7rem);
    }

    .oh-picker[data-align="start"] .oh-picker-list {
      position-area: block-end span-inline-end;
    }
  }
</style>
