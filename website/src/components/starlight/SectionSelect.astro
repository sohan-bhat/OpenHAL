---
import type { Section } from "../../lib/sections";
import Picker from "./Picker.astro";

interface Props {
  links: Section[];
}

const { links } = Astro.props;
const items = links.map((link) => ({ label: link.label, href: link.href, current: link.current, page: true }));
---

<Picker id="oh-section" class="oh-section-select" kind="section" label="Section" placeholder="Sections" align="start" items={items} />
