---
import LinkMenu from "../islands/LinkMenu";
import type { Section } from "../../lib/sections";

interface Props {
  links: Section[];
}

const { links } = Astro.props;
const items = links.map((link) => ({ label: link.label, href: link.href, current: link.current, page: true }));
---

<div class="oh-section-select">
  <LinkMenu client:intent kind="section" label="Section" placeholder="Sections" align="start" items={items} />
</div>
