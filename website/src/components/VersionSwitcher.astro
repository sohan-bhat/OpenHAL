---
import { readVersions } from "../lib/spec-meta.mjs";

interface Props {
  current: string;
  slug: string;
  available: Record<string, string[]>;
}

const { current, slug, available } = Astro.props;
const { versions, latest } = readVersions();
const target = (version: string) => {
  const slugs = available[version] ?? [];
  return slugs.includes(slug) ? (slug ? `/spec/${version}/${slug}/` : `/spec/${version}/`) : `/spec/${version}/`;
};
---

<details class="switcher">
  <summary>
    <span class="legend">Version</span>
    <span class="mono">{current}</span>
    {current === latest && <span class="tag">latest</span>}
  </summary>
  <ul>
    {
      versions.map((item) => (
        <li>
          <a href={target(item.version)} aria-current={item.version === current ? "page" : undefined}>
            <span class="mono">{item.version}</span>
            {item.latest && <span class="tag">latest</span>}
            {item.status && <span class="muted">{item.status}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .switcher {
    margin-bottom: var(--s-4);
    border: var(--rule);
    border-radius: var(--radius);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-3);
    cursor: pointer;
    font-weight: 700;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: var(--s-1) var(--s-2) var(--s-2);
    border-top: var(--rule);
  }

  a {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    padding: var(--s-1) var(--s-2);
    border-radius: 4px;
    color: var(--text);
    text-decoration: none;
  }

  a[aria-current="page"] {
    color: var(--accent);
    font-weight: 700;
  }

  .tag {
    font-size: var(--t-legend);
    font-weight: 700;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0 var(--s-1);
    line-height: 1.5;
  }
</style>
