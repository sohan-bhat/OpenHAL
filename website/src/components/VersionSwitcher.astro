---
import { specPages } from "../lib/spec";
import { readVersions } from "../lib/spec-meta.mjs";
import { type VersionRow, versionRows } from "../lib/versions";

interface Props {
  menu?: boolean;
}

const { menu = false } = Astro.props;
const { versions, latest } = readVersions();
const path = Astro.url.pathname;
const { current, rows } = versionRows(path, versions, latest, await specPages());
const mark = (row: VersionRow) => (row.current ? (row.href === path ? "page" : "true") : undefined);
---

{
  current &&
    (menu ? (
      <div class="versions">
        <p class="legend">Specification version</p>
        {rows.map((row) => (
          <a href={row.href} aria-current={mark(row)}>
            <span>{row.version}</span>
            {row.note && <span class="muted">{row.note}</span>}
          </a>
        ))}
      </div>
    ) : (
      <Fragment>
        <button type="button" class="version-button" popovertarget="version-menu" aria-expanded="false">
          <span class="visually-hidden">Specification version </span>
          {current}
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5"></path>
          </svg>
        </button>
        <div id="version-menu" class="versions" popover>
          {rows.map((row) => (
            <a href={row.href} aria-current={mark(row)}>
              <span>{row.version}</span>
              {row.note && <span class="muted">{row.note}</span>}
            </a>
          ))}
        </div>
      </Fragment>
    ))
}
