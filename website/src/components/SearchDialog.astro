---
import { navLinks } from "../config/site";

const sections = navLinks(true)
  .filter((link) => !link.external && link.href !== "/" && link.href !== "/docs/")
  .map((link) => ({ prefix: link.match[0] ?? link.href, label: link.label }));
sections.push({ prefix: "/docs/", label: "Docs" }, { prefix: "/sdks/", label: "SDKs" }, { prefix: "/inspector/", label: "Inspector" });
---

<dialog id="site-search" class="search-dialog" aria-labelledby="site-search-title" data-src="/pagefind/pagefind.js" data-sections={JSON.stringify(sections)}>
  <h2 id="site-search-title" class="visually-hidden">Search the site</h2>
  <form class="search-bar" role="search" method="dialog" data-search-form>
    <svg class="search-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
    </svg>
    <label class="visually-hidden" for="site-search-input">Search the specification, guides, drivers and device files</label>
    <input
      id="site-search-input"
      type="search"
      name="q"
      placeholder="Search..."
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      aria-describedby="site-search-status"
      aria-controls="site-search-results"
      data-search-input
    />
    <button type="button" class="search-close" data-search-close>
      <kbd>Esc</kbd><span class="visually-hidden"> Close search</span>
    </button>
  </form>
  <p id="site-search-status" class="search-status" aria-live="polite" data-search-status>Type to search the specification, guides, drivers and device files.</p>
  <ol id="site-search-results" class="search-results" aria-label="Search results" data-search-results hidden></ol>
</dialog>

<script>
  interface PagefindResult {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results?: Array<{ title: string; url: string; excerpt: string; locations?: number[] }>;
  }

  interface Pagefind {
    options?: (options: { excerptLength?: number }) => Promise<void>;
    init?: () => Promise<void>;
    search: (term: string) => Promise<{ results: Array<{ id: string; data: () => Promise<PagefindResult> }> } | null>;
  }

  const LIMIT = 8;
  const CHECKED = 24;
  const dialog = document.querySelector<HTMLDialogElement>("#site-search");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const list = dialog?.querySelector<HTMLOListElement>("[data-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-search-status]");
  const sections = JSON.parse(dialog?.dataset.sections ?? "[]") as Array<{ prefix: string; label: string }>;
  const idle = status?.textContent ?? "";
  let engine: Promise<Pagefind | null> | null = null;
  let latest = 0;

  function load(): Promise<Pagefind | null> {
    if (!engine) {
      const source = new URL(dialog?.dataset.src ?? "/pagefind/pagefind.js", window.location.href).href;
      engine = import(source)
        .then(async (module: Pagefind) => {
          await module.options?.({ excerptLength: 20 });
          await module.init?.();
          return module;
        })
        .catch(() => null);
    }
    return engine;
  }

  function sectionOf(url: string): string {
    const path = new URL(url, window.location.href).pathname;
    const base = new URL(dialog?.dataset.src ?? "/pagefind/pagefind.js", window.location.href).pathname.replace(/pagefind\/pagefind\.js$/, "");
    const local = `/${path.slice(base.length)}`;
    return sections.filter((item) => local.startsWith(item.prefix)).sort((a, b) => b.prefix.length - a.prefix.length)[0]?.label ?? "Overview";
  }

  function bestPart(result: PagefindResult) {
    const parts = (result.sub_results ?? []).filter((part) => part.url !== result.url && part.title !== result.meta.title);
    const best = parts.sort((a, b) => (b.locations?.length ?? 0) - (a.locations?.length ?? 0))[0];
    return best ?? null;
  }

  function resultItem(result: PagefindResult, index: number): HTMLLIElement {
    const part = bestPart(result);
    const title = result.meta.title ?? part?.title ?? result.url;
    const item = document.createElement("li");
    const link = document.createElement("a");
    link.href = part?.url ?? result.url;
    link.id = `site-search-result-${index}`;
    link.className = "search-result";
    const head = document.createElement("span");
    head.className = "result-head";
    const name = document.createElement("span");
    name.className = "result-title";
    name.textContent = title;
    head.append(name);
    if (part && part.title && part.title !== title) {
      const section = document.createElement("span");
      section.className = "result-part";
      section.textContent = part.title;
      head.append(section);
    }
    const where = document.createElement("span");
    where.className = "result-where";
    where.textContent = sectionOf(result.url);
    const excerpt = document.createElement("span");
    excerpt.className = "result-excerpt";
    excerpt.innerHTML = part?.excerpt ?? result.excerpt;
    link.append(where, head, excerpt);
    item.append(link);
    return item;
  }

  async function run(term: string) {
    if (!list || !status) return;
    const ticket = ++latest;
    const query = term.trim();
    if (!query) {
      list.replaceChildren();
      list.hidden = true;
      status.textContent = idle;
      return;
    }
    const pagefind = await load();
    if (ticket !== latest) return;
    if (!pagefind) {
      list.hidden = true;
      status.textContent = "Search needs the index that pnpm build makes. This build has none.";
      return;
    }
    const found = await pagefind.search(query);
    const loaded = await Promise.all((found?.results ?? []).slice(0, CHECKED).map((result) => result.data()));
    if (ticket !== latest) return;
    const words = query.toLowerCase().split(/[^\p{L}\p{N}_]+/u).filter(Boolean);
    const results = loaded.filter((result) => relevant(result, words));
    list.replaceChildren(...results.slice(0, LIMIT).map(resultItem));
    list.hidden = results.length === 0;
    const total = results.length === CHECKED ? (found?.results.length ?? CHECKED) : results.length;
    status.textContent =
      total === 0 ? `No page matches “${query}”.` : total > LIMIT ? `${total} pages match. The best ${LIMIT} are below.` : `${total} ${total === 1 ? "page matches" : "pages match"}.`;
  }

  function relevant(result: PagefindResult, words: string[]): boolean {
    const text = [result.excerpt, ...(result.sub_results ?? []).map((part) => part.excerpt)].join(" ");
    const marks = [...text.matchAll(/<mark>([^<]*)<\/mark>/g)].map((match) => match[1].toLowerCase());
    const title = (result.meta.title ?? "").toLowerCase();
    return words.some((word) => title.includes(word) || marks.some((mark) => mark.startsWith(word.slice(0, 3))));
  }

  function links(): HTMLAnchorElement[] {
    return [...(list?.querySelectorAll<HTMLAnchorElement>("a.search-result") ?? [])];
  }

  function open() {
    if (!dialog || !input) return;
    if (!dialog.open) dialog.showModal();
    input.focus();
    input.select();
    void load();
  }

  if (dialog && input && list) {
    for (const button of document.querySelectorAll<HTMLElement>("[data-search-open]")) {
      button.addEventListener("click", open);
      button.addEventListener("pointerenter", () => void load(), { once: true });
    }
    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && !event.altKey && !event.shiftKey && event.key.toLowerCase() === "k") {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
    dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector("[data-search-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      links()[0]?.click();
    });
    input.addEventListener("input", () => void run(input.value));
    dialog.addEventListener("keydown", (event) => {
      const all = links();
      const at = all.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === "Escape") {
        event.preventDefault();
        dialog.close();
      } else if (event.key === "ArrowDown" && all.length) {
        event.preventDefault();
        all[Math.min(at + 1, all.length - 1)].focus();
      } else if (event.key === "ArrowUp" && at !== -1) {
        event.preventDefault();
        if (at === 0) input.focus();
        else all[at - 1].focus();
      } else if (at !== -1 && event.key.length === 1 && !event.metaKey && !event.ctrlKey && !event.altKey) {
        input.focus();
      }
    });
  }
</script>

<style is:global>
  .search-dialog {
    width: min(640px, calc(100vw - 2 * var(--s-4)));
    max-height: min(640px, calc(100dvh - 2 * var(--s-4)));
    margin: max(var(--s-4), 10vh) auto auto;
    padding: 0;
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-dialog::backdrop {
    background: color-mix(in srgb, #0d0f12 45%, transparent);
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-bottom: 2px solid var(--border);
  }

  .search-icon {
    flex: none;
    color: var(--accent);
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--s-1);
    border: 0;
    background: transparent;
    font-size: var(--t-body);
  }

  .search-bar input:focus-visible {
    outline: none;
  }

  .search-bar:focus-within {
    border-bottom-color: var(--accent);
  }

  .search-bar input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--s-1);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .search-status {
    padding: var(--s-3) var(--s-4);
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0 var(--s-2) var(--s-2);
    overflow-y: auto;
  }

  .search-result {
    display: grid;
    gap: 2px;
    padding: var(--s-2) var(--s-3);
    border-radius: 4px;
    color: var(--text);
    text-decoration: none;
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .search-result:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .result-where {
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .result-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-2);
    align-items: baseline;
  }

  .result-title {
    font-weight: 700;
    color: var(--accent);
  }

  .result-part {
    color: var(--text);
  }

  .result-part::before {
    content: "› ";
    color: var(--text-2);
  }

  .result-excerpt {
    font-size: var(--t-small);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .result-excerpt mark {
    background: transparent;
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .search-dialog kbd {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 var(--s-2);
    border: var(--rule);
    border-radius: 4px;
    font-family: var(--font-text);
    font-size: var(--t-legend);
    font-weight: 700;
    color: var(--text-2);
  }
</style>
