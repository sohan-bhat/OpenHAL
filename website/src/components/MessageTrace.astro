---
import "../styles/trace.css";
import type { TraceEntry } from "../lib/trace";
import { traceHtml } from "../lib/trace-html.mjs";

interface Props {
  entries: TraceEntry[];
  label?: string;
  note?: string;
}

const { entries, label = "Message trace", note } = Astro.props;
---

<Fragment set:html={traceHtml(entries, { label, note })} />
