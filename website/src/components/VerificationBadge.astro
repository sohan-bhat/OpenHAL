---
import { Badge } from "./ui/badge";
import type { Verification } from "../lib/library";

interface Props {
  status: Verification;
}

const { status } = Astro.props;
const look = {
  "verified-on-hardware": { cls: "ok", word: "verified on hardware" },
  "tested-reads": { cls: "unverified", word: "reads tested" },
  unverified: { cls: "unverified", word: "unverified" },
}[status] as { cls: "ok" | "unverified"; word: string };
---

<Badge variant={look.cls} className={`status ${look.cls}`}>{look.word}</Badge>
