---
// The 30-second demo, one frame per step. Frame text comes from the real CLI and MCP tools
// (tests/website/demo_steps.py). A frame shows its dashboard capture once one exists.
import steps from "../content/demo/steps.json";
import { capture } from "../lib/captures";

const frames = steps.map((step, index) => ({ ...step, number: index + 1, media: capture(step.capture) }));
---

<div class="storyboard" data-storyboard>
  <ol class="index" aria-label="Demo steps">
    {
      frames.map((frame) => (
        <li data-step-link={frame.id} aria-current={frame.number === 1 ? "step" : undefined}>
          <a href={`#demo-${frame.id}`}>
            <span class="mono n">{String(frame.number).padStart(2, "0")}</span>
            <span>{frame.caption}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <div class="frames">
    {
      frames.map((frame) => (
        <figure class="module frame" id={`demo-${frame.id}`} data-step={frame.id}>
          <figcaption class="module-legend legend">
            <span>Step {frame.number}</span>
            <span>{frame.kind === "mcp" ? "MCP tool call" : "Command line"}</span>
          </figcaption>
          <p class="caption">{frame.caption}</p>
          {frame.media ? (
            frame.media.video ? (
              <video
                controls
                muted
                playsinline
                preload="none"
                poster={frame.media.src}
                width={frame.media.width}
                height={frame.media.height}
              >
                <source src={frame.media.video} type="video/webm" />
              </video>
            ) : (
              <img src={frame.media.src} width={frame.media.width} height={frame.media.height} alt={frame.caption} loading="lazy" decoding="async" />
            )
          ) : null}
          <pre class="mono" tabindex="0" aria-label={`Output of step ${frame.number}`}>{frame.text}</pre>
        </figure>
      ))
    }
    <p class="note muted">
      Every frame is real output from the CLI and the MCP tools, run against the simulated fan that <code>openhal init</code> creates.
    </p>
  </div>
</div>

<script>
  // Mark the step whose frame is in the middle of the screen. No motion, only state.
  for (const board of document.querySelectorAll<HTMLElement>("[data-storyboard]")) {
    const links = new Map([...board.querySelectorAll<HTMLElement>("[data-step-link]")].map((item) => [item.dataset.stepLink, item]));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = (entry.target as HTMLElement).dataset.step;
          links.forEach((item, key) => (key === id ? item.setAttribute("aria-current", "step") : item.removeAttribute("aria-current")));
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    board.querySelectorAll("[data-step]").forEach((frame) => observer.observe(frame));
  }
</script>

<style>
  .storyboard {
    display: grid;
    gap: var(--s-6);
  }

  .index {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index li {
    border-left: 2px solid var(--rule);
  }

  .index li[aria-current="step"] {
    border-left-color: var(--ink);
  }

  .index a {
    display: grid;
    grid-template-columns: 2.5em 1fr;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--t-1);
    line-height: var(--lh-1);
  }

  .index li[aria-current="step"] a {
    color: var(--ink);
  }

  .n {
    font-size: var(--t-0);
    color: var(--ink-3);
  }

  .frames {
    display: grid;
    gap: var(--s-7);
    min-width: 0;
  }

  .frame {
    margin: 0;
    padding-top: var(--s-5);
  }

  .caption {
    font-size: var(--t-2);
    line-height: var(--lh-2);
    max-width: 60ch;
  }

  pre {
    margin: var(--s-4) 0 0;
    padding: var(--s-3) var(--s-3);
    font-size: var(--t-0);
    line-height: 18px;
    background: color-mix(in srgb, var(--ink) 5%, var(--panel));
    border-radius: var(--radius);
    overflow-x: auto;
    white-space: pre;
  }

  img,
  video {
    margin-top: var(--s-4);
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .note {
    font-size: var(--t-1);
    line-height: var(--lh-1);
  }

  .note code {
    font-size: 0.9em;
  }

  @media (min-width: 1024px) {
    .storyboard {
      grid-template-columns: 4fr 8fr;
      gap: var(--s-7);
      align-items: start;
    }

    .index {
      display: block;
      position: sticky;
      top: var(--s-6);
    }

    .frame .caption {
      display: none;
    }

    .frame pre {
      margin-top: 0;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }
</style>
