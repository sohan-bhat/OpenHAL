---
import { getCollection } from "astro:content";
import { PRODUCT_NAME } from "../config/brand";
import { navLinks } from "../config/site";
import { wordmarkWidth } from "../lib/brand-mark";
import SearchDialog from "./SearchDialog.astro";

const published = (await getCollection("blog")).some((post) => !post.data.draft);
const links = navLinks(published);
const path = Astro.url.pathname;
const matchLength = (match: string[]) =>
  Math.max(0, ...match.filter((prefix) => (prefix === "/" ? path === "/" : path.startsWith(prefix))).map((prefix) => prefix.length));
const best = Math.max(0, ...links.map((link) => matchLength(link.match)));
const current = (match: string[]) => best > 0 && matchLength(match) === best;
const relative = (match: string[]) => match.map((prefix) => prefix.replace(/^\//, "")).join(" ");
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${PRODUCT_NAME} overview`}>
      <picture class="wordmark">
        <source media="(prefers-color-scheme: dark)" srcset="/brand/wordmark-dark.svg" />
        <img src="/brand/wordmark-light.svg" alt={PRODUCT_NAME} width={wordmarkWidth(24)} height="24" />
      </picture>
    </a>
    <button type="button" class="search-field" data-search-open aria-haspopup="dialog" aria-controls="site-search" aria-keyshortcuts="Meta+K Control+K">
      <svg class="search-glass" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
      </svg>
      <span class="search-placeholder">Search...</span>
      <kbd class="search-key" aria-hidden="true"><span class="key-apple">⌘K</span><span class="key-other">Ctrl K</span></kbd>
    </button>
    <button type="button" class="search-button" data-search-open aria-haspopup="dialog" aria-controls="site-search">
      <svg class="search-glass" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
      </svg>
      <span class="visually-hidden">Search</span>
    </button>
    <nav class="desktop-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current(link.match) ? "page" : undefined}
                rel={link.external ? "noopener" : undefined}
                data-match={link.external ? undefined : relative(link.match)}
              >
                {current(link.match) && <span class="nav-pill" aria-hidden="true" />}
                <span class="nav-text">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={current(link.match) ? "page" : undefined} rel={link.external ? "noopener" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
<SearchDialog />

<style is:global>
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: var(--rule);
  }

  .site-header .bar {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 60px;
  }

  .site-header .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text);
    text-decoration: none;
    flex: none;
  }

  .site-header .wordmark,
  .site-header .wordmark img {
    display: block;
  }

  .site-header ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .desktop-nav {
    display: none;
    flex: none;
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    gap: var(--s-1);
  }

  .desktop-nav a {
    display: block;
    padding: var(--s-2) 10px;
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: var(--t-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .desktop-nav a {
    position: relative;
    isolation: isolate;
  }

  .desktop-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .nav-pill {
    view-transition-name: nav-pill;
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .search-field,
  .search-button {
    font: inherit;
    color: var(--text-2);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--text-2) 60%, var(--border));
    border-radius: var(--radius);
    cursor: pointer;
  }

  .search-field:hover,
  .search-button:hover {
    border-color: var(--accent);
  }

  .search-glass {
    flex: none;
    color: var(--accent);
  }

  .search-field {
    display: none;
    flex: 0 1 260px;
    min-width: 128px;
    align-items: center;
    gap: var(--s-2);
    min-height: 38px;
    padding: 0 6px 0 var(--s-3);
    text-align: left;
  }

  .search-placeholder {
    flex: 1;
    font-size: var(--t-small);
    white-space: nowrap;
  }

  .search-key {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 6px;
    border: var(--rule);
    border-radius: 4px;
    font-family: var(--font-text);
    font-size: var(--t-legend);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .key-apple,
  html.apple .key-other {
    display: none;
  }

  html.apple .key-apple {
    display: inline;
  }

  .search-button {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: auto;
    padding: 0;
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-3);
    border: var(--rule);
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-2));
    width: min(280px, calc(100vw - 2 * var(--s-4)));
    padding: var(--s-2);
    background: var(--bg);
    border: var(--rule);
    border-radius: var(--radius);
  }

  .mobile-nav a {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: 4px;
    color: var(--text);
    text-decoration: none;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--accent);
    font-weight: 700;
  }

  @media (min-width: 1180px) {
    .site-header .bar {
      gap: var(--s-4);
    }

    .desktop-nav {
      display: block;
    }

    .search-field {
      display: inline-flex;
    }

    .mobile-nav,
    .search-button {
      display: none;
    }
  }
</style>
