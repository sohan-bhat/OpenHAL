---
import { PRODUCT_NAME } from "../config/brand";
import { REPOSITORY_URL } from "../config/site";

const home = Astro.url.pathname === "/";
---

<footer class="site-footer">
  <div class:list={[home ? "home-width" : "wrap", "row"]}>
    <p><strong>{PRODUCT_NAME}</strong> <span class="muted">is an open protocol, released under Apache 2.0.</span></p>
    <p class="muted">Not affiliated with Anthropic or MHS.</p>
    <p><a href={REPOSITORY_URL} rel="noopener">Source on GitHub</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-8);
    border-top: var(--rule);
    padding: var(--s-5) 0 var(--s-6);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }
</style>
