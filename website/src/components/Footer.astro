---
import { PRODUCT_NAME } from "../config/brand";

const links = [
  { href: "/docs/quickstart/", label: "Quickstart" },
  { href: "/docs/safety/", label: "Safety model" },
  { href: "/spec/", label: "Spec" },
  { href: "/docs/contributing-a-device-file/", label: "Add a device" },
];
---

<footer class="site-footer">
  <div class="wrap row">
    <p><span class="name">{PRODUCT_NAME}</span> <span class="muted">Apache 2.0</span></p>
    <nav aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="muted note">Not a safety system. Keep your e-stops and hardware interlocks.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-9);
    border-top: 1px solid var(--ink);
    padding: var(--s-5) 0 var(--s-6);
  }

  .row {
    display: grid;
    gap: var(--s-3);
  }

  .name {
    font-family: var(--font-label);
    font-weight: 800;
    letter-spacing: 0.04em;
    margin-right: var(--s-2);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  a:hover {
    color: var(--signal);
  }

  @media (min-width: 1024px) {
    .row {
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      column-gap: var(--s-7);
    }
  }
</style>
