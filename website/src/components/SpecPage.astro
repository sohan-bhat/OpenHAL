---
import { getEntry, render } from "astro:content";
import Doc from "../layouts/Doc.astro";
import { docTitle } from "../lib/docs-nav";
import { specVersions } from "../lib/spec-versions";

interface Props {
  repo: string;
  version?: string;
}

const { repo, version } = Astro.props;
const entry = await getEntry("docs", repo);
if (!entry) throw new Error(`${repo} is missing from the docs collection.`);
const { Content, headings } = await render(entry);
const versions = specVersions();
const current = versions.find((item) => item.current);
const shown = version ?? current?.version;
const path = Astro.url.pathname;
const pages = [
  { href: "/spec/", label: "Spec" },
  { href: "/spec/changelog/", label: "Changelog" },
  { href: "/spec/mhs-mapping/", label: "MHS mapping" },
];
---

<Doc title={docTitle(entry)} repo={repo} headings={headings}>
  <div slot="after-title" class="spec-bar">
    <nav class="versions" aria-label="Spec versions">
      <span class="legend">Version</span>
      <ul>
        {
          versions.map((item) => (
            <li>
              <a
                href={item.current ? "/spec/" : `/spec/${item.version}/`}
                aria-current={repo === "spec/SPEC.md" && item.version === shown ? "page" : undefined}
              >
                <span class="mono">{item.version}</span>
                <span class="state">{item.status}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="spec-pages" aria-label="Spec pages">
      <ul>
        {
          pages.map((page) => (
            <li>
              <a href={page.href} aria-current={path === page.href ? "page" : undefined}>
                {page.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <Content />
</Doc>

<style>
  .spec-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .versions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .versions .legend {
    color: var(--ink-2);
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    min-height: 32px;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--t-1);
    line-height: var(--lh-1);
  }

  a[aria-current="page"] {
    border-color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--ink);
    font-weight: 700;
  }

  .state {
    font-family: var(--font-label);
    font-size: var(--t-0);
    text-transform: uppercase;
    letter-spacing: var(--legend-tracking);
    color: var(--ink-2);
  }
</style>
