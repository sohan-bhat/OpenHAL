---
import PartLabel from "./PartLabel.astro";
import { drivers } from "../lib/catalog";
import { catalogSentence } from "../lib/catalog-summary";

const all = drivers();
const running = all.filter((driver) => driver.status === "implemented" || driver.status === "verified");
const later = all.filter((driver) => !running.includes(driver));
---

<div class="summary">
  <p class="muted">{catalogSentence(all)}</p>
  <div class="parts">
    {
      running.map((driver) => (
        <PartLabel
          name={driver.name}
          status={driver.status}
          rows={[
            ["Protocol", driver.protocols.join(", ")],
            ["Covers", driver.families.join(", ")],
            ["Hazard", driver.hazard_default],
          ]}
        />
      ))
    }
  </div>
  {
    later.length > 0 && (
      <p class="later">
        <span class="legend">Planned</span>
        <span class="names">
          {later.map((driver) => (
            <code>{driver.name}</code>
          ))}
        </span>
      </p>
    )
  }
  <p><a href="/devices/">Every driver, by tier, status and hazard</a></p>
</div>

<style>
  .summary {
    display: grid;
    gap: var(--s-5);
  }

  .parts {
    display: grid;
    gap: var(--s-4);
  }

  .later {
    display: grid;
    gap: var(--s-2);
  }

  .later .legend {
    color: var(--ink-2);
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .names code {
    font-size: var(--t-0);
    padding: 2px var(--s-2);
    border: 1px dashed var(--ink-2);
    border-radius: var(--radius);
  }

  @media (min-width: 768px) {
    .parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
