---
import { EXAMPLE } from "../../lib/story/example";
import { CHART_SIZES, HOW_CHART, chartLead, pathText } from "../../lib/story/how";

const WIDE = "(min-width: 50rem)";
const themes = (["light", "dark"] as const).map((theme) => ({
  theme,
  wide: { src: `/charts/how-it-works-wide-${theme}.png`, ...CHART_SIZES.wide },
  narrow: { src: `/charts/how-it-works-narrow-${theme}.png`, ...CHART_SIZES.narrow },
}));
---

<section id="how" class="home-width how" aria-labelledby="how-title">
  <h2 id="how-title">How it works</h2>
  <figure class="how-chart">
    {
      themes.map(({ theme, wide, narrow }) => (
        <picture class={theme === "light" ? "dark:sl-hidden" : "light:sl-hidden"} data-theme-chart={theme}>
          <source media={WIDE} srcset={wide.src} width={wide.width} height={wide.height} />
          <img src={narrow.src} width={narrow.width} height={narrow.height} alt="" loading="lazy" decoding="async" />
        </picture>
      ))
    }
    <figcaption class="visually-hidden">
      <p>{chartLead()}</p>
      <ul>
        {HOW_CHART.paths.map((path) => <li>{pathText(path)}</li>)}
      </ul>
    </figcaption>
  </figure>
  <p class="how-onward"><a href={EXAMPLE.href}>See a full example with a 3D printer</a></p>
</section>

<style>
  .how {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-8);
  }

  .how h2 {
    font-size: var(--t-h1);
    line-height: 1.15;
  }

  .how-chart {
    margin: 0;
    min-width: 0;
  }

  .how-chart img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .how-onward a {
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .how {
      padding-top: calc(var(--s-8) + var(--s-6));
    }
  }
</style>
