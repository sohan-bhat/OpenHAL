---
import { humane, nb, storyFacts, storyLines } from "../../lib/story/facts";
import { CAMERA, NEVER, TOTAL, cue } from "../../lib/story/script";
import { NOTE_AT, SNAP_AT, TITLE_OUT } from "../../lib/story/timeline";
import "../../styles/story.css";
import Client from "./scene/Client.astro";
import Hub from "./scene/Hub.astro";
import Kernel from "./scene/Kernel.astro";
import Printer from "./scene/Printer.astro";
import Scene from "./scene/Scene.astro";

const facts = storyFacts();
const lines = storyLines(facts);
const noted = Object.keys(NOTE_AT) as Array<keyof typeof NOTE_AT>;
const notes = noted.map((id, index) => ({ text: lines[id], style: cue(NOTE_AT[id], NOTE_AT[noted[index + 1]] ?? NEVER, 3) }));
const ask = (item: { method: string; target: string; value: string }) => [item.method, item.target, item.value].filter(Boolean).join(" ");
const steps: Array<{ id: keyof typeof SNAP_AT; station: typeof Client; code: string[] }> = [
  { id: "watch", station: Client, code: [ask(facts.look), facts.camera.image] },
  { id: "look", station: Printer, code: ["corner lifting"] },
  { id: "warm", station: Kernel, code: [ask(facts.bed), "granted"] },
  { id: "heat", station: Printer, code: [facts.bed.status, `bed ${facts.bed.value}`] },
  { id: "hot", station: Kernel, code: [ask(facts.nozzle), facts.nozzle.refusal.name] },
  { id: "reply", station: Client, code: [facts.nozzle.refusal.name, humane(facts.nozzle.refusal.reason)] },
  { id: "loose", station: Printer, code: ["print loose"] },
  { id: "pause", station: Printer, code: [ask(facts.pause), facts.pause.status, "paused"] },
  { id: "cancel", station: Kernel, code: [ask(facts.cancel), "confirmation required"] },
  { id: "wake", station: Hub, code: [facts.cancel.status, `${facts.cancel.target} confirmation required`] },
];
const camera = `(() => {
  const story = document.currentScript.previousElementSibling;
  if (matchMedia(${JSON.stringify(CAMERA)}).matches) story.setAttribute("data-camera", "");
})();`;
---

<section class="story-section" aria-labelledby="story-title">
  <div class="story" data-story style={`--runway: ${TOTAL}`}>
    <div class="story-stage">
      <div class="story-band">
        <div class="wrap column story-heads">
          <h2 id="story-title" class="story-title" style={`--out: ${TITLE_OUT}; --f: 3`}>{lines.wide}</h2>
          <div class="story-notes" aria-hidden="true">
            {notes.map((note) => <p class="story-note cue" style={note.style}>{note.text}</p>)}
          </div>
        </div>
      </div>
      <Scene facts={facts} />
    </div>
    <ol class="wrap column story-list" role="list">
      {
        steps.map((step) => (
          <li class="story-step">
            <div class="step-words">
              <p class="step-line">{lines[step.id]}</p>
              {step.code.map((code) => <p class="visually-hidden">{nb(code)}</p>)}
            </div>
            <div class="story-snap" style={`--t: ${SNAP_AT[step.id]}`} aria-hidden="true">
              <step.station facts={facts} />
            </div>
          </li>
        ))
      }
      <li class="story-step story-last">
        <p class="step-line">{lines.end}</p>
      </li>
    </ol>
  </div>
  <script is:inline set:html={camera} />
</section>

<script>
  import { story } from "./story-runtime";

  for (const root of document.querySelectorAll<HTMLElement>("[data-story]")) story(root);
</script>
