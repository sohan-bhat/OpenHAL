---
import { nb, storyFacts, storyLines, type Sending } from "../../lib/story/facts";
import { CAMERA, COUNTED, TOTAL, during, held } from "../../lib/story/script";
import { storySequence } from "../../lib/story/timeline";
import "../../styles/story.css";
import Sequence from "./scene/Sequence.astro";
import Webcam from "./scene/Webcam.astro";
import { KEY } from "./smooth-switch";

interface Props {
  after: string;
}

const { after } = Astro.props;
const facts = storyFacts();
const lines = storyLines(facts);
const sequence = storySequence(facts);
const reasons: Partial<Record<Sending, string>> = { hot: facts.nozzle.refusal.reason };
const camera = `(() => {
  const story = document.currentScript.previousElementSibling;
  const toggle = story.querySelector("[data-smooth]");
  if (toggle) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let stored = null;
    try {
      stored = localStorage.getItem(${JSON.stringify(KEY)});
    } catch {}
    toggle.setAttribute("aria-checked", String(!reduce && stored !== "off"));
    toggle.disabled = reduce;
    toggle.removeAttribute("data-wait");
    toggle.removeAttribute("tabindex");
    toggle.removeAttribute("aria-hidden");
  }
  if (!matchMedia(${JSON.stringify(CAMERA)}).matches) return;
  story.setAttribute("data-camera", "");
  const stage = story.querySelector(".story-stage");
  const room = story.querySelector(".story-probe").offsetHeight - (document.querySelector(".site-header")?.offsetHeight ?? 0);
  if (stage.offsetHeight > room + 1) story.removeAttribute("data-camera");
})();`;
---

<section class="story-section" aria-labelledby="story-title">
  <div class="story" data-story data-total={TOTAL}>
    <div class="story-stage">
      <div class="story-band">
        <div class="story-meta">
          <p class="story-count" aria-hidden="true" data-pagefind-ignore="all">
            <span {...during([held("intro")])}>{COUNTED.length} steps</span>
            {COUNTED.map((item, index) => <span {...during([held(item.id)])}>{index + 1} / {COUNTED.length}</span>)}
          </p>
          <a class="story-skip" href={`#${after}`}>Skip the demo</a>
          <button type="button" class="smooth" role="switch" aria-checked="false" data-smooth data-wait tabindex="-1" aria-hidden="true">
            <span class="smooth-track" aria-hidden="true"><span class="smooth-knob"></span></span>
            <span class="smooth-label">Smooth scrolling</span>
          </button>
        </div>
        <div class="story-heads">
          <h2 id="story-title" class="story-title" {...during([held("intro")])}>{lines.intro}</h2>
          <div class="story-notes" aria-hidden="true" data-pagefind-ignore="all">
            {COUNTED.map((item) => <p class="story-note" {...during([held(item.id)])}>{nb(lines[item.id])}</p>)}
          </div>
        </div>
      </div>
      <div class="story-scene" aria-hidden="true" data-pagefind-ignore="all">
        <Sequence sequence={sequence} />
        <Webcam sequence={sequence} />
      </div>
    </div>
    <div class="story-runway" style={`height: ${TOTAL}vh`} aria-hidden="true"></div>
    <span class="story-probe" aria-hidden="true"></span>
    <ol class="story-list" role="list">
      {
        COUNTED.map((item) => {
          const said = facts.said[item.id as Sending] ?? [];
          const reason = reasons[item.id as Sending];
          return (
            <li class="story-step">
              <p class="step-line">{nb(lines[item.id])}</p>
              {said.length > 0 && (
                <p class:list={["step-said", { mono: item.id !== "ask" }]}>
                  {said.map((words) => (
                    <span class="step-words">
                      {nb(words.label)}
                      {words.answer && (
                        <Fragment>
                          {" "}
                          <span class:list={["status", words.answer.tone]}>{words.answer.text}</span>
                        </Fragment>
                      )}
                    </span>
                  ))}
                </p>
              )}
              {reason && <p class="step-reason mono">{nb(reason)}</p>}
            </li>
          );
        })
      }
    </ol>
  </div>
  <script is:inline set:html={camera} />
</section>
