---
import { storyFacts, storyLines, storyTrace } from "../../lib/story/facts";
import { CAMERA, COUNTED, TOTAL, shown, type StepId } from "../../lib/story/script";
import "../../styles/story.css";
import Camera from "./scene/Camera.astro";
import Client from "./scene/Client.astro";
import Hub from "./scene/Hub.astro";
import Kernel from "./scene/Kernel.astro";
import Printer from "./scene/Printer.astro";
import Scene from "./scene/Scene.astro";
import Trace from "./scene/Trace.astro";

interface Props {
  after: string;
}

const { after } = Astro.props;
const facts = storyFacts();
const lines = storyLines(facts);
const trace = storyTrace(facts);
const snaps: Partial<Record<StepId, typeof Client>> = {
  ask: Client,
  look: Camera,
  warm: Printer,
  hot: Kernel,
  loose: Camera,
  pause: Printer,
  cancel: Kernel,
  wake: Hub,
};
const camera = `(() => {
  const story = document.currentScript.previousElementSibling;
  if (!matchMedia(${JSON.stringify(CAMERA)}).matches) return;
  story.setAttribute("data-camera", "");
  const stage = story.querySelector(".story-stage");
  const room = story.querySelector(".story-probe").offsetHeight - (document.querySelector(".site-header")?.offsetHeight ?? 0);
  if (stage.offsetHeight > room) story.setAttribute("data-short", "");
  if (stage.offsetHeight > room) story.removeAttribute("data-camera"), story.removeAttribute("data-short");
})();`;
---

<section class="story-section" aria-labelledby="story-title">
  <div class="story" data-story>
    <div class="story-stage">
      <div class="story-band">
        <div class="story-meta">
          <p class="story-count" aria-hidden="true" data-pagefind-ignore="all">
            {COUNTED.map((item, index) => <span {...shown([item.id])}>{index + 1} / {COUNTED.length}</span>)}
          </p>
          <a class="story-skip" href={`#${after}`}>Skip the demo</a>
          <button type="button" class="smooth" role="switch" aria-checked="false" data-smooth data-wait tabindex="-1" aria-hidden="true">
            <span class="smooth-track" aria-hidden="true"><span class="smooth-knob"></span></span>
            <span class="smooth-label">Smooth scrolling</span>
          </button>
        </div>
        <div class="story-heads">
          <h2 id="story-title" class="story-title" {...shown(["intro"])}>{lines.intro}</h2>
          <div class="story-notes" aria-hidden="true" data-pagefind-ignore="all">
            {COUNTED.map((item) => <p class="story-note" {...shown([item.id])}>{lines[item.id]}</p>)}
          </div>
        </div>
      </div>
      <div data-pagefind-ignore="all">
        <Scene facts={facts} />
      </div>
    </div>
    <div class="story-runway" style={`height: ${TOTAL}vh`} aria-hidden="true"></div>
    <span class="story-probe" aria-hidden="true"></span>
    <ol class="story-list" role="list">
      {
        COUNTED.map((item) => {
          const Snap = snaps[item.id];
          return (
            <li class="story-step">
              <div class="step-words">
                <p class="step-line">{lines[item.id]}</p>
                {trace[item.id] && (
                  <div data-pagefind-ignore="all">
                    <Trace facts={facts} step={item.index} only={item.id} />
                  </div>
                )}
              </div>
              {Snap && (
                <div class="story-snap" aria-hidden="true" data-pagefind-ignore="all">
                  <Snap facts={facts} step={item.index} />
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
  <script is:inline set:html={camera} />
</section>

<script>
  import { smoothSwitch } from "./smooth-switch";
  import { story } from "./story-runtime";

  for (const root of document.querySelectorAll<HTMLElement>("[data-story]")) story(root);
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-smooth]")) smoothSwitch(toggle);
</script>
