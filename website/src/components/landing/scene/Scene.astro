---
import type { StoryFacts } from "../../../lib/story/facts";
import { ALWAYS } from "../../../lib/story/script";
import { CLIENT } from "../../../lib/story/timeline";
import Client from "./Client.astro";
import Driver from "./Driver.astro";
import Hub from "./Hub.astro";
import Kernel from "./Kernel.astro";
import Printer from "./Printer.astro";
import Wire from "./Wire.astro";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const asked = [facts.look, facts.bed, facts.nozzle, facts.look, facts.pause, facts.cancel].map((ask, index) => ({ text: ask.method, span: index ? CLIENT.asks[index] : { ...CLIENT.asks[index], at: ALWAYS } }));
---

<div class="story-scene" aria-hidden="true">
  <Client facts={facts} />
  <Wire wire={1} label={asked} />
  <Hub facts={facts} />
  <Wire wire={2} label="check" />
  <Kernel facts={facts} />
  <Wire wire={3} label="grant" />
  <Driver facts={facts} />
  <Wire wire={4} label="command" />
  <Printer facts={facts} />
</div>
