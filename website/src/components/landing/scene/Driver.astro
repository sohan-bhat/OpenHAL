---
import type { StoryFacts } from "../../../lib/story/facts";
import { nb } from "../../../lib/story/facts";
import { cue } from "../../../lib/story/script";
import { DRIVER, type Span } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const drivers = [
  { name: facts.printer.driver, part: "printer", spans: DRIVER.moonraker },
  { name: facts.camera.driver, part: "webcam", spans: DRIVER.http },
];
---

<div class="station" data-cam="driver">
  <div class="station-head">
    <p class="station-name">Drivers</p>
    <p class="station-note">Commands need a single-use grant</p>
  </div>
  <ul class="drivers">
    {
      drivers.map((driver) => (
        <li class="driver">
          {driver.spans.map((span) => (
            <span class="driver-mark cue" style={shown(span)} />
          ))}
          <span class="driver-text">
            <span class="mono">{driver.name}</span> <span class="driver-part">for the {driver.part}</span>
          </span>
        </li>
      ))
    }
  </ul>
  <div class="swap grant">
    {DRIVER.waiting.map((span) => <p class="cue waiting" style={shown(span)}>Waiting for a grant</p>)}
    <div class="cue" style={shown(DRIVER.bed)}>
      <p class="mono action">{facts.bed.target}</p>
      <p class="figure">{nb(facts.bed.value)}</p>
    </div>
    <div class="cue" style={shown(DRIVER.pause)}>
      <p class="mono action">{facts.pause.target}</p>
    </div>
  </div>
  <p class="swap station-text">
    {DRIVER.sent.map((span) => <span class="cue" style={shown(span)}>Sent to the printer</span>)}
  </p>
</div>

<style>
  .drivers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .driver {
    position: relative;
    margin-inline: -8px;
    padding: 4px 8px;
  }

  .driver-mark {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .driver-text {
    position: relative;
  }

  .driver-part {
    color: var(--text-2);
  }

  .grant {
    min-height: 62px;
  }

  .waiting {
    align-self: center;
    color: var(--text-2);
  }

  .action {
    color: var(--accent);
    font-weight: 700;
  }
</style>
