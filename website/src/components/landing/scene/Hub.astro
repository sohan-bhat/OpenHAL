---
import type { StoryFacts } from "../../../lib/story/facts";
import { nb } from "../../../lib/story/facts";
import { PLACED, lit, shown, type StepId } from "../../../lib/story/script";
import { HUB } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const cancel = facts.cancel.rule;
const rules = [
  { text: `Nozzle up to ${facts.nozzle.max}`, in: HUB.nozzle },
  { text: `Bed up to ${facts.bed.max}`, in: HUB.bed },
  { text: cancel, in: HUB.cancel },
];
const resting = PLACED.map((item) => item.id).filter((id) => !HUB.asked.includes(id));
const quiet = resting.filter((id: StepId) => !HUB.nozzle.includes(id) && !HUB.bed.includes(id));
const now = [
  { text: rules[0].text, in: HUB.nozzle, kind: "" },
  { text: rules[1].text, in: HUB.bed, kind: "" },
  { text: cancel, in: HUB.pending, kind: "" },
  { text: facts.approve.approved, in: HUB.approved, kind: "status ok" },
  { text: facts.confirmed, in: quiet, kind: "" },
];
---

<div class="node" data-cam="hub" {...lit("hub", step)}>
  <div class="node-head">
    <p class="node-name">OpenHAL hub</p>
    <p class="node-note mono">{facts.file}</p>
  </div>
  <ul class="rules wide-only">
    {
      rules.map((rule) => (
        <li class="rule">
          <span class="rule-mark" {...shown(rule.in, step)} />
          <span class="rule-text">{nb(rule.text)}</span>
        </li>
      ))
    }
  </ul>
  <div class="swap wide-only">
    <p class="confirmed" {...shown(resting, step)}>{facts.confirmed}</p>
    <div class="asked" {...shown(HUB.asked, step)}>
      <p class="mono asked-what">{facts.cancel.target} <span class="asked-on">on {facts.printer.id}</span></p>
      <p class="swap">
        <span class="status confirm" {...shown(HUB.pending, step)}>confirmation required</span>
        <span class="status ok" {...shown(HUB.approved, step)}>{facts.approve.approved}</span>
      </p>
    </div>
  </div>
  <p class="swap compact-only">
    {now.map((line) => <span class={line.kind || undefined} {...shown(line.in, step)}>{nb(line.text)}</span>)}
  </p>
</div>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .rule {
    position: relative;
    margin-inline: -6px;
    padding: 3px 6px;
  }

  .rule-mark {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .rule-text {
    position: relative;
  }

  .confirmed {
    color: var(--text-2);
    font-size: var(--t-legend);
  }

  .asked {
    display: grid;
    gap: 2px;
  }

  .asked-what {
    font-weight: 700;
  }

  .asked-on {
    color: var(--text-2);
    font-weight: 400;
  }

  .asked .status {
    white-space: normal;
  }
</style>
