---
import type { StoryFacts } from "../../../lib/story/facts";
import { nb } from "../../../lib/story/facts";
import { cue } from "../../../lib/story/script";
import { HUB, type Span } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const rules = [
  { text: `Nozzle up to ${facts.nozzle.max}`, span: HUB.nozzle },
  { text: `Bed up to ${facts.bed.max}`, span: HUB.bed },
  { text: `${facts.cancel.target[0].toUpperCase()}${facts.cancel.target.slice(1)} waits for a person`, span: HUB.cancel },
];
---

<div class="station" data-cam="hub">
  <div class="station-head">
    <p class="station-name">OpenHAL hub</p>
    <p class="station-note">Runs on your computer or a Pi</p>
  </div>
  <div class="file">
    <p class="mono file-name">{facts.file}</p>
    <ul class="rules">
      {
        rules.map((rule) => (
          <li class="rule">
            <span class="rule-mark cue" style={shown(rule.span)} />
            <span class="rule-text">{nb(rule.text)}</span>
          </li>
        ))
      }
    </ul>
    <p class="file-confirmed">{facts.confirmed}</p>
  </div>
  <div class="asked cue" style={shown(HUB.asked)}>
    <p class="mono asked-what">{facts.cancel.target} <span class="asked-on">on {facts.printer.id}</span></p>
    <p class="asked-who">Asked by the agent</p>
    <p class="status confirm">confirmation required</p>
  </div>
</div>

<style>
  .file {
    display: grid;
    gap: 10px;
    padding: 14px;
    background: var(--bg);
    border: 1px solid var(--node);
    border-radius: 4px;
  }

  .file-name,
  .file-confirmed {
    color: var(--text-2);
    font-size: var(--t-legend);
  }

  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .rule {
    position: relative;
    margin-inline: -8px;
    padding: 4px 8px;
  }

  .rule-mark {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .rule-text {
    position: relative;
  }

  .asked {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border: 1.5px dashed var(--node);
    border-radius: 4px;
  }

  .asked-what {
    font-weight: 700;
  }

  .asked-on {
    color: var(--text-2);
    font-weight: 400;
  }

  .asked-who {
    color: var(--text-2);
  }

  .asked .status {
    margin-top: 4px;
    white-space: normal;
  }
</style>
