---
import type { StoryFacts } from "../../../lib/story/facts";
import { FRAMES } from "../../../lib/story/frames";
import { lit, shown } from "../../../lib/story/script";
import { CAMERA } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const frames = [
  { frame: FRAMES.lifting, span: CAMERA.lifting, marked: CAMERA.corner },
  { frame: FRAMES.loose, span: CAMERA.loose, marked: CAMERA.off },
];
---

<div class="node webcam" data-cam="camera" {...lit("camera", step)}>
  <p class="webcam-head"><span class="node-name">Webcam</span> <span class="mono wide-only">{facts.camera.id}</span><span class="demo compact-only">Demo frame</span></p>
  <div class="frame swap">
    {
      frames.map(({ frame, span, marked }) => (
        <svg {...shown(span, step)} viewBox="0 120 640 360" aria-hidden="true" focusable="false">
          {frame.items.map((item) => <path class:list={["ink", `fill-${item.fill}`]} d={item.d} />)}
          <rect class="mark" {...shown(marked, step)} x={frame.mark.x} y={frame.mark.y} width={frame.mark.width} height={frame.mark.height} rx="8" />
        </svg>
      ))
    }
  </div>
  <div class="under">
    <p class="swap seen">
      <span {...shown(CAMERA.corner, step)}><span class="seen-who">Seen</span> corner lifting</span>
      <span {...shown(CAMERA.off, step)}><span class="seen-who">Seen</span> print loose</span>
    </p>
    <p class="demo wide-only">Demo frame</p>
  </div>
</div>

<style>
  .webcam-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ink {
    stroke: var(--text-2);
    stroke-width: 3.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .fill-surface {
    fill: var(--surface);
  }

  .fill-bg {
    fill: var(--bg);
  }

  .fill-none {
    fill: none;
  }

  .mark {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5;
  }

  .under {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .seen {
    min-height: 1.45em;
  }

  .demo {
    color: var(--text-2);
    font-size: var(--t-legend);
    white-space: nowrap;
  }

  .seen > span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .seen-who {
    color: var(--text-2);
    font-family: var(--font-text);
    font-weight: 400;
  }
</style>
