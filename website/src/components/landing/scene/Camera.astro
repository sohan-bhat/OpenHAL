---
import type { StoryFacts } from "../../../lib/story/facts";
import { FRAMES } from "../../../lib/story/frames";
import { cue } from "../../../lib/story/script";
import { CAMERA, type Span } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const frames = [
  { frame: FRAMES.lifting, span: CAMERA.lifting, marked: CAMERA.corner },
  { frame: FRAMES.loose, span: CAMERA.loose, marked: CAMERA.off },
];
---

<div class="webcam" data-cam="camera">
  <p class="webcam-head"><span class="webcam-name">Webcam</span> <span class="mono">{facts.camera.id}</span></p>
  <div class="frame swap">
    {
      frames.map(({ frame, span, marked }) => (
        <svg class="cue" style={shown(span)} viewBox="0 120 640 360" aria-hidden="true" focusable="false">
          {frame.items.map((item) => <path class:list={["ink", `fill-${item.fill}`]} d={item.d} />)}
          <rect class="mark cue" style={shown(marked)} x={frame.mark.x} y={frame.mark.y} width={frame.mark.width} height={frame.mark.height} rx="8" />
        </svg>
      ))
    }
  </div>
  <div class="under">
    <p class="swap seen">
      <span class="cue" style={shown(CAMERA.corner)}><span class="key"></span>corner lifting</span>
      <span class="cue" style={shown(CAMERA.off)}><span class="key"></span>print loose</span>
    </p>
    <p class="demo">Demo frame</p>
  </div>
</div>

<style>
  .webcam {
    position: relative;
    display: grid;
    gap: 10px;
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .webcam-head {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--text-2);
  }

  .webcam-name {
    color: var(--text);
    font-weight: 700;
  }

  .frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--node);
    border-radius: 4px;
  }

  .frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ink {
    stroke: var(--text-2);
    stroke-width: 3.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .fill-surface {
    fill: var(--surface);
  }

  .fill-bg {
    fill: var(--bg);
  }

  .fill-none {
    fill: none;
  }

  .mark {
    fill: none;
    stroke: var(--text);
    stroke-width: 3.5;
    stroke-dasharray: 10 7;
  }

  .under {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .seen {
    min-height: 1.45em;
  }

  .demo {
    color: var(--text-2);
    font-size: var(--t-legend);
    white-space: nowrap;
  }

  .seen > span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .key {
    flex: none;
    width: 18px;
    height: 12px;
    border: 1.5px dashed var(--text);
    border-radius: 3px;
  }
</style>
