---
import type { StoryFacts } from "../../../lib/story/facts";
import { ALWAYS, NEVER, cue } from "../../../lib/story/script";
import { DEVICE, type Span } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const { soil } = DEVICE;
const steps = Math.max(1, Math.round(facts.soil.after - facts.soil.before));
const times = Array.from({ length: steps + 1 }, (_, index) => (index === 0 ? ALWAYS : soil.at + (soil.d * index) / steps));
const readings = times.map((time, index) => ({
  value: Math.round(facts.soil.before + ((facts.soil.after - facts.soil.before) * index) / steps),
  style: cue(time, times[index + 1] ?? NEVER, 0.4),
}));
const unit = facts.soil.unit === "percent" ? "%" : facts.soil.unit;
const meter = `--at: ${soil.at}; --d: ${soil.d}; --out: ${NEVER}; --f: 1; --from: ${facts.soil.before / 100}; --to: ${facts.soil.after / 100}`;
const tank = [
  { span: DEVICE.tank.ok, text: facts.tank.ok },
  { span: DEVICE.tank.empty, text: facts.tank.low },
  { span: DEVICE.tank.refilled, text: facts.tank.ok },
];
const pump = [
  { span: DEVICE.pump.off, text: "off" },
  { span: DEVICE.pump.held, text: "held off" },
  { span: DEVICE.pump.ready, text: "off" },
  { span: DEVICE.pump.on, text: "on" },
  { span: DEVICE.pump.done, text: "off" },
];
---

<div class="station simulated" data-cam="device">
  <div class="station-head">
    <p class="station-name">{facts.device}</p>
    <p class="station-note">Simulated</p>
  </div>
  <div class="readings">
    <div class="reading">
      <p class="reading-name">Soil moisture</p>
      <p class="swap figure value">
        {readings.map((reading) => <span class="cue" style={reading.style}>{reading.value}&nbsp;{unit}</span>)}
      </p>
      <div class="meter">
        <span class="meter-fill" style={meter}></span>
      </div>
      <p class="meter-scale"><span>0</span><span>100&nbsp;{unit}</span></p>
    </div>
    <div class="reading">
      <p class="reading-name">Tank</p>
      <p class="swap value word">{tank.map((item) => <span class="cue" style={shown(item.span)}>{item.text}</span>)}</p>
    </div>
    <div class="reading">
      <p class="reading-name">Pump</p>
      <p class="swap value word">{pump.map((item) => <span class="cue" style={shown(item.span)}>{item.text}</span>)}</p>
    </div>
  </div>
</div>

<style>
  .readings {
    display: grid;
    gap: 14px;
  }

  .reading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px var(--s-3);
  }

  .reading-name {
    color: var(--text-2);
  }

  .value {
    justify-items: end;
  }

  .word {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .meter,
  .meter-scale {
    grid-column: 1 / -1;
  }

  .meter {
    position: relative;
    height: 10px;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--node);
    border-radius: 5px;
  }

  .meter-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(calc(var(--from) + (var(--to) - var(--from)) * var(--p)));
  }

  .meter-scale {
    display: flex;
    justify-content: space-between;
    color: var(--text-2);
    font-size: var(--t-legend);
  }
</style>
