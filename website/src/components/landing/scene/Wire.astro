---
import { run, shown, type StepId } from "../../../lib/story/script";
import { FILLS, type Fill } from "../../../lib/story/timeline";

interface Props {
  wire: Fill["wire"] | 5;
  labels: Array<{ text: string; in: StepId[] }>;
  step?: number;
}

const { wire, labels, step } = Astro.props;
const reading = (fill: Fill) => fill.lane === "look" || fill.lane === "read";
const mine = FILLS.filter((fill) => (wire === 5 ? fill.wire === 4 && reading(fill) : fill.wire === wire && !(wire === 4 && reading(fill))));
const outbound = (fill: Fill) => fill.lane === "send" || fill.lane === "look";
---

<div class:list={["wire", { down: wire === 5 }]} data-wire={wire}>
  <span class="label swap">{labels.map((label) => <span class="mono" {...shown(label.in, step)}>{label.text}</span>)}</span>
  <span class="lane send">{mine.filter(outbound).map((fill) => <span class:list={["fill", fill.lane]} style={run(fill.at, fill.d, fill.out)} />)}</span>
  <span class="lane back">{mine.filter((fill) => !outbound(fill)).map((fill) => <span class:list={["fill", fill.lane]} style={run(fill.at, fill.d, fill.out)} />)}</span>
</div>

<style>
  .wire {
    position: relative;
    flex: none;
    height: 22px;
  }

  .label {
    position: absolute;
    left: calc(50% + 16px);
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-2);
    font-size: var(--t-legend);
    line-height: 1;
    white-space: nowrap;
  }

  .lane {
    position: absolute;
    width: 2px;
    background: var(--border);
  }

  .lane::after {
    content: "";
    position: absolute;
    left: -3px;
    width: 8px;
    height: 7px;
    background: var(--border);
  }

  .send {
    left: calc(50% - 7px);
    top: 2px;
    bottom: 8px;
  }

  .back {
    left: calc(50% + 5px);
    top: 8px;
    bottom: 2px;
  }

  .send::after {
    bottom: -6px;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .back::after {
    top: -6px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    opacity: min(0.999, calc(1 - var(--gone)));
    transform-origin: center top;
    transform: scaleY(var(--p));
  }

  .back .fill {
    transform-origin: center bottom;
  }

  .fill.blocked {
    background: var(--blocked);
  }

  .fill.look,
  .fill.read,
  .fill.pending {
    background: var(--text-2);
  }

  .fill.done {
    background: var(--ok);
  }

  @media (min-width: 1024px) {
    .wire:not(.down) {
      align-self: stretch;
      height: auto;
    }

    .wire:not(.down) .label {
      left: 50%;
      top: calc(50% - 24px);
      transform: translateX(-50%);
    }

    .wire:not(.down) .lane {
      width: auto;
      height: 2px;
    }

    .wire:not(.down) .lane::after {
      top: -3px;
      width: 7px;
      height: 8px;
    }

    .wire:not(.down) .send {
      top: calc(50% - 7px);
      bottom: auto;
      left: 4px;
      right: 10px;
    }

    .wire:not(.down) .back {
      top: calc(50% + 5px);
      bottom: auto;
      left: 10px;
      right: 4px;
    }

    .wire:not(.down) .send::after {
      left: auto;
      right: -6px;
      bottom: auto;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }

    .wire:not(.down) .back::after {
      left: -6px;
      clip-path: polygon(100% 0, 0 50%, 100% 100%);
    }

    .wire:not(.down) .fill {
      transform-origin: left center;
      transform: scaleX(var(--p));
    }

    .wire:not(.down) .back .fill {
      transform-origin: right center;
    }
  }
</style>
