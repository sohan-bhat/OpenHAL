---
import type { StoryFacts } from "../../../lib/story/facts";
import { lit, shown } from "../../../lib/story/script";
import { KERNEL, type Word } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const names = ["Units", "Range", "Rate", "Interlocks", "Confirmation"];
const checks = names.map((name, index) => ({
  name,
  marks: KERNEL.passes.flatMap((pass) => (pass.words[index] ? [{ in: pass.in, word: pass.words[index] }] : [])),
}));
const verdicts = [
  { in: KERNEL.waiting, kind: "idle", text: "Waiting for a command" },
  { in: KERNEL.granted, kind: "granted", text: "granted" },
  { in: KERNEL.blocked, kind: "blocked", text: facts.nozzle.refusal.name },
  { in: KERNEL.confirm, kind: "confirm", text: "confirmation required" },
];
const markClass = (word: Word) => ({ ok: "status ok", blocked: "status blocked", required: "status confirm", "not needed": "quiet" })[word];
const verdictClass = (kind: string) => ({ blocked: "status blocked mono", granted: "status ok", confirm: "status confirm" })[kind] ?? "quiet";
---

<div class="node" data-cam="kernel" {...lit("kernel", step)}>
  <div class="node-head">
    <p class="node-name">Safety kernel</p>
    <p class="node-note wide-only">Checks in order</p>
  </div>
  <ol class="checks wide-only">
    {
      checks.map((check) => (
        <li>
          <span>{check.name}</span>
          <span class="swap check-mark">
            {check.marks.map((mark) => (
              <span class={markClass(mark.word)} {...shown(mark.in, step)}>
                {mark.word}
              </span>
            ))}
          </span>
        </li>
      ))
    }
  </ol>
  <div class="swap verdict">
    {
      verdicts.map((verdict) => (
        <p class:list={["verdict-box", verdict.kind]} {...shown(verdict.in, step)}>
          <span class={verdictClass(verdict.kind)}>{verdict.text}</span>
        </p>
      ))
    }
  </div>
</div>

<style>
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .checks li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    min-height: 21px;
    font-size: var(--t-legend);
    border-bottom: 1px solid var(--border);
  }

  .checks li:last-child {
    border-bottom: 0;
  }

  .check-mark {
    justify-items: end;
  }

  .check-mark .status {
    font-size: var(--t-legend);
  }

  .quiet {
    color: var(--text-2);
  }

  .verdict-box {
    display: flex;
    align-items: center;
    min-height: 34px;
    padding: 4px 8px;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: 4px;
  }

  .verdict-box .status {
    white-space: normal;
  }

  .verdict-box.blocked {
    border-color: var(--blocked);
    background: color-mix(in srgb, var(--blocked) 8%, var(--bg));
  }

  .verdict-box.granted {
    border-color: var(--accent);
  }

  .verdict-box.confirm {
    border-color: var(--confirm);
    background: var(--confirm-bg);
  }
</style>
