---
import type { StoryFacts } from "../../../lib/story/facts";
import { ALWAYS, cue } from "../../../lib/story/script";
import { KERNEL, type Pass, type Span, type Word } from "../../../lib/story/timeline";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const passes: Pass[] = [KERNEL.bed, KERNEL.nozzle, KERNEL.pause, KERNEL.cancel];
const names = ["Units", "Range", "Rate", "Interlocks", "Confirmation"];
const checks = names.map((name, index) => ({ name, marks: passes.flatMap((pass) => (pass.checks[index] ? [pass.checks[index]] : [])) }));
const checking = (before: Pass, after: Pass): Span => ({ at: before.verdict.out, out: after.verdict.at });
const verdicts = [
  { span: { at: ALWAYS, out: KERNEL.bed.verdict.at }, kind: "idle", text: "Waiting for a command" },
  { span: KERNEL.bed.verdict, kind: "granted", text: "granted" },
  { span: checking(KERNEL.bed, KERNEL.nozzle), kind: "idle", text: "Checking" },
  { span: KERNEL.nozzle.verdict, kind: "blocked", text: facts.nozzle.refusal.name },
  { span: checking(KERNEL.nozzle, KERNEL.pause), kind: "idle", text: "Checking" },
  { span: KERNEL.pause.verdict, kind: "granted", text: "granted" },
  { span: checking(KERNEL.pause, KERNEL.cancel), kind: "idle", text: "Checking" },
  { span: KERNEL.cancel.verdict, kind: "confirm", text: "confirmation required" },
];
const markClass = (word: Word) => ({ ok: "status ok", blocked: "status blocked", required: "status confirm", "not needed": "quiet" })[word];
const verdictClass = (kind: string) => ({ blocked: "status blocked mono", granted: "status ok", confirm: "status confirm" })[kind] ?? "quiet";
---

<div class="station" data-cam="kernel">
  <div class="station-head">
    <p class="station-name">Safety kernel</p>
    <p class="station-note">Checks every command, in order</p>
  </div>
  <ol class="checks">
    {
      checks.map((check) => (
        <li>
          <span>{check.name}</span>
          <span class="swap check-mark">
            {check.marks.map((mark) => (
              <span class:list={["cue", markClass(mark.word)]} style={shown(mark.span)}>
                {mark.word}
              </span>
            ))}
          </span>
        </li>
      ))
    }
  </ol>
  <div class="swap verdict">
    {
      verdicts.map((verdict) => (
        <p class:list={["cue", "verdict-box", verdict.kind]} style={shown(verdict.span)}>
          <span class={verdictClass(verdict.kind)}>{verdict.text}</span>
        </p>
      ))
    }
  </div>
</div>

<style>
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .checks li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    min-height: 32px;
    border-bottom: 1px solid var(--border);
  }

  .checks li:last-child {
    border-bottom: 0;
  }

  .check-mark {
    justify-items: end;
  }

  .quiet {
    color: var(--text-2);
  }

  .verdict-box {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 8px 12px;
    background: var(--bg);
    border: 1.5px solid var(--node);
    border-radius: 4px;
  }

  .verdict-box.blocked {
    border-color: var(--blocked);
    background: color-mix(in srgb, var(--blocked) 8%, var(--bg));
  }

  .verdict-box.granted {
    border-color: var(--accent);
  }

  .verdict-box.confirm {
    border-color: var(--confirm);
    background: var(--confirm-bg);
  }
</style>
