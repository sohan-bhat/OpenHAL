---
import type { StoryFacts } from "../../../lib/story/facts";
import { PLACED, lit, shown, type StepId } from "../../../lib/story/script";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const ids = PLACED.map((item) => item.id);
const grouped = <T,>(pick: (id: StepId) => T | undefined, key: (value: T) => string) => {
  const out = new Map<string, { value: T; in: StepId[] }>();
  for (const id of ids) {
    const value = pick(id);
    if (value === undefined) continue;
    const entry = out.get(key(value)) ?? { value, in: [] };
    entry.in.push(id);
    out.set(key(value), entry);
  }
  return [...out.values()];
};
const list = (reading: boolean) => {
  const steps = ids.filter((id) => facts.kernel[id].reading === reading);
  const names = [...new Set(steps.flatMap((id) => facts.kernel[id].checks.map((check) => check.name)))];
  return {
    in: reading ? steps : ids.filter((id) => !facts.kernel[id].reading),
    checks: names.map((name) => ({
      name,
      marks: grouped((id) => (steps.includes(id) ? facts.kernel[id].checks.find((check) => check.name === name)?.word : undefined), (word) => word),
    })),
  };
};
const lists = [list(false), list(true)];
const verdicts = grouped((id) => facts.kernel[id].verdict, (verdict) => `${verdict.kind} ${verdict.text}`);
const markClass = (word: string) => ({ ok: "status ok", blocked: "status blocked", required: "status confirm", issued: "status ok" })[word] ?? "quiet";
const verdictClass = (kind: string) => ({ blocked: "status blocked mono", granted: "status ok", confirm: "status confirm" })[kind] ?? "quiet";
---

<div class="node" data-cam="kernel" {...lit("kernel", step)}>
  <div class="node-head">
    <p class="node-name">Safety kernel</p>
    <p class="node-note wide-only">Checks in order</p>
  </div>
  <div class="swap wide-only">
    {
      lists.map((list) => (
        <ol class="checks" {...shown(list.in, step)}>
          {list.checks.map((check) => (
            <li>
              <span>{check.name}</span>
              <span class="swap check-mark">
                {check.marks.map((mark) => (
                  <span class={markClass(mark.value)} {...shown(mark.in, step)}>
                    {mark.value}
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ol>
      ))
    }
  </div>
  <div class="swap verdict">
    {
      verdicts.map((verdict) => (
        <p class:list={["verdict-line", verdict.value.kind]} {...shown(verdict.in, step)}>
          <span class={verdictClass(verdict.value.kind)}>{verdict.value.text}</span>
        </p>
      ))
    }
  </div>
</div>

<style>
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    align-content: start;
  }

  .checks li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    min-height: 21px;
    font-size: var(--t-legend);
    border-bottom: 1px solid var(--border);
  }

  .checks li:last-child {
    border-bottom: 0;
  }

  .check-mark {
    justify-items: end;
  }

  .check-mark .status {
    font-size: var(--t-legend);
  }

  .quiet {
    color: var(--text-2);
  }

  .verdict-line {
    display: flex;
    align-items: center;
    min-height: 24px;
  }

  .verdict-line .status {
    font-size: var(--t-small);
  }
</style>
