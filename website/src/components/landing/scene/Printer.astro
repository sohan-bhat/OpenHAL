---
import type { StoryFacts } from "../../../lib/story/facts";
import { nb } from "../../../lib/story/facts";
import { lit, runs, shown } from "../../../lib/story/script";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const readings = facts.printer.readings.map((reading) => ({ ...reading, values: runs(reading.at) }));
---

<div class="node" data-cam="printer" {...lit("printer", step)}>
  <div class="node-head">
    <p class="node-name">{facts.printer.name}</p>
    <p class="node-note">Simulated</p>
  </div>
  <div class="readings">
    {
      readings.map((reading) => (
        <div class="reading">
          <p class="reading-name">{reading.name}</p>
          <p class:list={["swap", "value", reading.word ? "word" : "figure"]}>
            {reading.values.map((value) => (
              <span {...shown(value.in, step)}>{nb(value.text)}</span>
            ))}
          </p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .readings {
    display: grid;
    gap: 6px;
  }

  .reading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--s-2);
  }

  .reading-name {
    color: var(--text-2);
  }

  .value {
    margin-left: auto;
    justify-items: end;
    text-align: right;
  }

  .word {
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
