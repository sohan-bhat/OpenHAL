---
import type { StoryFacts } from "../../../lib/story/facts";
import { nb } from "../../../lib/story/facts";
import { cue } from "../../../lib/story/script";
import { CLIENT, type Span } from "../../../lib/story/timeline";
import { arrowSvg } from "../../../lib/trace-html.mjs";

interface Props {
  facts: StoryFacts;
}

const { facts } = Astro.props;
const shown = (span: Span) => cue(span.at, span.out);
const asks = [facts.look, facts.bed, facts.nozzle, facts.look, facts.pause, facts.cancel];
const image = { kind: "ok", name: "result", text: facts.camera.image, mono: true };
const hears = [
  image,
  { kind: "ok", name: facts.bed.status, text: `${facts.bed.target} ${facts.bed.value}`, mono: true },
  { kind: "blocked", name: facts.nozzle.refusal.name, text: facts.nozzle.refusal.reason, mono: false },
  image,
  { kind: "ok", name: facts.pause.status, text: facts.pause.target, mono: true },
  { kind: "confirm", name: facts.cancel.status, text: "confirmation required", mono: false },
];
---

<div class="station" data-cam="client">
  <div class="station-head">
    <p class="station-name">Agent</p>
    <p class="station-note">Claude, Cursor or any MCP client</p>
  </div>
  <div class="exchange">
    <div class="swap">
      {
        asks.map((ask, index) => (
          <div class="said cue" style={shown(CLIENT.asks[index])}>
            <Fragment set:html={arrowSvg("out")} />
            <div class="said-body">
              <p class="mono said-method">{ask.method}</p>
              <p class="mono said-arg">{ask.target}</p>
              {ask.value && <p class="figure">{nb(ask.value)}</p>}
            </div>
          </div>
        ))
      }
    </div>
    <div class="swap">
      {
        hears.map((answer, index) => (
          <div class="said cue" style={shown(CLIENT.hears[index])}>
            <Fragment set:html={arrowSvg("in")} />
            <div class="said-body">
              <p class:list={["mono", "status", answer.kind]}>{answer.name}</p>
              <p class:list={["said-reason", { mono: answer.mono }]}>{nb(answer.text)}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .exchange {
    display: grid;
    gap: var(--s-4);
  }

  .said {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    column-gap: 10px;
    align-items: start;
  }

  .said :global(.trace-arrow) {
    margin-top: 6px;
    color: var(--text);
  }

  .said-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .said-method {
    color: var(--accent);
    font-weight: 700;
  }

  .said-arg {
    overflow-wrap: anywhere;
  }

  .said .status {
    white-space: normal;
  }

  .said-reason {
    color: var(--text-2);
  }
</style>
