---
import type { StoryFacts } from "../../../lib/story/facts";
import { ASKED, nb } from "../../../lib/story/facts";
import { lit, shown } from "../../../lib/story/script";
import { AGENT } from "../../../lib/story/timeline";
import { arrowSvg } from "../../../lib/trace-html.mjs";

interface Props {
  facts: StoryFacts;
  step?: number;
}

const { facts, step } = Astro.props;
const asks = [
  { ask: facts.look, in: AGENT.asks.look },
  { ask: facts.bed, in: AGENT.asks.bed },
  { ask: facts.nozzle, in: AGENT.asks.nozzle },
  { ask: facts.loose, in: AGENT.asks.loose },
  { ask: facts.pause, in: AGENT.asks.pause },
  { ask: facts.cancel, in: AGENT.asks.cancel },
];
const hears = [
  { in: AGENT.hears.look, kind: "ok", name: "result", text: facts.camera.image, mono: true },
  { in: AGENT.hears.bed, kind: "ok", name: facts.bed.status, text: "", mono: true },
  { in: AGENT.hears.nozzle, kind: "blocked", name: facts.nozzle.refusal.name, text: "", mono: false },
  { in: AGENT.hears.loose, kind: "ok", name: "result", text: facts.camera.image, mono: true },
  { in: AGENT.hears.pause, kind: "ok", name: facts.pause.status, text: "", mono: true },
  { in: AGENT.hears.cancel, kind: "confirm", name: facts.cancel.status, text: "", mono: false },
];
---

<div class="node" data-cam="client" {...lit("client", step)}>
  <div class="node-head">
    <p class="node-name">Agent</p>
    <p class="node-note wide-only">Claude, Cursor or any MCP client</p>
  </div>
  <div class="swap">
    <div class="person" {...shown(AGENT.person, step)}>
      <p class="who">You</p>
      <p class="person-text">“{ASKED}”</p>
    </div>
    <div class="person" {...shown(AGENT.logged, step)}>
      <p class="who">Logged as</p>
      <p class="person-text mono">{facts.agent}</p>
    </div>
    {
      asks.map(({ ask, in: ids }) => (
        <div class="said" {...shown(ids, step)}>
          <Fragment set:html={arrowSvg("out")} />
          <p class="said-body mono">
            <span class="said-method">{ask.method}</span> <span class="said-arg">{nb([ask.target, ask.value].filter(Boolean).join(" "))}</span>
          </p>
        </div>
      ))
    }
  </div>
  <div class="swap">
    {
      hears.map((answer) => (
        <div class="said" {...shown(answer.in, step)}>
          <Fragment set:html={arrowSvg("in")} />
          <div class="said-body">
            <p class:list={["mono", "status", answer.kind]}>{answer.name}</p>
            {answer.text && <p class:list={["said-reason", { mono: answer.mono }]}>{nb(answer.text)}</p>}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .person {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .who {
    color: var(--text-2);
    font-size: var(--t-legend);
  }

  .person-text {
    font-weight: 700;
  }

  .said {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    column-gap: 8px;
    align-items: start;
  }

  .said :global(.trace-arrow) {
    margin-top: 6px;
    color: currentColor;
  }

  .said-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .said-method {
    color: var(--accent);
    font-weight: 700;
  }

  .said-arg {
    overflow-wrap: anywhere;
  }

  .said .status {
    white-space: normal;
  }

  .said-reason {
    color: var(--text-2);
  }
</style>
