---
import { PITCH, PRODUCT_NAME } from "../../config/brand";
import { latestSpecHref } from "../../lib/spec";
import { LEDE, SPELLED } from "../../lib/story/name";

interface Props {
  spell: string;
}

const { spell } = Astro.props;
const labels = SPELLED.map((part) => ({ word: part.label, at: PRODUCT_NAME.lastIndexOf(part.letter) }));
---

<section class="home-width hero" aria-labelledby="home-title">
  <div class="hero-name" data-spell>
    <h1 id="home-title" class="hero-mark">{PRODUCT_NAME}</h1>
    <p class="hero-spell" aria-hidden="true" data-pagefind-ignore="all">
      {labels.map((item) => <span data-at={item.at}>{item.word}</span>)}
    </p>
  </div>
  <p class="hero-pitch">{PITCH}</p>
  <p class="hero-lede">{LEDE}</p>
  <p class="hero-actions">
    <a class="button hero-go" href="/docs/quickstart/">Get started</a>
    <a class="button quiet hero-spec" href={latestSpecHref()}>Read the specification</a>
  </p>
</section>
<script is:inline set:html={spell} />

<style>
  .hero {
    --mark: min(24.2cqi, 184px);
    --spell: clamp(12px, calc(var(--mark) * 0.15), 17px);
    container-type: inline-size;
    display: grid;
    justify-items: center;
    padding-top: var(--s-7);
    padding-bottom: var(--s-4);
    text-align: center;
  }

  .hero-name {
    position: relative;
    padding-bottom: calc(var(--spell) * 1.3 + var(--s-2));
  }

  .hero-mark {
    font-size: var(--mark);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .hero-spell {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    color: var(--text-2);
    font-size: var(--spell);
    line-height: 1;
  }

  .hero-spell[data-placed] {
    visibility: visible;
  }

  .hero-spell span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(calc(var(--x, 0px) - 50%), var(--y, 0px));
    white-space: nowrap;
  }

  .hero-pitch {
    max-width: 18em;
    margin-top: var(--s-5);
    font-size: var(--t-h2);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hero-lede {
    max-width: 36em;
    margin-top: var(--s-4);
    color: var(--text-2);
    font-size: var(--t-h3);
    line-height: 1.5;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero-actions .button {
    min-height: 48px;
    padding: 0 var(--s-4);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--s-8);
    }

    .hero-actions .button {
      padding: 0 var(--s-5);
    }
  }

  @media (min-width: 1024px) {
    .hero-pitch {
      font-size: var(--t-h1);
    }
  }
</style>
