---
import { CLI_NAME, PRODUCT_NAME, START_COMMAND } from "../../config/brand";
import { wordmarkInlineSvg } from "../../lib/brand-mark";
import { inlineScript } from "../../lib/inline-script";
import { installChannels } from "../../lib/install";
import { latestSpecHref } from "../../lib/spec";
import { SPELLED } from "../../lib/story/name";
import InstallTabs from "../islands/InstallTabs";
import { buttonVariants } from "../ui/button";
import installDefaultSource from "./install-default.js?raw";

interface Props {
  spell: string;
}

const { spell } = Astro.props;
const labels = SPELLED.map((part) => ({ word: part.label, at: PRODUCT_NAME.lastIndexOf(part.letter) }));
const installDefault = await inlineScript(installDefaultSource, "install-default.js");
---

<section class="home-width hero" aria-labelledby="home-title">
  <div class="hero-name" data-spell>
    <h1 id="home-title" class="hero-mark"><span class="visually-hidden">{PRODUCT_NAME}</span><Fragment set:html={wordmarkInlineSvg("hero-word")} /></h1>
    <p class="hero-spell" aria-hidden="true" data-pagefind-ignore="all">
      {labels.map((item) => <span data-at={item.at}>{item.word}</span>)}
    </p>
  </div>
  <div class="hero-install" data-install data-copy-command data-pagefind-ignore="all">
    <InstallTabs client:intent channels={installChannels()} label={`Install ${PRODUCT_NAME}`} />
  </div>
  <script is:inline set:html={installDefault} />
  <p class="hero-next">Then set up your first device with <code>{CLI_NAME} init</code>, and start {PRODUCT_NAME} with <code>{START_COMMAND}</code>.</p>
  <p class="hero-actions">
    <a class={buttonVariants({ size: "lg", className: "hero-go" })} data-slot="button" data-variant="default" href="/docs/quickstart/">Get started</a>
    <a class={buttonVariants({ variant: "outline", size: "lg", className: "hero-spec" })} data-slot="button" data-variant="outline" href={latestSpecHref()}>Read the specification</a>
  </p>
</section>
<script is:inline set:html={spell} />

<style>
  .hero {
    --mark: min(24.2cqi, 184px);
    --spell: clamp(12px, calc(var(--mark) * 0.15), 17px);
    container-type: inline-size;
    display: grid;
    justify-items: center;
    padding-top: var(--s-7);
    padding-bottom: var(--s-4);
    text-align: center;
  }

  .hero-name {
    position: relative;
    padding-bottom: calc(var(--spell) * 1.3 + var(--s-2));
  }

  .hero-mark {
    font-size: var(--mark);
    line-height: 1;
  }

  .hero-mark :global(.hero-word) {
    display: block;
    width: auto;
    height: calc(var(--mark) * 44 / 38);
    margin-block: calc(var(--mark) * -0.12) calc(var(--mark) * -0.1);
    color: var(--text);
  }

  .hero-spell {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    color: var(--text-2);
    font-size: var(--spell);
    line-height: 1;
  }

  .hero-spell[data-placed] {
    visibility: visible;
  }

  .hero-spell span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(calc(var(--x, 0px) - 50%), var(--y, 0px));
    white-space: nowrap;
  }

  .hero-install {
    --line: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: min(100%, 46rem);
    margin-top: var(--s-6);
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: start;
  }

  .hero-install :global([data-slot="tabs-list"]) {
    grid-column: 1 / -1;
    display: flex;
    width: auto;
    padding: var(--s-1);
    overflow-x: auto;
    border-bottom: var(--rule);
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    background: var(--bg);
  }

  .hero-install :global([data-slot="tabs-content"]) {
    grid-row: 2;
    grid-column: 1;
    min-width: 0;
    outline-offset: -2px;
  }

  .hero-install :global([data-slot="tabs-content"][data-state="inactive"]),
  .hero-install :global(.install-name) {
    display: none;
  }

  .hero-install :global(.install-line) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1ch;
    margin: 0;
    padding: var(--s-3) var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--line);
    line-height: 1.6;
  }

  .hero-install :global(.install-prompt) {
    color: var(--text-2);
    user-select: none;
  }

  .hero-install :global(.install-line code) {
    padding: 0;
    background: none;
    color: var(--text);
    font: inherit;
  }

  .hero-install :global(.install-piece) {
    white-space: nowrap;
  }

  .hero-install :global(.copy-button) {
    position: static;
    grid-row: 2;
    grid-column: 2;
    align-self: start;
    margin: calc(var(--s-3) + (var(--line) * 1.6 - 28px) / 2) var(--s-2) 0 0;
  }

  .hero-next {
    max-width: 46rem;
    margin-top: var(--s-3);
    color: var(--text-2);
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .hero-next code {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.93em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  @media (scripting: none) {
    .hero-install :global([data-slot="tabs-list"]) {
      display: none;
    }

    .hero-install :global([data-slot="tabs-content"]),
    .hero-install :global([data-slot="tabs-content"][data-state="inactive"]) {
      display: block;
      grid-row: auto;
      grid-column: 1 / -1;
    }

    .hero-install :global([data-slot="tabs-content"] + [data-slot="tabs-content"]) {
      border-top: var(--rule);
    }

    .hero-install :global(.install-name) {
      display: block;
      margin: 0;
      padding: var(--s-3) var(--s-4) 0;
      color: var(--text-2);
      font-size: var(--t-legend);
      font-weight: 600;
    }

    .hero-install :global(.install-name + .install-line) {
      padding-top: var(--s-1);
    }
  }

  @media (max-width: 767.98px) {
    .hero {
      --mark: 23.2cqi;
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--s-8);
    }
  }

  @media (min-width: 1024px) {
    .hero-install {
      --line: 15px;
    }
  }
</style>
