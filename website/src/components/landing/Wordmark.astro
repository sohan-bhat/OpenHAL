---
import { PITCH, PRODUCT_NAME } from "../../config/brand";
import { storyFacts } from "../../lib/story/facts";
import { CAMERA, during } from "../../lib/story/script";
import { storySequence } from "../../lib/story/timeline";
import { AWAY, DROP, FALL, FALLS, LEAVES, LOW, PARTS, TOTAL, briefSpan, fading } from "../../lib/story/wordmark";
import Sequence from "./scene/Sequence.astro";

interface Props {
  spell: string;
}

const { spell } = Astro.props;
const sequence = storySequence(storyFacts());
const letters = [...PRODUCT_NAME].map((letter, at) => {
  const fade = fading(PRODUCT_NAME, at);
  const part = PARTS.find((item) => PRODUCT_NAME.lastIndexOf(item.letter) === at);
  return {
    letter,
    part: part?.letter,
    style: `--d1: ${fade.dims[0]}; --w1: ${fade.dims[1]}; --u: ${fade.rises[0]}; --w2: ${fade.rises[1]}; --d2: ${fade.fades[0]}; --w3: ${fade.fades[1]}`,
  };
});
const spelled = PARTS.map((part) => ({ word: part.label, at: PRODUCT_NAME.lastIndexOf(part.letter) }));
const mode = `(() => {
  const hero = document.currentScript.previousElementSibling;
  if (matchMedia(${JSON.stringify(CAMERA)}).matches) hero.setAttribute("data-camera", "");
})();`;
---

<section
  class="home-width hero"
  aria-labelledby="home-title"
  data-sequence
  data-total={TOTAL}
  style={`--at: 0; --d: ${TOTAL}; --away: ${AWAY}; --falls: ${FALLS}; --leaves: ${LEAVES}; --drop: ${DROP}; --fall: ${FALL}; --low: ${LOW}`}
>
  <div class="hero-stage">
    <div class="hero-main">
      <div class="hero-name" data-spell>
        <h1 id="home-title" class="hero-mark">{PRODUCT_NAME}</h1>
        <span class="hero-letters" aria-hidden="true">
          {letters.map((item) => <span data-letter={item.part} style={item.style}>{item.letter}</span>)}
        </span>
        <p class="hero-spell" aria-hidden="true">
          {spelled.map((item) => <span data-at={item.at}>{item.word}</span>)}
        </p>
      </div>
      <p class="hero-pitch hero-leaves">{PITCH}</p>
      <a class="button hero-go hero-leaves" href="#try" {...during([[0, LEAVES]])}>Get started</a>
    </div>
    <span class="hero-slot" aria-hidden="true"></span>
    <div class="hero-demo" aria-hidden="true" data-pagefind-ignore="all">
      <Sequence sequence={sequence} still />
    </div>
    <div class="hero-briefs" aria-hidden="true" data-pagefind-ignore="all">
      {
        PARTS.map((part, index) => (
          <div class="hero-brief" data-letter={part.letter} {...during([briefSpan(index)])}>
            <p class="brief-label">{part.label}</p>
            <p class="brief-text">{part.brief}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="hero-runway" style={`height: ${TOTAL}vh`} aria-hidden="true"></div>
  <ul class="hero-list" role="list">
    {
      PARTS.map((part) => (
        <li>
          <p class="brief-label">
            <span class="brief-letter">{part.letter}</span> {part.label}
          </p>
          <p class="brief-text">{part.brief}</p>
        </li>
      ))
    }
  </ul>
</section>
<script is:inline set:html={`${mode}${spell}`} />

<style>
  .hero {
    --t: 0;
    --pin: 61px;
    position: relative;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    padding-top: var(--s-7);
    padding-bottom: var(--s-7);
  }

  .hero-main {
    display: grid;
    justify-items: start;
  }

  .hero-mark,
  .hero-letters {
    margin-left: -0.04em;
    font-size: min(21vw, 184px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .hero-name {
    position: relative;
  }

  .hero-letters,
  .hero-briefs,
  .hero-runway,
  .hero-slot,
  .hero-demo {
    display: none;
  }

  .hero-spell {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    color: var(--text-2);
    font-size: clamp(13px, calc(min(21vw, 184px) * 0.095), 17px);
    line-height: 1;
  }

  .hero-spell[data-placed] {
    visibility: visible;
  }

  .hero-spell span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(calc(var(--x, 0px) - 50%), var(--y, 0px));
    white-space: nowrap;
  }

  .hero-pitch {
    max-width: 22ch;
    margin-top: var(--s-6);
    font-size: var(--t-h2);
    line-height: 1.3;
  }

  .hero-go {
    margin-top: var(--s-6);
    min-height: 48px;
    padding: 0 var(--s-5);
  }

  .hero-demo {
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .hero-list {
    display: grid;
    gap: var(--s-6);
    max-width: 62ch;
    margin: var(--s-4) 0 var(--s-7);
    padding: 0;
    list-style: none;
  }

  .hero-list li {
    display: grid;
    gap: var(--s-1);
  }

  .brief-label {
    color: var(--text-2);
    font-size: var(--t-small);
  }

  .brief-letter {
    margin-right: var(--s-1);
    color: var(--text);
    font-size: var(--t-h2);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .brief-text {
    font-size: var(--t-body);
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .hero-stage {
      padding-top: var(--s-8);
    }
  }

  @media (min-width: 1200px) {
    .hero-stage {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-8);
    }

    .hero-main {
      grid-area: 1 / 1;
    }

    .hero-demo {
      display: grid;
      grid-area: 1 / 2;
      align-self: stretch;
      justify-self: end;
      max-width: 600px;
      margin-top: var(--s-2);
    }

    .hero-slot {
      grid-area: 2 / 1 / 3 / 3;
    }
  }

  @media screen {
    .hero[data-camera] .hero-stage {
      position: sticky;
      top: var(--pin);
      z-index: 1;
      height: calc(100svh - var(--pin));
      align-content: start;
      background: var(--bg);
    }

    .hero[data-camera] .hero-runway,
    .hero[data-camera] .hero-slot {
      display: block;
    }

    .hero[data-camera] .hero-demo {
      display: grid;
    }

    .hero[data-camera] .hero-slot {
      height: var(--band);
      margin-top: var(--s-6);
    }

    .hero[data-camera] .hero-demo {
      --gone: clamp(0, var(--t) / var(--drop), 1);
      margin-top: var(--s-4);
      transform: translateY(calc(var(--fall) * 100svh * var(--gone) * (0.6 + 0.4 * var(--gone))));
      opacity: min(0.999, calc(1 - var(--gone)));
    }

    .hero[data-camera] .hero-mark {
      opacity: min(0.999, clamp(0, (0.5 - var(--t)) * 1000, 1));
    }

    .hero[data-camera] .hero-letters {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      white-space: nowrap;
      opacity: min(0.999, clamp(0, (var(--t) - 0.5) * 1000, 1));
    }

    .hero[data-camera] .hero-letters > span {
      --dim: calc(
        clamp(0, (var(--t) - var(--d1)) / var(--w1), 1) - clamp(0, (var(--t) - var(--u)) / var(--w2), 1) + clamp(0, (var(--t) - var(--d2)) / var(--w3), 1)
      );
      opacity: min(0.999, calc(1 - (1 - var(--low)) * var(--dim)));
    }

    .hero[data-camera] .hero-name {
      transform: translateY(calc(var(--down, 0px) * clamp(0, (var(--t) - var(--falls)) / (var(--away) - var(--falls)), 1)));
    }

    .hero[data-camera] .hero-spell {
      opacity: min(0.999, calc(1 - clamp(0, var(--t) / var(--leaves), 1)));
    }

    .hero[data-camera] .hero-leaves {
      --gone: clamp(0, var(--t) / var(--leaves), 1);
      opacity: min(0.999, calc(1 - var(--gone)));
      transform: translateY(calc(var(--gone) * -40px));
    }

    .hero[data-camera] .hero-go[data-in]:not([data-on]) {
      visibility: hidden;
    }

    .hero[data-camera] .hero-briefs {
      display: block;
      position: absolute;
      top: var(--brief-top, 60%);
      left: 0;
      right: 0;
    }

    .hero[data-camera] .hero-brief {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: grid;
      gap: var(--s-2);
      max-width: 34em;
      opacity: 0.999;
      transition: opacity var(--motion-status) linear;
    }

    .hero[data-camera] .hero-brief:not([data-on]) {
      opacity: 0;
    }

    .hero[data-camera] .hero-brief[data-on] {
      transition-delay: var(--motion-status);
    }

    .hero[data-camera] .hero-brief .brief-text {
      font-size: 17px;
      line-height: 1.45;
    }

    .hero[data-camera] .hero-list {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .hero[data-camera] .hero-demo {
      margin-top: var(--s-2);
    }
  }

  @media screen and (min-width: 1024px) {
    .hero[data-camera] .hero-brief {
      left: var(--anchor, 0px);
      right: auto;
      width: min(30em, 100%);
    }

    .hero[data-camera] .hero-brief .brief-label {
      font-size: var(--t-body);
    }

    .hero[data-camera] .hero-brief .brief-text {
      font-size: 21px;
      line-height: 1.45;
    }
  }
</style>
