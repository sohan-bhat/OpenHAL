---
// How OpenHAL works, as the protocol diagram (docs/assets/openhal-diagram.png) drawn in HTML so it
// follows the theme and reads in order on a phone. Clients, then the hub, then devices.

const clients = ["Claude Desktop", "Claude Code", "Cursor", "Any MCP client", "Python library"];
const devices = ["3D printers", "Bench instruments", "Arduino and ESP32", "Smart home", "Cameras and sensors"];
---

<figure class="diagram" aria-labelledby="how-caption">
  <div class="column clients">
    <p class="legend">Clients</p>
    <ul>{clients.map((name) => <li>{name}</li>)}</ul>
  </div>
  <p class="wire legend" aria-hidden="true"><span>MCP or API</span></p>
  <div class="hub">
    <p class="legend hub-legend">OpenHAL hub</p>
    <ol>
      <li>
        <span class="mono n">1</span>
        <span class="step">Device files</span>
        <span class="what">What can be read and changed, with limits a person confirmed.</span>
      </li>
      <li class="kernel">
        <span class="mono n">2</span>
        <span class="step">Safety kernel</span>
        <span class="what">Checks every command. Unsafe ones stop here.</span>
        <div class="mini-track" aria-hidden="true">
          <div class="rail"></div>
          <div class="limit"><span class="limit-flag">Max 100 %</span></div>
          <div class="thumb"></div>
          <div class="attempt"></div>
        </div>
        <span class="blocked-note mono" aria-hidden="true">150 % blocked</span>
      </li>
      <li>
        <span class="mono n">3</span>
        <span class="step">Drivers</span>
        <span class="what">Act only with the kernel's grant for that one command.</span>
      </li>
    </ol>
  </div>
  <p class="wire legend" aria-hidden="true"><span>Grant</span></p>
  <div class="column devices">
    <p class="legend">Devices</p>
    <ul>{devices.map((name) => <li>{name}</li>)}</ul>
    <p class="status"><a href="/devices/">Which drivers run today</a></p>
  </div>
  <figcaption id="how-caption" class="visually-hidden">
    Clients reach the OpenHAL hub over MCP or its API. Inside the hub, device files hold the limits, the safety kernel checks every
    command against them, and drivers act on devices only with the kernel's grant.
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }

  .legend {
    color: var(--ink-2);
  }

  .column ul {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .column li {
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .status {
    margin-top: var(--s-3);
  }

  .wire {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .wire::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ink-2);
  }

  .wire span {
    position: relative;
    background: var(--panel);
    padding: 2px var(--s-2);
  }

  .hub {
    background: var(--bezel);
    color: var(--on-bezel);
    border-radius: var(--radius);
    padding: var(--s-4);
  }

  .hub-legend {
    color: var(--on-bezel);
  }

  .hub ol {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .hub li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    column-gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    background: var(--panel);
    color: var(--ink);
    border-radius: var(--radius);
  }

  .n {
    color: var(--ink-2);
    grid-row: span 2;
  }

  .step {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--t-3);
    line-height: var(--lh-3);
  }

  .what {
    grid-column: 2;
  }

  .mini-track {
    grid-column: 2;
    position: relative;
    height: 48px;
    margin-top: var(--s-3);
  }

  .mini-track .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 30px;
    height: 4px;
    background: var(--rule);
  }

  .mini-track .limit {
    position: absolute;
    left: 62%;
    top: 6px;
    bottom: 0;
    width: var(--limit-line-width);
    background: var(--limit-line-color);
  }

  .mini-track .limit-flag {
    position: absolute;
    top: -6px;
    left: 0;
  }

  .mini-track .thumb {
    position: absolute;
    left: 20%;
    top: 22px;
    width: 10px;
    height: 20px;
    background: var(--ink);
  }

  .mini-track .attempt {
    position: absolute;
    left: 90%;
    top: 23px;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border: 2px solid var(--blocked);
    border-radius: 50%;
  }

  .blocked-note {
    grid-column: 2;
    justify-self: end;
    color: var(--blocked);
    font-size: var(--t-1);
  }

  @media (min-width: 1024px) {
    .diagram {
      grid-template-columns: 3fr 1.2fr 6fr 1.2fr 3fr;
      align-items: center;
      gap: 0;
    }

    .wire::before {
      left: 0;
      right: 0;
      top: 50%;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .wire::after {
      content: "";
      position: absolute;
      right: 0;
      top: calc(50% - 5px);
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      border-left: 7px solid var(--ink-2);
    }

    .devices .status {
      margin-bottom: calc(-1 * var(--lh-2) - var(--s-3));
    }
  }
</style>
