---
import { FLOW_DEFAULT, FLOW_NODES, readFlow } from "../lib/flow";

const flow = readFlow();
const arts = flow ? [{ name: "wide", art: flow.wide }, ...(flow.narrow ? [{ name: "narrow", art: flow.narrow }] : [])] : [];
---

{
  flow && (
    <figure class:list={["flow", { "has-narrow": Boolean(flow.narrow) }]} data-flow>
      <div class="flow-art paused">
        {arts.map(({ name, art }) => (
          <>
            <div class={`flow-${name} flow-light`} style={`aspect-ratio: ${art.width} / ${art.height}; max-width: ${art.width}px`} set:html={art.light} />
            <div class={`flow-${name} flow-dark`} style={`aspect-ratio: ${art.width} / ${art.height}; max-width: ${art.width}px`} set:html={art.dark} />
          </>
        ))}
      </div>
      <figcaption>
        <div class="flow-parts" role="group" aria-label="Parts of the flow">
          {FLOW_NODES.map((node) => (
            <button type="button" data-node={node.key} data-text={node.text} aria-describedby="flow-note">
              {node.label}
            </button>
          ))}
        </div>
        <p id="flow-note" class="flow-note" aria-live="polite" data-default={FLOW_DEFAULT}>
          {FLOW_DEFAULT}
        </p>
      </figcaption>
    </figure>
  )
}

<script>
  const tokensOf = (group: Element): string[] => {
    const names = (group.getAttribute("class") ?? "").split(/\s+/);
    const out: string[] = [];
    for (const name of names) {
      if (!name || name === "node" || name === "wire" || name === "detail") continue;
      try {
        out.push(...atob(name).toLowerCase().split(/[^a-z]+/));
      } catch {
        continue;
      }
    }
    return out.filter(Boolean);
  };

  for (const figure of document.querySelectorAll<HTMLElement>("[data-flow]")) {
    const art = figure.querySelector<HTMLElement>(".flow-art");
    const note = figure.querySelector<HTMLElement>(".flow-note");
    if (!art || !note) continue;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) art.classList.toggle("paused", !entry.isIntersecting);
      },
      { threshold: 0.2 },
    );
    observer.observe(art);
    const groups = [...art.querySelectorAll<SVGGElement>("svg.d2-svg > g:not(.oh-flows)")].map((group) => ({ group, tokens: tokensOf(group) }));
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-node]")];
    const show = (key: string | null) => {
      figure.classList.toggle("focused", key !== null);
      for (const { group, tokens } of groups) group.classList.toggle("flow-active", key !== null && tokens.includes(key));
      for (const button of buttons) button.classList.toggle("active", button.dataset.node === key);
      const button = buttons.find((item) => item.dataset.node === key);
      note.textContent = button?.dataset.text ?? note.dataset.default ?? "";
    };
    for (const button of buttons) {
      const key = button.dataset.node ?? null;
      button.addEventListener("mouseenter", () => show(key));
      button.addEventListener("focus", () => show(key));
      button.addEventListener("click", () => show(key));
      button.addEventListener("mouseleave", () => {
        if (document.activeElement !== button) show(null);
      });
      button.addEventListener("blur", () => show(null));
    }
    const keys = new Set(buttons.map((button) => button.dataset.node));
    art.addEventListener("mouseover", (event) => {
      const group = (event.target as Element).closest("svg.d2-svg > g.node, svg.d2-svg > g.detail, svg.d2-svg > g:not([class~=wire]):not(.oh-flows)");
      if (!group) return;
      const key = tokensOf(group).find((token) => keys.has(token) && token !== "hub") ?? tokensOf(group).find((token) => keys.has(token));
      if (key) show(key);
    });
    art.addEventListener("mouseleave", () => show(null));
  }
</script>

<style>
  .flow {
    margin: 0;
  }

  .flow-art > div {
    width: 100%;
  }

  .flow-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .flow-art.paused :global(*) {
    animation-play-state: paused !important;
  }

  .flow-dark,
  .flow-narrow {
    display: none;
  }

  .flow-wide.flow-light {
    display: block;
  }

  @media (max-width: 600px) {
    .has-narrow .flow-wide.flow-light {
      display: none;
    }

    .has-narrow .flow-narrow.flow-light {
      display: block;
      margin-inline: auto;
    }
  }

  @media (prefers-color-scheme: dark) {
    .flow-art .flow-light {
      display: none !important;
    }

    .flow-wide.flow-dark {
      display: block;
    }

    @media (max-width: 600px) {
      .has-narrow .flow-wide.flow-dark {
        display: none;
      }

      .has-narrow .flow-narrow.flow-dark {
        display: block;
        margin-inline: auto;
      }
    }
  }

  .flow.focused .flow-art :global(svg.d2-svg > g:not(.flow-active):not(.oh-flows)) {
    opacity: 0.3;
  }

  .flow-parts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-4);
  }

  .flow-parts button {
    font: inherit;
    font-size: var(--t-small);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 4px 10px;
    min-height: 32px;
    cursor: pointer;
  }

  .flow-parts button:hover,
  .flow-parts button.active {
    background: var(--surface);
    border-color: var(--text-2);
  }

  .flow-note {
    margin: var(--s-2) 0 0;
    color: var(--text-2);
    min-height: 1.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-art :global(*) {
      animation: none !important;
    }
  }
</style>
