---
import { FLOW_DEFAULT, flowNodes, readFlow } from "../lib/flow";

const flow = readFlow();
const nodes = flowNodes(flow?.wide.light ?? null);
const arts = flow ? [{ name: "wide", art: flow.wide }, ...(flow.narrow ? [{ name: "narrow", art: flow.narrow }] : [])] : [];
const variants = arts.flatMap(({ name, art }) => [
  { key: `${name}-light`, html: art.light + art.lightFlows, width: art.width, height: art.height },
  { key: `${name}-dark`, html: art.dark + art.darkFlows, width: art.width, height: art.height },
]);
const wide = flow?.wide;
const narrow = flow?.narrow;
const stamp = `(() => {
  const art = document.currentScript.previousElementSibling;
  const slot = art.querySelector(".flow-slot");
  const narrowQuery = matchMedia("(max-width: 600px)");
  const darkQuery = matchMedia("(prefers-color-scheme: dark)");
  const show = () => {
    const size = narrowQuery.matches && art.querySelector('template[data-variant^="narrow"]') ? "narrow" : "wide";
    const key = size + "-" + (darkQuery.matches ? "dark" : "light");
    if (art.dataset.shown === key) return;
    const template = art.querySelector('template[data-variant="' + key + '"]');
    if (!template) return;
    slot.replaceChildren(template.content.cloneNode(true));
    slot.style.aspectRatio = template.dataset.ratio;
    slot.style.maxWidth = template.dataset.width + "px";
    art.dataset.shown = key;
    art.dispatchEvent(new Event("flow:stamp"));
  };
  show();
  narrowQuery.addEventListener("change", show);
  darkQuery.addEventListener("change", show);
})();`;
---

{
  flow && (
    <figure class:list={["flow", { "has-narrow": Boolean(flow.narrow) }]} data-flow>
      <div
        class="flow-art paused"
        style={`--wide-ratio: ${wide!.width} / ${wide!.height}; --wide-width: ${wide!.width}px; --narrow-ratio: ${(narrow ?? wide)!.width} / ${(narrow ?? wide)!.height}; --narrow-width: ${(narrow ?? wide)!.width}px`}
      >
        {variants.map((variant) => (
          <template data-variant={variant.key} data-ratio={`${variant.width} / ${variant.height}`} data-width={String(variant.width)} set:html={variant.html} />
        ))}
        <div class="flow-slot">
          <noscript set:html={wide!.light} />
        </div>
      </div>
      <script is:inline set:html={stamp} />
      <figcaption>
        <p id="flow-hint" class="flow-hint">Click a step</p>
        <div class="flow-parts" role="group" aria-labelledby="flow-hint">
          {nodes.map((node) => (
            <button type="button" data-node={node.key} data-text={node.text} aria-describedby="flow-note" aria-pressed="false">
              {node.label}
            </button>
          ))}
        </div>
        <p id="flow-note" class="flow-note" aria-live="polite" data-default={FLOW_DEFAULT}>
          {FLOW_DEFAULT}
        </p>
      </figcaption>
    </figure>
  )
}

<script>
  const tokensOf = (group: Element): string[] => {
    const names = (group.getAttribute("class") ?? "").split(/\s+/);
    const out: string[] = [];
    for (const name of names) {
      if (!name || name === "node" || name === "wire" || name === "detail") continue;
      try {
        out.push(...atob(name).toLowerCase().split(/[^a-z]+/));
      } catch {
        continue;
      }
    }
    return out.filter(Boolean);
  };

  for (const figure of document.querySelectorAll<HTMLElement>("[data-flow]")) {
    const art = figure.querySelector<HTMLElement>(".flow-art");
    const note = figure.querySelector<HTMLElement>(".flow-note");
    if (!art || !note) continue;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) art.classList.toggle("paused", !entry.isIntersecting);
      },
      { threshold: 0.2 },
    );
    observer.observe(art);
    let groups: Array<{ group: SVGGElement; tokens: string[] }> = [];
    const collect = () => {
      groups = [...art.querySelectorAll<SVGGElement>(".flow-slot svg.d2-svg > g:not(.oh-flows)")].map((group) => ({ group, tokens: tokensOf(group) }));
    };
    collect();
    art.addEventListener("flow:stamp", collect);
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-node]")];
    const show = (key: string | null) => {
      figure.classList.toggle("focused", key !== null);
      if (key === null) delete figure.dataset.active;
      else figure.dataset.active = key;
      for (const { group, tokens } of groups) group.classList.toggle("flow-active", key !== null && tokens.includes(key));
      for (const button of buttons) {
        button.classList.toggle("active", button.dataset.node === key);
        button.setAttribute("aria-pressed", String(button.dataset.node === key));
      }
      const button = buttons.find((item) => item.dataset.node === key);
      note.textContent = button?.dataset.text ?? note.dataset.default ?? "";
    };
    for (const button of buttons) {
      const key = button.dataset.node ?? null;
      button.addEventListener("mouseenter", () => show(key));
      button.addEventListener("focus", () => show(key));
      button.addEventListener("click", () => show(key));
      button.addEventListener("mouseleave", () => {
        if (document.activeElement !== button) show(null);
      });
      button.addEventListener("blur", () => show(null));
    }
    const keys = new Set(buttons.map((button) => button.dataset.node));
    art.addEventListener("mouseover", (event) => {
      const group = (event.target as Element).closest("svg.d2-svg > g.node, svg.d2-svg > g.detail, svg.d2-svg > g:not([class~=wire]):not(.oh-flows)");
      if (!group) return;
      const key = tokensOf(group).find((token) => keys.has(token) && token !== "hub") ?? tokensOf(group).find((token) => keys.has(token));
      if (key) show(key);
    });
    art.addEventListener("mouseleave", () => show(null));
  }
</script>

<style>
  .flow {
    margin: 0;
  }

  .flow-slot {
    position: relative;
    width: 100%;
    max-width: var(--wide-width);
    aspect-ratio: var(--wide-ratio);
  }

  @media (max-width: 600px) {
    .flow-slot {
      max-width: var(--narrow-width);
      aspect-ratio: var(--narrow-ratio);
      margin-inline: auto;
    }
  }

  .flow-art :global(svg.flow-overlay) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    will-change: transform;
  }

  .flow-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .flow-art.paused :global(*) {
    animation-play-state: paused !important;
  }

  .flow.focused .flow-art :global(svg.d2-svg > g:not(.flow-active):not(.oh-flows)) {
    opacity: 0.3;
  }

  .flow-art :global(svg.d2-svg > g.flow-active > rect.shape) {
    stroke: var(--accent);
    stroke-width: 2.5px !important;
  }

  .flow[data-active="blocked"] .flow-art :global(svg.d2-svg > g.flow-active > rect.shape) {
    stroke: var(--blocked);
  }

  .flow-hint {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .flow-parts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-2);
  }

  .flow-parts button {
    font: inherit;
    font-size: var(--t-small);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 4px 10px;
    min-height: 32px;
    cursor: pointer;
  }

  .flow-parts button:hover {
    background: var(--surface);
    border-color: var(--text-2);
  }

  .flow-parts button.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .flow-parts button[data-node="blocked"].active {
    color: var(--blocked);
    border-color: var(--blocked);
    background: color-mix(in srgb, var(--blocked) 8%, var(--bg));
  }

  .flow-note {
    margin: var(--s-2) 0 0;
    color: var(--text-2);
    min-height: 1.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-art :global(*) {
      animation: none !important;
    }
  }
</style>
