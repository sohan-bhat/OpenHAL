---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import DeviceSummary from "../components/DeviceSummary.astro";
import HeroDemo from "../components/HeroDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Mhs from "../components/Mhs.astro";
import SafetyModel from "../components/SafetyModel.astro";
import Storyboard from "../components/Storyboard.astro";
import { PITCH, PRODUCT_NAME } from "../config/brand";
import { capture } from "../lib/captures";
import { HOME_TITLE } from "../lib/pages";

const quickstart = await getEntry("snippets", "quickstart");
const { Content: Quickstart } = await render(quickstart!);
const dashboard = capture("/captures/hero.png");
---

<Base title={`${PRODUCT_NAME}. ${HOME_TITLE}`} description={PITCH} bare>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-head">
        <h1 id="hero-title">AI agents drive real hardware. People set the limits.</h1>
        <div class="hero-side">
          <p class="lede">An open hub that checks every command from any MCP client before it reaches a device.</p>
          <p class="ctas">
            <a class="button" href="/docs/quickstart/">Quickstart</a>
            <a class="text-link" href="/playground/">Playground</a>
          </p>
        </div>
      </div>
      <div class="hero-demo" data-capture-slot="hero">
        <HeroDemo />
        {
          dashboard && (
            <figure class="module capture">
              <figcaption class="module-legend legend">
                <span>Dashboard, demo data</span>
              </figcaption>
              {dashboard.video ? (
                <video controls muted playsinline preload="none" poster={dashboard.src} width={dashboard.width} height={dashboard.height}>
                  <source src={dashboard.video} type="video/webm" />
                </video>
              ) : (
                <img src={dashboard.src} width={dashboard.width} height={dashboard.height} alt="The OpenHAL dashboard on mock devices, blocking an unsafe write" />
              )}
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="band-title">How it works</h2>
      <HowItWorks />
    </div>
  </section>

  <section class="band" aria-labelledby="safety-title">
    <div class="wrap">
      <h2 id="safety-title" class="band-title">What the kernel guarantees</h2>
      <SafetyModel />
    </div>
  </section>

  <section class="band" aria-labelledby="demo-title">
    <div class="wrap">
      <h2 id="demo-title" class="band-title">Thirty seconds, start to block</h2>
      <Storyboard />
    </div>
  </section>

  <section class="band" aria-labelledby="devices-title">
    <div class="wrap">
      <h2 id="devices-title" class="band-title">Supported devices</h2>
      <DeviceSummary />
    </div>
  </section>

  <section class="band" aria-labelledby="mhs-title">
    <div class="wrap">
      <h2 id="mhs-title" class="band-title">OpenHAL and MHS</h2>
      <Mhs />
    </div>
  </section>

  <section class="band" aria-labelledby="start-title">
    <div class="wrap start">
      <h2 id="start-title" class="band-title">Quickstart</h2>
      <div class="prose quickstart">
        <Quickstart />
        <p><a href="/docs/quickstart/">Full quickstart</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--s-7) 0 0;
  }

  .hero-head {
    display: grid;
    gap: var(--s-5);
    margin-bottom: var(--s-7);
  }

  h1 {
    font-size: var(--t-5);
    line-height: var(--lh-5);
    font-weight: 750;
    letter-spacing: -0.01em;
    max-width: 16ch;
  }

  .lede {
    max-width: 36ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }

  .text-link {
    font-weight: 700;
  }

  .hero-demo {
    display: grid;
    gap: var(--s-6);
    min-width: 0;
  }

  .capture {
    margin: 0;
  }

  .capture img,
  .capture video {
    width: 100%;
    height: auto;
  }

  .band {
    padding: var(--s-8) 0 0;
  }

  .band > .wrap {
    border-top: 1px solid var(--ink);
    padding-top: var(--s-5);
  }

  .band-title {
    font-size: var(--t-4);
    line-height: var(--lh-4);
    margin-bottom: var(--s-6);
    max-width: 24ch;
  }

  .quickstart {
    max-width: 80ch;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--s-8);
    }

    .hero-head {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: var(--s-7);
    }

    .band {
      padding-top: var(--s-9);
    }

    .start {
      display: grid;
      grid-template-columns: 4fr 8fr;
      gap: var(--s-7);
    }
  }
</style>
