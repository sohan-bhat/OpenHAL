---
import { getEntry, render } from "astro:content";
import FlowDiagram from "../components/FlowDiagram.astro";
import MessageTrace from "../components/MessageTrace.astro";
import { PRODUCT_NAME } from "../config/brand";
import Base from "../layouts/Base.astro";
import { drivers, statusWord } from "../lib/catalog";
import { HOME_TITLE } from "../lib/pages";
import { scenarioTrace } from "../lib/scenario";
import { latestVersion, specPages } from "../lib/spec";
import "../styles/prose.css";

const quickstart = await getEntry("snippets", "quickstart");
const { Content: Quickstart } = await render(quickstart!);
const all = drivers();
const running = all.filter((driver) => driver.tier > 0 && (driver.status === "implemented" || driver.status === "verified"));
const planned = all.filter((driver) => driver.status === "planned").length;
const verified = all.filter((driver) => driver.status === "verified").length;
const latest = latestVersion();
const sections = latest ? (await specPages(latest)).filter((page) => page.depth === 1) : [];
---

<Base title={`${PRODUCT_NAME}. ${HOME_TITLE}`} description={HOME_TITLE} bare>
  <div class="wrap home">
    <section class="intro" aria-labelledby="home-title">
      <h1 id="home-title">{HOME_TITLE}</h1>
      <FlowDiagram />
      <MessageTrace entries={scenarioTrace()} note="Demo data" />
    </section>

    <section aria-labelledby="start-title" class="block">
      <h2 id="start-title">Quickstart</h2>
      <div class="prose quickstart">
        <Quickstart />
      </div>
    </section>

    <section aria-labelledby="devices-title" class="block">
      <h2 id="devices-title">Device families</h2>
      <p class="summary">
        <span class={`status ${verified ? "ok" : "unverified"}`}>{running.length} drivers {statusWord("implemented")}</span>
        <span class="muted">{verified ? `${verified} verified on hardware.` : "None is verified on hardware yet."} {planned} planned.</span>
      </p>
      <div class="table-wrap">
        <table class="families">
          <thead>
            <tr><th scope="col">Driver</th><th scope="col">Device families</th></tr>
          </thead>
          <tbody>
            {
              running.map((driver) => (
                <tr>
                  <td data-label="Driver"><a class="mono" href={`/drivers/${driver.name}/`}>{driver.name}</a></td>
                  <td data-label="Device families">{driver.families.join(", ")}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p><a href="/drivers/">All drivers, with tier, status and hazard</a></p>
    </section>

    <section aria-labelledby="mhs-title" class="block">
      <h2 id="mhs-title">MHS</h2>
      <p class="measure">
        Anthropic's Model Hardware Standard is a limited research preview for invited labs. OpenHAL is an independent open protocol, not
        affiliated with Anthropic or MHS, and plans to stay compatible as MHS opens up.
      </p>
    </section>

    <section aria-labelledby="spec-title" class="block">
      <h2 id="spec-title">Specification</h2>
      {
        sections.length ? (
          <ol class="spec-links">
            {sections.map((page) => (
              <li>
                <a href={page.href}>
                  <span class="mono num">{page.number}</span> {page.title}
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <ul class="spec-links">
            <li><a href="/spec/">Specification</a></li>
            <li><a href="/docs/device-file-format/">Device file format</a></li>
            <li><a href="/docs/safety/">Safety model</a></li>
          </ul>
        )
      }
    </section>
  </div>
</Base>

<style>
  .home {
    max-width: 1040px;
    padding-top: var(--s-7);
  }

  .intro {
    display: grid;
    gap: var(--s-6);
  }

  h1 {
    max-width: 24ch;
  }

  .block {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }

  .quickstart {
    max-width: none;
    min-width: 0;
  }

  .quickstart :global(.code-block) {
    margin-top: 0;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  .families td:first-child {
    white-space: nowrap;
    width: 1%;
  }

  .measure {
    max-width: var(--measure);
  }

  .spec-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .num {
    display: inline-block;
    min-width: 2em;
    color: var(--text-2);
  }

  @media (max-width: 599px) {
    .families,
    .families tbody,
    .families tr,
    .families td {
      display: block;
    }

    .families thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .families tr {
      padding: var(--s-2) 0;
      border-bottom: var(--rule);
    }

    .families td {
      border: 0;
      padding: 0;
      width: auto;
    }
  }
</style>
