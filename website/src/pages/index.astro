---
import { getEntry, render } from "astro:content";
import FlowDiagram from "../components/FlowDiagram.astro";
import MessageTrace from "../components/MessageTrace.astro";
import { PRODUCT_NAME } from "../config/brand";
import Base from "../layouts/Base.astro";
import { driverGroups, drivers, statusWord } from "../lib/catalog";
import { HOME_TITLE } from "../lib/pages";
import { outcome, scenarioTrace } from "../lib/scenario";
import { latestVersion, specPages } from "../lib/spec";
import { specSidebar } from "../lib/spec-nav";
import "../styles/prose.css";

const quickstart = await getEntry("snippets", "quickstart");
const { Content: Quickstart } = await render(quickstart!);
const all = drivers();
const groups = driverGroups();
const planned = all.filter((driver) => driver.status === "planned").length;
const tested = all.filter((driver) => driver.status === "implemented").length;
const verified = all.filter((driver) => driver.status === "verified").length;
const latest = latestVersion();
const specItems = latest ? specSidebar(await specPages(latest))[0].items : [];
const sections = specItems
  .map((item, index) => ({ ...item, href: item.href ?? specItems[index + 1]?.href }))
  .filter((item) => item.depth === 1 && item.href);
---

<Base title={`${PRODUCT_NAME}. ${HOME_TITLE}`} description={HOME_TITLE} bare>
  <div class="wrap home">
    <section class="intro" aria-labelledby="home-title">
      <h1 id="home-title">{HOME_TITLE}</h1>
      <FlowDiagram />
      <MessageTrace entries={scenarioTrace()} note="Recorded with openhal demo" />
    </section>

    <section aria-labelledby="start-title" class="block">
      <h2 id="start-title">Quickstart</h2>
      <div class="prose quickstart">
        <Quickstart />
        <p>{outcome().replace(/(\d) (?=[%a-zA-Z])/g, "$1\u00a0")}</p>
      </div>
    </section>

    <section aria-labelledby="devices-title" class="block">
      <h2 id="devices-title">Device families</h2>
      <p class="summary">
        <span class={`status ${verified ? "ok" : "unverified"}`}>{tested} drivers {statusWord("implemented")}</span>
        <span class="muted">{verified ? `${verified} verified on hardware.` : "None is verified on hardware yet."}{planned ? ` ${planned} planned.` : ""}</span>
      </p>
      <ul class="groups">
        {
          groups.map((group) => (
            <li>
              <h3>{group.name}</h3>
              <p class="count">
                <span class={`status ${group.verified ? "ok" : "unverified"}`}>
                  {group.verified ? `${group.verified} verified on hardware, ` : ""}
                  {group.tested} {statusWord("implemented")}
                </span>
              </p>
              <p class="names">
                {group.drivers.map((driver, index) => (
                  <>
                    <a class="mono" href={`/drivers/${driver.name}/`}>
                      {driver.name}
                    </a>
                    {index < group.drivers.length - 1 ? " " : ""}
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p><a href="/drivers/">All {all.length} drivers, with protocols, tier, status and hazard</a></p>
    </section>

    <section aria-labelledby="mhs-title" class="block">
      <h2 id="mhs-title">MHS</h2>
      <p class="measure">
        Anthropic's Model Hardware Standard is a limited research preview for invited labs. OpenHAL is an independent open protocol, not
        affiliated with Anthropic or MHS, and plans to stay compatible as MHS opens up.
      </p>
    </section>

    <section aria-labelledby="spec-title" class="block">
      <h2 id="spec-title">Specification</h2>
      {
        sections.length ? (
          <ol class="spec-links">
            {sections.map((page) => (
              <li>
                <a href={page.href}>
                  <span class="mono num">{page.number}</span> {page.title}
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <ul class="spec-links">
            <li><a href="/spec/">Specification</a></li>
            <li><a href="/docs/safety/">Safety model</a></li>
          </ul>
        )
      }
    </section>
  </div>
</Base>

<style>
  .home {
    max-width: 1040px;
    padding-top: var(--s-7);
  }

  .intro {
    display: grid;
    gap: var(--s-6);
  }

  h1 {
    max-width: 24ch;
  }

  .block {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }

  .quickstart {
    max-width: none;
    min-width: 0;
  }

  .quickstart :global(.code-block) {
    margin-top: 0;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  .groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 var(--s-5);
    align-items: start;
  }

  .groups li + li {
    margin-top: var(--s-4);
  }

  @media (min-width: 640px) {
    .groups {
      row-gap: var(--s-4);
    }

    .groups li + li {
      margin-top: 0;
    }
  }

  .groups li {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding-top: var(--s-3);
    border-top: var(--rule);
  }

  .groups h3 {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.4;
  }

  .groups .count {
    margin: 0;
  }

  .groups .names {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    align-self: start;
    gap: 2px var(--s-3);
  }

  .measure {
    max-width: var(--measure);
  }

  .spec-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .num {
    display: inline-block;
    min-width: 2em;
    color: var(--text-2);
  }

  @media (min-width: 640px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .groups li {
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: var(--s-1);
    }
  }

  @media (min-width: 1024px) {
    .groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
