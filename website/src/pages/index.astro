---
import { getEntry, render } from "astro:content";
import Story from "../components/landing/Story.astro";
import { PITCH, PRODUCT_LONG_NAME, PRODUCT_NAME } from "../config/brand";
import Base from "../layouts/Base.astro";
import { driverCounts, driverGroups, statusWord } from "../lib/catalog";
import { HOME_TITLE } from "../lib/pages";
import "../styles/prose.css";

const quickstart = await getEntry("snippets", "quickstart");
const { Content: Quickstart } = await render(quickstart!);
const groups = driverGroups();
const { total, tested } = driverCounts();
const points = [
  { title: "Limits a person confirmed", text: "An agent can't loosen them. Only a person editing the device file can." },
  { title: "One STOP", text: "One command puts every device in its safe state. Only a person can start them again." },
  { title: "Everything logged", text: "Every request, refusal, stop and confirmation goes into an append-only log." },
];
const spelled = [
  { letter: "H", word: "[hardware]" },
  { letter: "A", word: "[agent]" },
  { letter: "L", word: "[layer]" },
].map((item) => ({ ...item, at: PRODUCT_NAME.lastIndexOf(item.letter) }));
const site = JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: PRODUCT_NAME, alternateName: PRODUCT_LONG_NAME, url: new URL("/", Astro.site).href });
const more = [
  { href: "/spec/latest/", title: "Read the specification", text: "Every message, error and rule, in dated versions." },
  { href: "/docs/", title: "Read the docs", text: "Guides for the hub, device files and drivers." },
];
---

<Base title={`${PRODUCT_NAME}. ${HOME_TITLE}`} description={HOME_TITLE} bare>
  <Fragment slot="head">
    <meta name="application-name" content={PRODUCT_NAME} />
    <script type="application/ld+json" set:html={site} />
  </Fragment>
  <section class="home-width hero" aria-labelledby="home-title">
    <div class="hero-name" data-spell>
      <h1 id="home-title" class="hero-mark">{PRODUCT_NAME}</h1>
      <p class="hero-spell" aria-hidden="true">
        {spelled.map((item) => <span data-at={item.at}>{item.word}</span>)}
      </p>
    </div>
    <p class="hero-pitch">{PITCH}</p>
    <a class="button hero-go" href="#try">Get started</a>
  </section>

  <div class="home-width">
    <Story after="safe" />
  </div>

  <section id="safe" class="home-width part after-story" aria-labelledby="safe-title">
    <h2 id="safe-title">Why it's safe</h2>
    <ul class="points">
      {
        points.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-width part" aria-labelledby="works-title">
    <h2 id="works-title">What it works with</h2>
    <p class="summary lede">
      {tested} {tested === 1 ? "driver" : "drivers"} {statusWord("implemented")}
    </p>
    <ul class="families">
      {
        groups.map((group) => (
          <li>
            <h3>{group.name}</h3>
            <p class="mono names">
              {group.drivers.map((driver) => (
                <span>{driver.name}</span>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="onward"><a href="/drivers/">All {total} drivers</a></p>
  </section>

  <section id="try" class="home-width part" aria-labelledby="try-title">
    <h2 id="try-title">Try it</h2>
    <p class="lede">You need uv and git. Nothing touches hardware.</p>
    <div class="prose quickstart">
      <Quickstart />
    </div>
    <p class="onward">It plays the same story in your terminal. <a href="/spec/playground/">Try it in your browser</a></p>
  </section>

  <section class="home-width part" aria-labelledby="more-title">
    <h2 id="more-title">Read more</h2>
    <ul class="more">
      {
        more.map((item) => (
          <li>
            <a href={item.href}>{item.title}</a>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  function place(root: HTMLElement): void {
    const mark = root.querySelector<HTMLElement>(".hero-mark");
    const spell = root.querySelector<HTMLElement>(".hero-spell");
    const text = mark?.firstChild;
    if (!mark || !spell || !text || text.nodeType !== Node.TEXT_NODE) return;
    const style = getComputedStyle(mark);
    const context = document.createElement("canvas").getContext("2d");
    if (!context) return;
    context.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const box = root.getBoundingClientRect();
    const range = document.createRange();
    const spots = Array.from(spell.querySelectorAll<HTMLElement>("[data-at]"), (label) => {
      const at = Number(label.dataset.at);
      range.setStart(text, at);
      range.setEnd(text, at + 1);
      const glyph = range.getBoundingClientRect();
      const metrics = context.measureText(text.textContent!.charAt(at));
      const center = glyph.left + (metrics.actualBoundingBoxRight - metrics.actualBoundingBoxLeft) / 2 - box.left;
      const baseline = glyph.top + metrics.fontBoundingBoxAscent - box.top;
      return { label, center, half: label.getBoundingClientRect().width / 2, baseline };
    });
    for (let pass = 0; pass < spots.length; pass++) {
      for (let index = 1; index < spots.length; index++) {
        const [left, right] = [spots[index - 1], spots[index]];
        const overlap = left.center + left.half + 6 - (right.center - right.half);
        if (overlap > 0) {
          left.center -= overlap / 2;
          right.center += overlap / 2;
        }
      }
    }
    const last = spots[spots.length - 1];
    const over = last ? last.center + last.half - (document.documentElement.clientWidth - box.left - 8) : 0;
    for (const spot of spots) {
      spot.label.style.setProperty("--x", `${(spot.center - Math.max(0, over)).toFixed(1)}px`);
      spot.label.style.setProperty("--y", `${(spot.baseline + parseFloat(style.fontSize) * 0.08).toFixed(1)}px`);
    }
    const boxes = Array.from(spell.children, (label) => label.getBoundingClientRect());
    const apart = boxes.every((item, index) => index === 0 || item.left >= boxes[index - 1].right + 4);
    spell.toggleAttribute("data-placed", apart && boxes.every((item) => item.left >= 0));
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-spell]")) {
    const again = () => place(root);
    again();
    document.fonts?.ready.then(again);
    new ResizeObserver(again).observe(root);
  }
</script>

<style>
  .hero {
    display: grid;
    justify-items: start;
    padding-top: var(--s-7);
    padding-bottom: var(--s-7);
  }

  .hero-mark {
    margin-left: -0.04em;
    font-size: min(21vw, 184px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .hero-name {
    position: relative;
  }

  .hero-spell {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    color: var(--text-2);
    font-size: var(--t-legend);
    line-height: 1;
  }

  .hero-spell[data-placed] {
    visibility: visible;
  }

  .hero-spell span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(calc(var(--x, 0px) - 50%), var(--y, 0px));
    white-space: nowrap;
  }

  .hero-pitch {
    max-width: 22ch;
    margin-top: var(--s-6);
    font-size: var(--t-h2);
    line-height: 1.3;
  }

  .hero-go {
    margin-top: var(--s-6);
    min-height: 48px;
    padding: 0 var(--s-5);
  }

  .part {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-8);
  }

  .part h2 {
    font-size: var(--t-h1);
    line-height: 1.15;
  }

  .part.after-story {
    padding-top: var(--s-6);
  }

  .lede {
    color: var(--text-2);
    font-size: var(--t-h3);
    line-height: 1.4;
  }

  .summary {
    font-size: var(--t-body);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .points {
    display: grid;
  }

  .points li {
    display: grid;
    gap: var(--s-1) var(--s-7);
    padding: var(--s-5) 0;
    border-top: var(--rule);
  }

  .points li:last-child {
    border-bottom: var(--rule);
  }

  .points h3 {
    font-size: var(--t-h3);
  }

  .points p {
    color: var(--text-2);
    max-width: 48ch;
  }

  .families {
    display: grid;
    gap: var(--s-5) var(--s-7);
  }

  .families h3 {
    font-size: var(--t-body);
    line-height: 1.4;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    margin-top: var(--s-1);
    color: var(--text-2);
    font-size: var(--t-small);
  }

  .names span {
    white-space: nowrap;
  }

  .onward a,
  .more a {
    font-weight: 700;
  }

  .quickstart {
    max-width: 720px;
    min-width: 0;
  }

  .quickstart :global(.code-block) {
    margin-top: 0;
  }

  .more {
    display: grid;
    gap: var(--s-5);
  }

  .more li {
    display: grid;
    gap: var(--s-1);
  }

  .more a {
    font-size: var(--t-h3);
  }

  .more p {
    color: var(--text-2);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--s-8);
    }

    .part {
      padding-top: calc(var(--s-8) + var(--s-6));
    }

    .points li {
      grid-template-columns: 16em minmax(0, 1fr);
      align-items: baseline;
    }

    .families {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .families {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
