---
import { getCollection, render } from "astro:content";
import DocShell from "../../layouts/DocShell.astro";
import { docTitle } from "../../lib/docs-nav";
import { routeFor } from "../../lib/markdown/routes.mjs";
import { latestVersion, specPages } from "../../lib/spec";
import { specSidebar } from "../../lib/spec-nav";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .map((entry) => ({ entry, route: routeFor(entry.id) }))
    .filter(({ route }) => route && /^\/spec\/[a-z-]+\/$/.test(route))
    .map(({ entry, route }) => ({ params: { summary: route!.slice("/spec/".length, -1) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const title = String(remarkPluginFrontmatter.title ?? docTitle(entry));
const latest = latestVersion();
const pages = latest ? await specPages(latest) : [];
const sidebar = specSidebar(pages, (item) => (item.slug ? `/spec/latest/${item.slug}/` : "/spec/latest/"));
---

<DocShell title={title} repo={entry.id} headings={headings} sidebar={sidebar} section="Specification">
  <Content />
</DocShell>
