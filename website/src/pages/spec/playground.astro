---
import "../../styles/trace.css";
import Playground from "../../components/playground/Playground.svelte";
import DocShell from "../../layouts/DocShell.astro";
import { parse as parseYaml } from "yaml";
import { loadScenario } from "../../lib/scenario";
import { IDS, storyFacts } from "../../lib/story/facts";
import { latestVersion, specPages } from "../../lib/spec";
import { specSidebar } from "../../lib/spec-nav";

const files = {
  ...import.meta.glob<string>("../../../../examples/**/*.hal.yaml", { query: "?raw", import: "default", eager: true }),
  ...import.meta.glob<string>("../../../../spec/examples/*.hal.yaml", { query: "?raw", import: "default", eager: true }),
};
const examples = Object.entries(files)
  .map(([path, text]) => {
    const name = path.split("/").pop()!.replace(/\.hal\.yaml$/, "");
    return { name, path: path.replace(/^(\.\.\/)+/, ""), text };
  })
  .sort((a, b) => Number(b.text.includes("confirmed:")) - Number(a.text.includes("confirmed:")))
  .filter((item, index, all) => all.findIndex((other) => other.name === item.name) === index)
  .sort((a, b) => a.name.localeCompare(b.name));
const scenario = loadScenario();
const initial = examples.find((item) => scenario.file && item.path.endsWith(`/${scenario.file}`))?.name ?? examples.find((item) => item.name === scenario.device)?.name ?? examples[0].name;
const commands = scenario.record.exchanges.filter((exchange) => exchange.request.method === "hal/write" || exchange.request.method === "hal/action");
const first = (commands.find((exchange) => exchange.error) ?? commands[0])?.request;
const params = (first?.params ?? {}) as Record<string, any>;
const quantityText = (value: any) => (value && typeof value === "object" && "value" in value ? `${value.value} ${value.unit}` : String(value));
const device = parseYaml(examples.find((item) => item.name === initial)?.text ?? "") as { actions?: Record<string, { require?: Array<string | { condition?: string }> } | null> };
const held = commands
  .filter((exchange) => exchange.request.method === "hal/action" && exchange.result?.status === "done")
  .flatMap((exchange) => device.actions?.[String(exchange.request.params.action)]?.require ?? [])
  .map((item) => (typeof item === "string" ? item : item.condition ?? "").match(/^\s*(\w+)\s*==\s*(\w+)\s*$/))
  .flatMap((match) => (match ? [[match[1], match[2]]] : []));
const before = commands.flatMap((exchange) => {
  const channel = exchange.request.params.channel;
  const change = typeof channel === "string" ? (exchange as Record<string, any>)[channel] : null;
  return change?.before ? [[channel, change.before.value]] : [];
});
const suggestion = first
  ? {
      device: String(params.device),
      target: String(first.method === "hal/action" ? params.action : params.channel),
      text:
        first.method === "hal/action"
          ? Object.entries(params.args ?? {}).map(([name, value]) => `${name}=${quantityText(value)}`).join(" ")
          : params.unit ? `${params.value} ${params.unit}` : String(params.value),
      readings: Object.fromEntries([...before, ...held]),
    }
  : null;
const facts = storyFacts(scenario);
const command = (id: string) => {
  const params = scenario.record.exchanges.find((exchange) => exchange.id === id)!.request.params as Record<string, any>;
  return params.action
    ? { kind: "action" as const, device: String(params.device), action: String(params.action), args: params.args ?? {} }
    : { kind: "write" as const, device: String(params.device), channel: String(params.channel), value: params.value, unit: params.unit ?? null };
};
const quick = [
  { label: `Warm the bed to ${facts.bed.value}`, command: command(IDS.bed) },
  { label: `Set the nozzle to ${facts.nozzle.value}`, command: command(IDS.nozzle) },
  { label: "Pause the print", command: command(IDS.pause) },
  { label: "Cancel the print", command: command(IDS.cancel) },
];
const latest = latestVersion();
const sidebar = specSidebar(latest ? await specPages(latest) : []);
---

<DocShell
  title="Playground"
  description="Send the print babysitter's requests to a simulated printer in your browser and see the hub's response to each request."
  sidebar={sidebar}
  section="Specification"
  wide
  pager={false}
>
  <p slot="after-title" class="lede">Press a request from the story to see the hub's response.</p>
  <Playground client:interact examples={examples} initial={initial} suggestion={suggestion} quick={quick} watch={Object.keys(suggestion?.readings ?? {})} />
</DocShell>

<style>
  .lede {
    max-width: var(--measure);
    margin-top: var(--s-3);
  }
</style>
