---
import "../../styles/trace.css";
import Playground from "../../components/playground/Playground.svelte";
import Base from "../../layouts/Base.astro";

const files = import.meta.glob<string>("../../../../spec/examples/*.hal.yaml", { query: "?raw", import: "default", eager: true });
const examples = Object.entries(files)
  .map(([path, text]) => {
    const name = path.split("/").pop()!.replace(/\.hal\.yaml$/, "");
    return { name, path: `spec/examples/${name}.hal.yaml`, text };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base title="Playground" description="Edit an OpenHAL device file, validate it as you type, and see the hub's JSON-RPC answer to each request. Runs in your browser.">
  <div class="wrap page">
    <header class="head">
      <p class="legend"><a href="/spec/latest/">Specification</a></p>
      <h1>Playground</h1>
      <p class="lede">Edit a device file, then send requests to a simulated hub. Each answer is the JSON-RPC message the hub sends.</p>
      <p class="note"><span class="status unverified">in-browser demo</span> <span class="muted">A TypeScript port of the safety kernel. It never talks to hardware.</span></p>
    </header>
    <Playground client:idle examples={examples} initial="desk-fan-confirmed" />
  </div>
</Base>

<style>
  .page {
    padding-top: var(--s-6);
  }

  .head {
    display: grid;
    gap: var(--s-2);
    padding-bottom: var(--s-4);
    margin-bottom: var(--s-5);
    border-bottom: var(--rule);
  }

  .lede {
    max-width: var(--measure);
  }

  .note {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    align-items: center;
  }
</style>
