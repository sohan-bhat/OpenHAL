---
import Redirect from "../../components/Redirect.astro";
import DocShell from "../../layouts/DocShell.astro";
import { latestVersion, latestSpecHref } from "../../lib/spec";
import { specSidebar } from "../../lib/spec-nav";
---

{
  latestVersion() ? (
    <Redirect to={latestSpecHref()} title="Specification" />
  ) : (
    <DocShell title="Specification" sidebar={specSidebar([])}>
      <p>No version of the specification is published yet.</p>
    </DocShell>
  )
}
