---
// A page per spec version. The current version is spec/SPEC.md. When a later version ships, the
// old text is kept in spec/versions/<version>/SPEC.md and rendered here instead.
import SpecPage from "../../../components/SpecPage.astro";
import { specVersions } from "../../../lib/spec-versions";

export function getStaticPaths() {
  return specVersions().map((item) => ({ params: { version: item.version }, props: { current: item.current } }));
}

const { version } = Astro.params;
const { current } = Astro.props;
const repo = current ? "spec/SPEC.md" : `spec/versions/${version}/SPEC.md`;
---

<SpecPage repo={repo} version={version} />
