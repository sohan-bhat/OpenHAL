---
import DocShell from "../../layouts/DocShell.astro";
import { STATUS_ORDER, TIER_NAMES, conformanceOf, deviceDrivers, driverCounts, referenceDrivers, statusClass, statusWord } from "../../lib/catalog";
import { driversSidebar } from "../../lib/drivers-nav";

const all = deviceDrivers();
const references = referenceDrivers();
const groups = [
  { name: "Verified on hardware", rows: all.filter((driver) => driver.status === "verified"), reference: false },
  { name: "Tested on simulator", rows: all.filter((driver) => driver.status !== "planned" && driver.status !== "verified"), reference: false },
  { name: "Planned", rows: all.filter((driver) => driver.status === "planned"), reference: false },
  { name: "Reference driver", rows: references, reference: true },
].filter((group) => group.rows.length > 0);
const headed = groups.filter((group) => !group.reference).length > 1;
const { total } = driverCounts();
const listed = [...all, ...references];
const statuses = STATUS_ORDER.filter((status) => all.some((driver) => driver.status === status));
const tiers = [...new Set(all.map((driver) => driver.tier))].sort();
const hazards = ["low", "medium", "high"].filter((hazard) => listed.some((driver) => driver.hazard_default === hazard));
const conformances = [...new Set(listed.map(conformanceOf).filter((value): value is string => !!value))];
---

<DocShell
  title="Drivers"
  description="Every OpenHAL driver from drivers/catalog.json, with tier, status, conformance level and hazard default."
  sidebar={driversSidebar()}
  wide
  pager={false}
>
  <p slot="after-title" class="lede">Each driver implements one protocol, and every status on this page comes from <code>drivers/catalog.json</code>.</p>

    <form class="filters" role="search" aria-label="Filter drivers" data-filters>
      <label class="field grow">
        <span class="legend">Filter</span>
        <input type="search" name="q" placeholder="Name, protocol or device family" autocomplete="off" />
      </label>
      {
        tiers.length > 1 && (
          <label class="field">
            <span class="legend">Tier</span>
            <select name="tier">
              <option value="">Any</option>
              {tiers.map((tier) => <option value={String(tier)}>{TIER_NAMES[tier] ?? `Tier ${tier}`}</option>)}
            </select>
          </label>
        )
      }
      {
        statuses.length > 1 && (
          <label class="field">
            <span class="legend">Status</span>
            <select name="status">
              <option value="">Any</option>
              {statuses.map((status) => <option value={status}>{statusWord(status)}</option>)}
            </select>
          </label>
        )
      }
      {
        conformances.length > 1 && (
          <label class="field">
            <span class="legend">Conformance</span>
            <select name="conformance">
              <option value="">Any</option>
              {conformances.map((level) => (
                <option value={level}>{level}</option>
              ))}
            </select>
          </label>
        )
      }
      {
        hazards.length > 1 && (
          <label class="field">
            <span class="legend">Hazard</span>
            <select name="hazard">
              <option value="">Any</option>
              {hazards.map((hazard) => <option value={hazard}>{hazard}</option>)}
            </select>
          </label>
        )
      }
    </form>
    <p class="shown muted" aria-live="polite" data-shown>{total} drivers.</p>

    <div class="driver-list"><div class="table-wrap">
      <table class="drivers" aria-label="Drivers">
        <thead>
          <tr>
            <th scope="col">Driver</th>
            <th scope="col">Status</th>
            <th scope="col">Tier</th>
            {conformances.length > 0 && <th scope="col">Conformance</th>}
            <th scope="col">Protocol</th>
            <th scope="col">Covers</th>
            <th scope="col">Hazard</th>
          </tr>
        </thead>
        {
          groups.map((group) => (
            <tbody data-group>
              {headed && (
                <tr class="group-row">
                  <th scope="colgroup" colspan={conformances.length > 0 ? 7 : 6}>
                    {group.name}
                  </th>
                </tr>
              )}
              {group.rows.map((driver) => (
                <tr
                  data-driver={group.reference ? undefined : ""}
                  data-reference={group.reference ? "" : undefined}
                  data-tier={String(driver.tier)}
                  data-status={driver.status}
                  data-hazard={driver.hazard_default}
                  data-conformance={conformanceOf(driver) ?? ""}
                  data-text={[driver.name, ...driver.protocols, ...driver.families].join(" ").toLowerCase()}
                >
                  <td data-label="Driver">
                    <a class="mono" href={`/drivers/${driver.name}/`}>{driver.name}</a>
                  </td>
                  <td data-label="Status">
                    {group.reference ? <span class="muted">reference</span> : <span class={`status ${statusClass(driver.status)}`}>{statusWord(driver.status)}</span>}
                  </td>
                  <td data-label="Tier">{TIER_NAMES[driver.tier] ?? driver.tier}</td>
                  {conformances.length > 0 && (
                    <td data-label="Conformance">
                      {conformanceOf(driver) ?? ""}
                      {driver.status === "planned" && conformanceOf(driver) && <span class="muted"> target</span>}
                    </td>
                  )}
                  <td data-label="Protocol">{driver.protocols.join(", ")}</td>
                  <td data-label="Covers">{driver.families.join(", ")}</td>
                  <td data-label="Hazard" class="mono">{driver.hazard_default}</td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div></div>
    <p class="empty muted" data-empty hidden>No driver matches these filters, so clear a filter to see more drivers.</p>
    {
      references.length > 0 && (
        <p class="more">
          {references.map((driver, index) => (
            <>
              {index > 0 && ", "}
              <a class="mono" href={`/drivers/${driver.name}/`}>{driver.name}</a>
            </>
          ))}{" "}
          {references.length === 1 ? "is the reference driver" : "are the reference drivers"}. A reference driver runs device files in memory for
          tests and demos and is left out of the driver counts.
        </p>
      )
    }
    <p class="more">The <a href="/library/">Device Library</a> holds device files that run on these drivers.</p>
</DocShell>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-driver]")];
  const references = [...document.querySelectorAll<HTMLElement>("[data-reference]")];
  const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
  const shown = document.querySelector<HTMLElement>("[data-shown]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  function apply() {
    if (!form) return;
    const data = new FormData(form);
    const words = String(data.get("q") ?? "").toLowerCase().split(/\s+/).filter(Boolean);
    const matches = (item: HTMLElement) =>
      words.every((word) => (item.dataset.text ?? "").includes(word)) &&
      (!data.get("tier") || item.dataset.tier === data.get("tier")) &&
      (!data.get("status") || (item.dataset.driver !== undefined && item.dataset.status === data.get("status"))) &&
      (!data.get("conformance") || item.dataset.conformance === data.get("conformance")) &&
      (!data.get("hazard") || item.dataset.hazard === data.get("hazard"));
    let count = 0;
    for (const item of items) {
      item.hidden = !matches(item);
      if (!item.hidden) count += 1;
    }
    for (const item of references) item.hidden = !matches(item);
    for (const group of groups) group.hidden = !group.querySelector("[data-driver]:not([hidden]), [data-reference]:not([hidden])");
    if (shown) shown.textContent = `${count} of ${items.length} drivers.`;
    if (empty) empty.hidden = count > 0 || references.some((item) => !item.hidden);
  }
  form?.addEventListener("input", apply);
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>

<style>
  .lede {
    margin-top: var(--s-3);
    max-width: var(--measure);
  }

  .lede code {
    font-size: 0.9em;
  }

  .filters {
    display: grid;
    gap: var(--s-3);
  }

  .field {
    display: grid;
    gap: var(--s-1);
  }

  .field input,
  .field select {
    width: 100%;
  }

  .shown {
    margin: var(--s-4) 0 var(--s-3);
  }

  .group-row th {
    padding-top: var(--s-5);
    color: var(--text-2);
    border-bottom: var(--rule);
  }

  td:first-child {
    white-space: nowrap;
  }

  @container (min-width: 940px) {
    .drivers th,
    .drivers td {
      padding-right: var(--s-5);
    }

    .drivers th:last-child,
    .drivers td:last-child {
      padding-right: 0;
    }
  }

  .more {
    margin-top: var(--s-5);
  }

  .driver-list {
    container-type: inline-size;
  }

  @media (min-width: 768px) {
    .filters {
      grid-template-columns: 2fr repeat(4, minmax(0, 1fr));
    }
  }

  @container (max-width: 939px) {
    table,
    tbody,
    tr {
      display: block;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .group-row th {
      display: block;
    }

    tr[data-driver],
    tr[data-reference] {
      padding: var(--s-3) 0;
      border-bottom: var(--rule);
    }

    td {
      display: grid;
      grid-template-columns: 7.5em minmax(0, 1fr);
      gap: var(--s-2);
      border: 0;
      padding: 2px 0;
    }

    td::before {
      content: attr(data-label);
      font-family: var(--font-text);
      font-size: var(--t-small);
      font-weight: 700;
      color: var(--text-2);
    }

    td > :global(*) {
      min-width: 0;
    }
  }
</style>
