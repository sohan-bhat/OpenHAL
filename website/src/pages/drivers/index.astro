---
import CatalogFilters, { type FilterSelect } from "../../components/islands/CatalogFilters";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "../../components/ui/table";
import DocShell from "../../layouts/DocShell.astro";
import { STATUS_ORDER, TIER_NAMES, conformanceOf, deviceDrivers, driverCounts, referenceDrivers, statusClass, statusWord } from "../../lib/catalog";
import { SEARCH } from "../../lib/catalog-filter";
import { driversSidebar } from "../../lib/drivers-nav";

const all = deviceDrivers();
const references = referenceDrivers();
const groups = [
  { name: "Verified on hardware", rows: all.filter((driver) => driver.status === "verified"), reference: false },
  { name: "Tested on simulator", rows: all.filter((driver) => driver.status !== "planned" && driver.status !== "verified"), reference: false },
  { name: "Planned", rows: all.filter((driver) => driver.status === "planned"), reference: false },
  { name: "Reference driver", rows: references, reference: true },
].filter((group) => group.rows.length > 0);
const headed = groups.filter((group) => !group.reference).length > 1;
const { total } = driverCounts();
const listed = [...all, ...references];
const statuses = STATUS_ORDER.filter((status) => all.some((driver) => driver.status === status));
const tiers = [...new Set(all.map((driver) => driver.tier))].sort();
const hazards = ["low", "medium", "high"].filter((hazard) => listed.some((driver) => driver.hazard_default === hazard));
const conformances = [...new Set(listed.map(conformanceOf).filter((value): value is string => !!value))];
const columns = conformances.length > 0 ? 7 : 6;
const selects: FilterSelect[] = [
  { name: "tier", label: "Tier", options: tiers.map((tier) => ({ value: String(tier), label: TIER_NAMES[tier] ?? `Tier ${tier}` })) },
  { name: "status", label: "Status", options: statuses.map((status) => ({ value: status, label: statusWord(status) })) },
  { name: "conformance", label: "Conformance", options: conformances.map((level) => ({ value: level, label: level })) },
  { name: "hazard", label: "Hazard", options: hazards.map((hazard) => ({ value: hazard, label: hazard })) },
].filter((select) => select.options.length > 1);
const fields = [SEARCH, ...selects.map((select) => select.name)].join(" ");
---

<DocShell
  title="Drivers"
  description="Every OpenHAL driver from drivers/catalog.json, with tier, status, conformance level and hazard default."
  sidebar={driversSidebar()}
  wide
  pager={false}
>
  <p slot="after-title" class="lede">Each driver implements one protocol, and every status on this page comes from <code>drivers/catalog.json</code>.</p>

    <CatalogFilters client:query={fields} label="Filter drivers" placeholder="Name, protocol or device family" selects={selects} />
    <p class="shown muted" aria-live="polite" data-shown data-noun="drivers" data-fields={fields}>{total} drivers.</p>

    <div class="driver-list">
      <Table className="drivers" aria-label="Drivers">
        <TableHeader>
          <TableRow>
            <TableHead scope="col">Driver</TableHead>
            <TableHead scope="col">Status</TableHead>
            <TableHead scope="col">Tier</TableHead>
            {conformances.length > 0 && <TableHead scope="col">Conformance</TableHead>}
            <TableHead scope="col">Protocol</TableHead>
            <TableHead scope="col">Covers</TableHead>
            <TableHead scope="col">Hazard</TableHead>
          </TableRow>
        </TableHeader>
        {
          groups.map((group) => (
            <TableBody data-filter-group="">
              {headed && (
                <TableRow className="group-row">
                  <TableHead scope="colgroup" colSpan={columns} className="pt-6 border-border">
                    {group.name}
                  </TableHead>
                </TableRow>
              )}
              {group.rows.map((driver) => (
                <TableRow
                  data-filter-row=""
                  data-driver={group.reference ? undefined : ""}
                  data-reference={group.reference ? "" : undefined}
                  data-tier={String(driver.tier)}
                  data-status={group.reference ? undefined : driver.status}
                  data-hazard={driver.hazard_default}
                  data-conformance={conformanceOf(driver) ?? ""}
                  data-text={[driver.name, ...driver.protocols, ...driver.families].join(" ").toLowerCase()}
                >
                  <TableCell data-label="Driver" className="whitespace-nowrap">
                    <a class="mono" href={`/drivers/${driver.name}/`}>{driver.name}</a>
                  </TableCell>
                  <TableCell data-label="Status">
                    {group.reference ? <span class="muted">reference</span> : <span class={`status ${statusClass(driver.status)}`}>{statusWord(driver.status)}</span>}
                  </TableCell>
                  <TableCell data-label="Tier">{TIER_NAMES[driver.tier] ?? driver.tier}</TableCell>
                  {conformances.length > 0 && (
                    <TableCell data-label="Conformance">
                      {conformanceOf(driver) ?? ""}
                      {driver.status === "planned" && conformanceOf(driver) && <span class="muted"> target</span>}
                    </TableCell>
                  )}
                  <TableCell data-label="Protocol">{driver.protocols.join(", ")}</TableCell>
                  <TableCell data-label="Covers">{driver.families.join(", ")}</TableCell>
                  <TableCell data-label="Hazard" className="mono">
                    {driver.hazard_default}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          ))
        }
      </Table>
    </div>
    <p class="empty muted" data-empty hidden>No driver matches these filters, so clear a filter to see more drivers.</p>
    {
      references.length > 0 && (
        <p class="more">
          {references.map((driver, index) => (
            <>
              {index > 0 && ", "}
              <a class="mono" href={`/drivers/${driver.name}/`}>{driver.name}</a>
            </>
          ))}{" "}
          {references.length === 1 ? "is the reference driver" : "are the reference drivers"}. A reference driver runs device files in memory for
          tests and demos and is left out of the driver counts.
        </p>
      )
    }
    <p class="more">The <a href="/library/">Device Library</a> holds device files that run on these drivers.</p>
</DocShell>

<script>
  import { restoreFromAddress } from "../../lib/catalog-filter";

  restoreFromAddress();
</script>

<style>
  .lede {
    margin-top: var(--s-3);
    max-width: var(--measure);
  }

  .lede code {
    font-size: 0.9em;
  }

  .shown {
    margin: var(--s-4) 0 var(--s-3);
  }

  .more {
    margin-top: var(--s-5);
  }

  .driver-list {
    container-type: inline-size;
  }

  .driver-list :global(.group-row th) {
    color: var(--text-2);
  }

  @container (min-width: 940px) {
    .driver-list :global(:is(th, td)) {
      padding-right: var(--s-5);
    }

    .driver-list :global(:is(th, td):last-child) {
      padding-right: 0;
    }
  }

  @container (max-width: 939px) {
    .driver-list :global(:is(table, tbody, tr)) {
      display: block;
    }

    .driver-list :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .driver-list :global(.group-row th) {
      display: block;
    }

    .driver-list :global(tr[data-filter-row]) {
      padding: var(--s-3) 0;
      border-bottom: var(--rule);
    }

    .driver-list :global(td) {
      display: grid;
      grid-template-columns: 7.5em minmax(0, 1fr);
      gap: var(--s-2);
      border: 0;
      padding: 2px 0;
    }

    .driver-list :global(td::before) {
      content: attr(data-label);
      font-family: var(--font-text);
      font-size: var(--t-small);
      font-weight: 700;
      color: var(--text-2);
    }

    .driver-list :global(td > *) {
      min-width: 0;
    }
  }
</style>
