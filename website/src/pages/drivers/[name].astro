---
import { getCollection, render } from "astro:content";
import { Table, TableBody, TableCell, TableHead, TableRow } from "../../components/ui/table";
import DocShell from "../../layouts/DocShell.astro";
import { type Driver, TIER_NAMES, conformanceOf, drivers, isReference, statusClass, statusWord } from "../../lib/catalog";
import { DEFAULT_BRANCH, REPOSITORY_URL } from "../../config/site";
import { driversSidebar } from "../../lib/drivers-nav";

export async function getStaticPaths() {
  const docs = await getCollection("repo");
  return drivers().map((driver) => ({
    params: { name: driver.name },
    props: { driver, entry: docs.find((entry) => entry.id === `docs/drivers/${driver.name}.md`) ?? null },
  }));
}

const { driver, entry } = Astro.props as { driver: Driver; entry: Awaited<ReturnType<typeof getCollection<"repo">>>[number] | null };
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const listed = (items: string[]) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}` : items.join(""));
const newDocUrl = `${REPOSITORY_URL}/new/${DEFAULT_BRANCH}/docs/drivers?filename=${driver.name}.md`;
const rows: Array<[string, string]> = [
  ["Tier", TIER_NAMES[driver.tier] ?? String(driver.tier)],
  ["Protocol", driver.protocols.join(", ")],
  ["Covers", driver.families.join(", ")],
  ["Hazard default", driver.hazard_default],
  ...(conformanceOf(driver) ? ([["Conformance", conformanceOf(driver)!]] as Array<[string, string]>) : []),
  ...(driver.tests ? ([["Tested with", driver.tests]] as Array<[string, string]>) : []),
];
---

<DocShell
  title={driver.name}
  description={`The ${driver.name} driver uses ${listed(driver.protocols)}.`}
  repo={entry ? entry.id : undefined}
  headings={rendered?.headings ?? []}
  sidebar={driversSidebar()}
>
  <p slot="after-title" class="statuses">
    {
      isReference(driver) ? (
        <span class="muted">The reference driver runs device files in memory and is left out of the driver counts.</span>
      ) : (
        <span class={`status ${statusClass(driver.status)}`}>{statusWord(driver.status)}</span>
      )
    }
  </p>
  <Table containerClassName="table-wrap" className="sheet">
      <TableBody>
        {
          rows.map(([label, value]) => (
            <TableRow>
              <TableHead scope="row">{label}</TableHead>
              <TableCell>{value}</TableCell>
            </TableRow>
          ))
        }
      </TableBody>
    </Table>
  {
    driver.estimate && (
      <p class="muted">
        <strong>Estimated reach.</strong> {sentence(driver.estimate.devices)}. {driver.estimate.reasoning}
      </p>
    )
  }
  {
    Content ? (
      <Content />
    ) : (
      <p class="muted">
        This driver has no documentation page yet. <a href={newDocUrl} rel="noopener">Add <code>docs/drivers/{driver.name}.md</code></a> as the{" "}
        <a href="/docs/writing-a-driver/#docs-page">driver contract</a> describes.
      </p>
    )
  }
</DocShell>

<style>
  .statuses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-3);
  }

  @media (min-width: 600px) {
    :global(.table-wrap > .sheet th) {
      width: 11em;
      vertical-align: top;
      border-bottom: var(--rule);
    }
  }
</style>
