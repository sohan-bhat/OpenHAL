---
import { existsSync } from "node:fs";
import { join } from "node:path";
import captures from "../data/inspector-captures.json";
import DocShell from "../layouts/DocShell.astro";
import { inspectorShots } from "../lib/inspector-shots";

const SHOTS = inspectorShots();
const present = (name: string) => existsSync(join(process.cwd(), "public", "captures", `${name}.webp`));
const shots = SHOTS.filter((item) => present(`${item.file}-light`) && present(`${item.file}-dark`));
const sidebar = [
  {
    name: "",
    items: [
      { title: "Inspector", href: "/inspector/" },
      { title: "Safety model", href: "/docs/safety/" },
      { title: "Command line", href: "/docs/cli/" },
    ],
  },
];
const frameStyle = (crop: { x: number; y: number; w: number; h: number }) =>
  `--x: ${crop.x}; --y: ${crop.y}; --w: ${crop.w}; --h: ${crop.h}; --full-w: ${captures.width}; --full-h: ${captures.height}`;
---

<DocShell title="Inspector" description="The OpenHAL Inspector shows every device and every message, and stops every device in one click." sidebar={sidebar} section="Inspector" wide>
  <div class="prose">
    <p>The Inspector is the hub's dashboard. Every device and every JSON-RPC message shows there, and one click stops every device.</p>

    <h2 id="open"><a class="heading-link" href="#open">Open the Inspector</a></h2>
    <p>The hub serves the Inspector at <code>http://127.0.0.1:7420/</code>. Pair a browser with the one-time code that <code>openhal pair</code> prints.</p>

    <h2 id="views"><a class="heading-link" href="#views">Views</a></h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">View</th><th scope="col">Shows</th></tr>
        </thead>
        <tbody>
          <tr><td data-label="View">Devices</td><td data-label="Shows">Every device with its connection, conformance level and verification, and the selected device's channels, limits and actions</td></tr>
          <tr><td data-label="View">Message log</td><td data-label="Shows">Every request, response, notification and error, as formatted JSON-RPC</td></tr>
          <tr><td data-label="View">Confirmations</td><td data-label="Shows">Commands waiting for a person's approval or rejection</td></tr>
          <tr><td data-label="View">Audit log</td><td data-label="Shows">Every decision, in a hash chain</td></tr>
          <tr><td data-label="View">Routines</td><td data-label="Shows">Each routine with its source and its dry run</td></tr>
          <tr><td data-label="View">Driver writer</td><td data-label="Shows">A draft device file for an unknown device, and the limits interview</td></tr>
          <tr><td data-label="View">Settings</td><td data-label="Shows">Client tokens</td></tr>
          <tr><td data-label="View">Stop</td><td data-label="Shows">Always visible. Any client may send a stop, and lifting the stop takes a person's token</td></tr>
        </tbody>
      </table>
    </div>

    {
      shots.length > 0 && (
        <>
          <h2 id="screenshots"><a class="heading-link" href="#screenshots">Screenshots</a></h2>
          <p class="muted">Each screenshot comes from the Inspector on a hub with the simulated printer and its webcam, and shows the part its caption names at full size.</p>
        </>
      )
    }
  </div>
  {
    shots.map((item) => (
      <figure class="shot">
        <div class="shot-scroll" data-shot-scroll data-label={item.caption}>
          <div class="shot-frame" style={frameStyle(item.crop)}>
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset={`/captures/${item.file}-dark.webp`} type="image/webp" />
              <img src={`/captures/${item.file}-light.webp`} width={captures.width} height={captures.height} alt={item.alt} loading="lazy" decoding="async" />
            </picture>
          </div>
        </div>
        <figcaption>
          <span>{item.caption}</span>
          <a class="full full-light" href={`/captures/${item.file}-light.webp`}>Open the whole screen</a>
          <a class="full full-dark" href={`/captures/${item.file}-dark.webp`}>Open the whole screen</a>
        </figcaption>
      </figure>
    ))
  }
</DocShell>

<script>
  const frames = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const scroll = entry.target as HTMLElement;
      if (scroll.scrollWidth > scroll.clientWidth + 1) {
        scroll.tabIndex = 0;
        scroll.setAttribute("role", "region");
        scroll.setAttribute("aria-label", `${scroll.dataset.label ?? "Screenshot"}, scrolls sideways`);
      } else {
        scroll.removeAttribute("tabindex");
        scroll.removeAttribute("role");
        scroll.removeAttribute("aria-label");
      }
    }
  });
  for (const scroll of document.querySelectorAll<HTMLElement>("[data-shot-scroll]")) frames.observe(scroll);
</script>

<style>
  .shot {
    margin: var(--s-5) 0 0;
    display: grid;
    gap: var(--s-2);
  }

  .shot-scroll {
    container-type: inline-size;
    overflow-x: auto;
  }

  .shot-frame {
    position: relative;
    overflow: hidden;
    width: clamp(calc(var(--w) * 0.85px), 100cqw, calc(var(--w) * 1px));
    aspect-ratio: var(--w) / var(--h);
    border: var(--rule);
    border-radius: var(--radius);
  }

  .shot-frame img {
    position: absolute;
    max-width: none;
    width: calc(var(--full-w) / var(--w) * 100%);
    height: auto;
    left: calc(var(--x) / var(--w) * -100%);
    top: calc(var(--y) / var(--h) * -100%);
  }

  .shot figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .full-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .full-light {
      display: none;
    }

    .full-dark {
      display: inline;
    }
  }
</style>
