---
import InspectorShots from "../components/InspectorShots.astro";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "../components/ui/table";
import DocShell from "../layouts/DocShell.astro";
import { presentShots } from "../lib/inspector-crops";
import { inspectorShots } from "../lib/inspector-shots";

const shots = presentShots(inspectorShots());
const sidebar = [
  {
    name: "",
    items: [
      { title: "Inspector", href: "/inspector/" },
      { title: "Safety model", href: "/docs/safety/" },
      { title: "Command line", href: "/docs/cli/" },
    ],
  },
];
---

<DocShell title="Inspector" description="The OpenHAL Inspector shows every device and every message, and stops every device in one click." sidebar={sidebar} wide>
  <div class="prose">
    <p>The Inspector is the hub's dashboard for every device and JSON-RPC message, with a one-click stop.</p>

    <h2 id="open"><a class="heading-link" href="#open">Open the Inspector</a></h2>
    <p>Open <code>http://127.0.0.1:7420/</code> and pair the browser with the one-time code from <code>openhal pair</code>.</p>

    <h2 id="views"><a class="heading-link" href="#views">Views</a></h2>
    <Table containerClassName="table-wrap">
      <TableHeader>
        <TableRow><TableHead scope="col">View</TableHead><TableHead scope="col">Shows</TableHead></TableRow>
      </TableHeader>
      <TableBody>
        <TableRow><TableCell data-label="View">Devices</TableCell><TableCell data-label="Shows">Each device's connection, conformance level, verification, channels, limits and actions</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Message log</TableCell><TableCell data-label="Shows">Every request, response, notification and error, as formatted JSON-RPC</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Confirmations</TableCell><TableCell data-label="Shows">Commands held for a person to approve or reject</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Audit log</TableCell><TableCell data-label="Shows">Every decision, in a hash chain</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Routines</TableCell><TableCell data-label="Shows">Each routine's source and dry run</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Driver writer</TableCell><TableCell data-label="Shows">A draft device file for an unknown device, and the limits interview</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Settings</TableCell><TableCell data-label="Shows">Client tokens</TableCell></TableRow>
        <TableRow><TableCell data-label="View">Stop</TableCell><TableCell data-label="Shows">The always visible stop. Any client may stop, and lifting the stop takes a person's token</TableCell></TableRow>
      </TableBody>
    </Table>

    {
      shots.length > 0 && (
        <>
          <h2 id="screenshots"><a class="heading-link" href="#screenshots">Screenshots</a></h2>
          <p class="muted">From a hub with the simulated printer and webcam.</p>
        </>
      )
    }
  </div>
  <InspectorShots shots={shots} />
</DocShell>
