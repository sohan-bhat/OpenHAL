---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { showDrafts } from "../../lib/drafts";
import "../../styles/prose.css";
import "../../styles/trace.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.filter((post) => !post.data.draft || showDrafts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const day = post.data.date.toISOString().slice(0, 10);
---

<Base title={post.data.title} description={post.data.description} type="article" noindex={post.data.draft}>
  <article class="wrap page">
    <header class="head">
      <h1>{post.data.title}</h1>
      <p class="byline">
        <time class="mono" datetime={day}>{day}</time>
        <span>{post.data.author}</span>
        {post.data.draft && <span class="status planned">draft, not published</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 880px;
    padding-top: var(--s-6);
  }

  .head {
    margin: var(--s-2) 0 var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: var(--rule);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-3);
    color: var(--text-2);
  }
</style>
