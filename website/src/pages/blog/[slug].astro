---
import { getCollection, render } from "astro:content";
import DocShell from "../../layouts/DocShell.astro";
import { showDrafts } from "../../lib/drafts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.filter((post) => !post.data.draft || showDrafts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const day = post.data.date.toISOString().slice(0, 10);
---

<DocShell title={post.data.title} description={post.data.description} type="article" noindex={post.data.draft} pager={false}>
  <article class="post">
    <header class="head">
      <p class="byline">
        <time class="mono" datetime={day}>{day}</time>
        <span>{post.data.author}</span>
        {post.data.draft && <span class="status planned">draft, not published</span>}
      </p>
    </header>
    <Content />
  </article>
</DocShell>

<style>
  .head {
    max-width: var(--measure);
    margin: 0 0 var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: var(--rule);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-3);
    color: var(--text-2);
  }
</style>
