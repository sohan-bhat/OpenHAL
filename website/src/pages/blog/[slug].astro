---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { showDrafts } from "../../lib/drafts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.filter((post) => !post.data.draft || showDrafts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const day = post.data.date.toISOString().slice(0, 10);
---

<Base title={post.data.title} description={post.data.description} type="article" noindex={post.data.draft}>
  <article class="wrap page">
    <p class="crumb"><a href="/blog/">Blog</a></p>
    <header class="head">
      <h1 class="page-title">{post.data.title}</h1>
      <p class="byline mono">
        <time datetime={day}>{day}</time>
        <span>{post.data.author}</span>
        {post.data.draft && <span class="lamp warning">Draft, not published</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: var(--s-6);
  }

  .crumb {
    font-size: var(--t-2);
  }

  .head {
    margin: var(--s-3) 0 var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--ink);
    max-width: 74ch;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-3);
    font-size: var(--t-0);
    color: var(--ink-2);
  }
</style>
