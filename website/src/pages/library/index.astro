---
import CatalogFilters from "../../components/islands/CatalogFilters";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "../../components/ui/table";
import VerificationBadge from "../../components/VerificationBadge.astro";
import DocShell from "../../layouts/DocShell.astro";
import { SEARCH } from "../../lib/catalog-filter";
import { libraryEntries } from "../../lib/library";
import { librarySidebar } from "../../lib/library-nav";

const entries = libraryEntries();
const channels = (entry: { reads: number; writes: number; actions: number }) =>
  [
    entry.reads ? `${entry.reads} read` : "",
    entry.writes ? `${entry.writes} control` : "",
    entry.actions ? `${entry.actions} ${entry.actions === 1 ? "action" : "actions"}` : "",
  ]
    .filter(Boolean)
    .join(", ") || "none";
---

<DocShell
  title="Device Library"
  description="Shared OpenHAL device files, one per device model, each with its verification status."
  sidebar={librarySidebar()}
  wide
  pager={false}
>
  <div slot="after-title" class="ledes">
    <p>The Device Library holds device files for specific models, shared under CC0, and a hub that finds a known device starts from that device's file here.</p>
    <p>A library file loads read-only until a person confirms its limits. <a href="/docs/library/">How the library works</a></p>
  </div>

    {
      entries.length > 0 ? (
        <>
          <CatalogFilters client:query={SEARCH} label="Filter device files" placeholder="Model, manufacturer or driver" />
          <p class="shown muted" aria-live="polite" data-shown data-noun="device files" data-fields={SEARCH}>
            {entries.length} device files.
          </p>
          <Table containerClassName="table-wrap stack">
            <TableHeader>
              <TableRow>
                <TableHead scope="col">Device</TableHead>
                <TableHead scope="col">Driver</TableHead>
                <TableHead scope="col">Hazard</TableHead>
                <TableHead scope="col">Channels</TableHead>
                <TableHead scope="col">Verification</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {entries.map((entry) => (
                <TableRow data-filter-row="" data-entry="" data-text={[entry.title, entry.manufacturer ?? "", entry.driver, entry.deviceId].join(" ").toLowerCase()}>
                  <TableCell data-label="Device">
                    <a href={`/library/${entry.slug}/`}>{entry.title}</a>
                  </TableCell>
                  <TableCell data-label="Driver" className="mono">
                    {entry.driver}
                  </TableCell>
                  <TableCell data-label="Hazard" className="mono">
                    {entry.hazard}
                  </TableCell>
                  <TableCell data-label="Channels">{channels(entry)}</TableCell>
                  <TableCell data-label="Verification">
                    {entry.problems.length > 0 ? <span class="status blocked">invalid</span> : <VerificationBadge status={entry.verification} />}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
          <p class="empty muted" data-empty hidden>No device file matches the search, so clear the search to see every file.</p>
        </>
      ) : (
        <p class="empty">
          No device files are in the library yet. <a href="/docs/tutorials/add-a-device/">Add a device</a> to contribute the first one.
        </p>
      )
    }
</DocShell>

<script>
  if (window.location.search) import("../../lib/catalog-filter").then(({ restoreFromAddress }) => restoreFromAddress());
</script>

<style>
  .ledes {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
    max-width: var(--measure);
  }

  .shown {
    margin: var(--s-3) 0;
    font-size: var(--t-small);
  }
</style>
