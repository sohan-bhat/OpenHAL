---
import { codeHtml } from "../../lib/code";
import VerificationBadge from "../../components/VerificationBadge.astro";
import DocShell from "../../layouts/DocShell.astro";
import { formatG } from "../../lib/kernel/pyformat";
import type { ArgSpec } from "../../lib/kernel/model";
import { type LibraryEntry, libraryEntries } from "../../lib/library";
import { librarySidebar } from "../../lib/library-nav";
import { displayUnit } from "../../lib/playground/rpc";

export function getStaticPaths() {
  return libraryEntries().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: LibraryEntry };
const file = entry.file;
const num = (value: number | null) => (value === null ? "" : formatG(value));
const limitWord = (spec: { suggested: boolean; confirmed: unknown }) =>
  spec.suggested ? "suggested" : spec.confirmed || file?.confirmed ? "confirmed" : "unconfirmed";
function argText(name: string, spec: ArgSpec): string {
  const unit = displayUnit(spec.unit);
  const range = spec.min !== null && spec.max !== null ? ` ${formatG(spec.min)} to ${formatG(spec.max)}${unit ? ` ${unit}` : ""}` : unit ? ` in ${unit}` : ` ${spec.type}`;
  const step = spec.step !== null ? `, step ${formatG(spec.step)}` : "";
  const values = spec.values.length ? ` ${spec.values.join(", ")}` : "";
  return `${name}${values || range}${step}`;
}
---

<DocShell title={entry.title} description={`OpenHAL device file for ${entry.title}.`} repo={entry.path} sidebar={librarySidebar()} section="Device Library" wide>
  <p slot="after-title" class="meta">
    {entry.problems.length > 0 ? <span class="status blocked">invalid</span> : <VerificationBadge status={entry.verification} />}
    <code>{entry.path}</code>
  </p>

    {
      entry.problems.length > 0 && (
        <ul class="problems">
          {entry.problems.map((problem) => (
            <li>{problem}</li>
          ))}
        </ul>
      )
    }

    {
      file && (
        <div class="sheet">
          <table class="facts">
            <tbody>
              <tr><th scope="row">Id</th><td class="mono">{entry.deviceId}</td></tr>
              <tr><th scope="row">Manufacturer</th><td>{entry.manufacturer ?? "not set"}</td></tr>
              <tr><th scope="row">Model</th><td>{entry.model ?? "not set"}</td></tr>
              <tr><th scope="row">Driver</th><td class="mono"><a href={`/drivers/${entry.driver}/`}>{entry.driver}</a></td></tr>
              <tr><th scope="row">Hazard</th><td class="mono">{entry.hazard}</td></tr>
              <tr>
                <th scope="row">Limits</th>
                <td>
                  {entry.confirmed ? (
                    <span class="status ok">confirmed</span>
                  ) : (
                    <span class="limits">
                      <span class="status unverified">unconfirmed</span>
                      {entry.suggested.length > 0 ? (
                        <span>The library suggests limits for <span class="mono">{entry.suggested.join(", ")}</span>, and no person has confirmed those limits yet.</span>
                      ) : entry.writes + entry.actions === 0 ? (
                        <span>This file has read channels only, so nothing in the file changes the device.</span>
                      ) : (
                        <span>No person has confirmed the limits for <span class="mono">{entry.unconfirmed.join(", ")}</span> yet.</span>
                      )}
                      {entry.writes + entry.actions > 0 && <a href="/docs/library/#confirmation">How a person confirms the limits</a>}
                    </span>
                  )}
                </td>
              </tr>
              {entry.report && <tr><th scope="row">Report</th><td class="mono">{entry.report}</td></tr>}
            </tbody>
          </table>

          {Object.keys(file.write).length > 0 && (
            <div class="table-wrap stack">
              <table>
                <caption class="legend">Control channels</caption>
                <thead>
                  <tr><th scope="col">Channel</th><th scope="col">Min</th><th scope="col">Max</th><th scope="col">Step</th><th scope="col">Rate per s</th><th scope="col">Unit</th><th scope="col">Confirm</th><th scope="col">Limit</th></tr>
                </thead>
                <tbody>
                  {Object.entries(file.write).map(([name, spec]) => (
                    <tr>
                      <td data-label="Channel" class="mono">{name}</td>
                      <td data-label="Min" class="mono">{num(spec.min)}</td>
                      <td data-label="Max" class="mono">{num(spec.max)}</td>
                      <td data-label="Step" class="mono">{num(spec.step)}</td>
                      <td data-label="Rate per s" class="mono">{num(spec.max_change_per_s)}</td>
                      <td data-label="Unit">{displayUnit(spec.unit) ?? spec.type}</td>
                      <td data-label="Confirm">{spec.confirm}</td>
                      <td data-label="Limit">{limitWord(spec)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {Object.keys(file.actions).length > 0 && (
            <div class="table-wrap stack">
              <table>
                <caption class="legend">Actions</caption>
                <thead>
                  <tr><th scope="col">Action</th><th scope="col">Arguments</th><th scope="col">Confirm</th><th scope="col">Limit</th></tr>
                </thead>
                <tbody>
                  {Object.entries(file.actions).map(([name, spec]) => (
                    <tr>
                      <td data-label="Action" class="mono">{name}</td>
                      <td data-label="Arguments">
                        {Object.keys(spec.args).length === 0 ? (
                          <span class="muted">none</span>
                        ) : (
                          <ul class="args">
                            {Object.entries(spec.args).map(([arg, value]) => (
                              <li class="mono">{argText(arg, value)}</li>
                            ))}
                          </ul>
                        )}
                      </td>
                      <td data-label="Confirm">{spec.confirm}</td>
                      <td data-label="Limit">{limitWord(spec)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {Object.keys(file.read).length > 0 && (
            <div class="table-wrap stack">
              <table>
                <caption class="legend">Read channels</caption>
                <thead>
                  <tr><th scope="col">Channel</th><th scope="col">Type</th><th scope="col">Unit</th><th scope="col">Every</th></tr>
                </thead>
                <tbody>
                  {Object.entries(file.read).map(([name, spec]) => (
                    <tr>
                      <td data-label="Channel" class="mono">{name}</td>
                      <td data-label="Type">{spec.type}</td>
                      <td data-label="Unit">{displayUnit(spec.unit) ?? ""}</td>
                      <td data-label="Every" class="mono">{spec.every === null ? (spec.stream ? "stream" : "on request") : `${formatG(spec.every)} s`}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )
    }

    <Fragment set:html={codeHtml(entry.text, "yaml")} />
</DocShell>

<style>
  .meta {
    margin-top: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    align-items: center;
  }

  .sheet {
    display: grid;
    gap: var(--s-6);
  }

  .facts th {
    width: 10em;
  }

  caption {
    text-align: left;
    padding-bottom: var(--s-2);
  }

  .problems {
    color: var(--blocked);
  }

  .limits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
  }

  .args {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
