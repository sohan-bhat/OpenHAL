---
import { codeHtml } from "../../lib/code";
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from "../../components/ui/table";
import VerificationBadge from "../../components/VerificationBadge.astro";
import DocShell from "../../layouts/DocShell.astro";
import { formatG } from "../../lib/kernel/pyformat";
import type { ArgSpec } from "../../lib/kernel/model";
import { type LibraryEntry, libraryEntries } from "../../lib/library";
import { librarySidebar } from "../../lib/library-nav";
import { displayUnit } from "../../lib/playground/rpc";

export function getStaticPaths() {
  return libraryEntries().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: LibraryEntry };
const file = entry.file;
const num = (value: number | null) => (value === null ? "" : formatG(value));
const limitWord = (spec: { suggested: boolean; confirmed: unknown }) =>
  spec.suggested ? "suggested" : spec.confirmed || file?.confirmed ? "confirmed" : "unconfirmed";
function argText(name: string, spec: ArgSpec): string {
  const unit = displayUnit(spec.unit);
  const range = spec.min !== null && spec.max !== null ? ` ${formatG(spec.min)} to ${formatG(spec.max)}${unit ? ` ${unit}` : ""}` : unit ? ` in ${unit}` : ` ${spec.type}`;
  const step = spec.step !== null ? `, step ${formatG(spec.step)}` : "";
  const values = spec.values.length ? ` ${spec.values.join(", ")}` : "";
  return `${name}${values || range}${step}`;
}
---

<DocShell title={entry.title} description={`OpenHAL device file for ${entry.title}.`} repo={entry.path} sidebar={librarySidebar()} wide>
  <p slot="after-title" class="meta">
    {entry.problems.length > 0 ? <span class="status blocked">invalid</span> : <VerificationBadge status={entry.verification} />}
    <code>{entry.path}</code>
  </p>

    {
      entry.problems.length > 0 && (
        <ul class="problems">
          {entry.problems.map((problem) => (
            <li>{problem}</li>
          ))}
        </ul>
      )
    }

    {
      file && (
        <div class="sheet">
          <Table className="facts">
            <TableBody>
              <TableRow><TableHead scope="row">Id</TableHead><TableCell className="mono">{entry.deviceId}</TableCell></TableRow>
              <TableRow><TableHead scope="row">Manufacturer</TableHead><TableCell>{entry.manufacturer ?? "not set"}</TableCell></TableRow>
              <TableRow><TableHead scope="row">Model</TableHead><TableCell>{entry.model ?? "not set"}</TableCell></TableRow>
              <TableRow><TableHead scope="row">Driver</TableHead><TableCell className="mono"><a href={`/drivers/${entry.driver}/`}>{entry.driver}</a></TableCell></TableRow>
              <TableRow><TableHead scope="row">Hazard</TableHead><TableCell className="mono">{entry.hazard}</TableCell></TableRow>
              <TableRow>
                <TableHead scope="row">Limits</TableHead>
                <TableCell>
                  {entry.confirmed ? (
                    <span class="status ok">confirmed</span>
                  ) : (
                    <span class="limits">
                      <span class="status unverified">unconfirmed</span>
                      {entry.suggested.length > 0 ? (
                        <span>The library file holds suggested limits for <span class="mono">{entry.suggested.join(", ")}</span>, and no person has confirmed those limits yet.</span>
                      ) : entry.writes + entry.actions === 0 ? (
                        <span>This file has read channels only, so nothing in the file changes the device.</span>
                      ) : (
                        <span>No person has confirmed the limits for <span class="mono">{entry.unconfirmed.join(", ")}</span> yet.</span>
                      )}
                      {entry.writes + entry.actions > 0 && <a href="/docs/library/#confirmation">How a person confirms the limits</a>}
                    </span>
                  )}
                </TableCell>
              </TableRow>
              {entry.report && <TableRow><TableHead scope="row">Report</TableHead><TableCell className="mono">{entry.report}</TableCell></TableRow>}
            </TableBody>
          </Table>

          {Object.keys(file.write).length > 0 && (
            <div class="table-wrap stack">
              <Table>
                <TableCaption className="legend">Control channels</TableCaption>
                <TableHeader>
                  <TableRow><TableHead scope="col">Channel</TableHead><TableHead scope="col">Min</TableHead><TableHead scope="col">Max</TableHead><TableHead scope="col">Step</TableHead><TableHead scope="col">Rate per s</TableHead><TableHead scope="col">Unit</TableHead><TableHead scope="col">Confirm</TableHead><TableHead scope="col">Limit</TableHead></TableRow>
                </TableHeader>
                <TableBody>
                  {Object.entries(file.write).map(([name, spec]) => (
                    <TableRow>
                      <TableCell data-label="Channel" className="mono">{name}</TableCell>
                      <TableCell data-label="Min" className="mono">{num(spec.min)}</TableCell>
                      <TableCell data-label="Max" className="mono">{num(spec.max)}</TableCell>
                      <TableCell data-label="Step" className="mono">{num(spec.step)}</TableCell>
                      <TableCell data-label="Rate per s" className="mono">{num(spec.max_change_per_s)}</TableCell>
                      <TableCell data-label="Unit">{displayUnit(spec.unit) ?? spec.type}</TableCell>
                      <TableCell data-label="Confirm">{spec.confirm}</TableCell>
                      <TableCell data-label="Limit">{limitWord(spec)}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          )}

          {Object.keys(file.actions).length > 0 && (
            <div class="table-wrap stack">
              <Table>
                <TableCaption className="legend">Actions</TableCaption>
                <TableHeader>
                  <TableRow><TableHead scope="col">Action</TableHead><TableHead scope="col">Arguments</TableHead><TableHead scope="col">Confirm</TableHead><TableHead scope="col">Limit</TableHead></TableRow>
                </TableHeader>
                <TableBody>
                  {Object.entries(file.actions).map(([name, spec]) => (
                    <TableRow>
                      <TableCell data-label="Action" className="mono">{name}</TableCell>
                      <TableCell data-label="Arguments">
                        {Object.keys(spec.args).length === 0 ? (
                          <span class="muted">none</span>
                        ) : (
                          <ul class="args">
                            {Object.entries(spec.args).map(([arg, value]) => (
                              <li class="mono">{argText(arg, value)}</li>
                            ))}
                          </ul>
                        )}
                      </TableCell>
                      <TableCell data-label="Confirm">{spec.confirm}</TableCell>
                      <TableCell data-label="Limit">{limitWord(spec)}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          )}

          {Object.keys(file.read).length > 0 && (
            <div class="table-wrap stack">
              <Table>
                <TableCaption className="legend">Read channels</TableCaption>
                <TableHeader>
                  <TableRow><TableHead scope="col">Channel</TableHead><TableHead scope="col">Type</TableHead><TableHead scope="col">Unit</TableHead><TableHead scope="col">Every</TableHead></TableRow>
                </TableHeader>
                <TableBody>
                  {Object.entries(file.read).map(([name, spec]) => (
                    <TableRow>
                      <TableCell data-label="Channel" className="mono">{name}</TableCell>
                      <TableCell data-label="Type">{spec.type}</TableCell>
                      <TableCell data-label="Unit">{displayUnit(spec.unit) ?? ""}</TableCell>
                      <TableCell data-label="Every" className="mono">{spec.every === null ? (spec.stream ? "stream" : "on request") : `${formatG(spec.every)} s`}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          )}
        </div>
      )
    }

    <Fragment set:html={codeHtml(entry.text, "yaml")} />
</DocShell>

<style>
  .meta {
    margin-top: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    align-items: center;
  }

  .sheet {
    display: grid;
    gap: var(--s-6);
  }

  .sheet :global(.facts th) {
    width: 10em;
  }

  .problems {
    color: var(--blocked);
  }

  .limits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
  }

  .args {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
