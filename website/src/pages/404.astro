---
import MessageTrace from "../components/MessageTrace.astro";
import DocShell from "../layouts/DocShell.astro";
import { registryByName } from "../lib/protocol";
import { latestSpecHref } from "../lib/spec";

const unknown = registryByName("UNKNOWN_TARGET");
const entries = [
  { kind: "request" as const, method: "hal/devices/describe", params: { device: "/no-such-page/" } },
  { kind: "error" as const, code: unknown.code, name: unknown.name, reason: "There is no page at this address." },
];
---

<DocShell title="Page not found" description="There is no page at this address." search={false} pager={false} wide>
  <div class="page">
    <div data-not-found>
      <MessageTrace entries={entries} label="What happened" />
    </div>
    <ul class="links">
      <li><a href="/">Overview</a></li>
      <li><a href={latestSpecHref()}>Specification</a></li>
      <li><a href="/docs/">Documentation</a></li>
    </ul>
  </div>
</DocShell>

<script>
  const payload = document.querySelector("[data-not-found] .payload");
  if (payload && location.pathname !== "/404/" && location.pathname !== "/404.html") {
    const string = payload.querySelector(".syn-str");
    if (string) string.textContent = JSON.stringify(location.pathname);
  }
</script>

<style>
  .page {
    display: grid;
    gap: var(--s-5);
  }

  .page > * {
    max-width: 880px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
