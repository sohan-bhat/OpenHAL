---
// Every document from the repository that lives under /docs/, rendered at build time.
import { getCollection, render } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { routeFor } from "../../lib/markdown/routes.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .map((entry) => ({ entry, route: routeFor(entry.id) }))
    .filter(({ route }) => route?.startsWith("/docs/"))
    .map(({ entry, route }) => ({ params: { slug: route!.slice("/docs/".length, -1) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const title = String(remarkPluginFrontmatter.title ?? entry.data.title ?? entry.id);
---

<Doc title={title} repo={entry.id} headings={headings}>
  <Content />
</Doc>
