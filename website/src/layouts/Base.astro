---
import { transformWithEsbuild } from "vite";
import "../styles/global.css";
import "../styles/code.css";
import atkinsonMono from "../fonts/atkinson-hyperlegible-mono-normal.woff2?url";
import atkinson from "../fonts/atkinson-hyperlegible-next-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { PITCH, PRODUCT_NAME } from "../config/brand";
import { ogPath } from "../lib/pages";
import pageTurnSource from "./page-turn.js?raw";

interface Props {
  title: string;
  description?: string;
  bare?: boolean;
  type?: "website" | "article";
  noindex?: boolean;
  canonical?: string;
  search?: boolean;
  mono?: boolean;
}

const { title, description = PITCH, bare = false, type = "website", noindex = false, canonical: canonicalPath, search = true, mono = true } = Astro.props;
const fullTitle = bare ? title : `${title} | ${PRODUCT_NAME}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const image = new URL(ogPath(Astro.url.pathname), Astro.site);
const indexed = search && !noindex && canonical.pathname === new URL(Astro.url.pathname, Astro.site).pathname;
const away = "[download], [target='_blank'], [rel~='external'], a[href^='#'], a[href*='/pagefind/'], a[href*='/captures/'], a[href*='/og/']";
const pageTurn = (await transformWithEsbuild(pageTurnSource, "page-turn.js", { minify: true })).code.trim();
const speculation = JSON.stringify({
  prerender: [{ source: "document", where: { and: [{ href_matches: "/*" }, { not: { selector_matches: `${away}, a[href*='/spec/playground/']` } }] }, eagerness: "moderate" }],
  prefetch: [{ source: "document", where: { and: [{ href_matches: "/*" }, { not: { selector_matches: away } }] }, eagerness: "moderate" }],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} data-pagefind-meta="description[content]" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline set:html={pageTurn} />
    <link rel="preload" href={atkinson} as="font" type="font/woff2" crossorigin />
    {mono && <link rel="preload" href={atkinsonMono} as="font" type="font/woff2" crossorigin />}
    <script type="speculationrules" is:inline set:html={speculation} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${PRODUCT_NAME}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script>
      import { searchDialog } from "../components/search";
      import { versionMenu } from "../components/version-menu";
      import { prefetchOnIntent } from "../lib/prefetch-intent";

      searchDialog();
      versionMenu();
      if (!HTMLScriptElement.supports?.("speculationrules")) prefetchOnIntent();

      function commandsOf(figure: HTMLElement, text: string): string {
        if (figure.dataset.language !== "sh" || !/^\$ /m.test(text)) return text;
        return text
          .split("\n")
          .filter((line) => line.startsWith("$ "))
          .map((line) => line.slice(2))
          .join("\n");
      }

      for (const figure of document.querySelectorAll<HTMLElement>("figure.code-block")) {
        const code = figure.querySelector("pre");
        if (!code || !navigator.clipboard) continue;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-button";
        button.textContent = "Copy";
        button.setAttribute("aria-label", "Copy code");
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(commandsOf(figure, code.innerText.replace(/\n$/, "")));
          button.textContent = "Copied";
          window.setTimeout(() => (button.textContent = "Copy"), 1500);
        });
        figure.append(button);
      }

      function tableName(wrap: HTMLElement): string {
        const figure = wrap.closest("figure[aria-label]")?.getAttribute("aria-label");
        if (figure?.trim()) return figure.trim();
        const table = wrap.querySelector("table");
        const named = table?.getAttribute("aria-label") ?? table?.querySelector("caption")?.textContent;
        if (named?.trim()) return named.trim();
        let node: Element | null = wrap.previousElementSibling;
        while (node && !/^H[1-6]$/.test(node.tagName)) node = node.previousElementSibling;
        return node?.textContent?.trim() ? `${node.textContent.trim()} table` : "Table";
      }

      const scrolling = new ResizeObserver((entries) => {
        for (const entry of entries) {
          const wrap = entry.target as HTMLElement;
          if (wrap.scrollWidth > wrap.clientWidth + 1) {
            wrap.tabIndex = 0;
            wrap.setAttribute("role", "region");
            wrap.setAttribute("aria-label", tableName(wrap));
          } else {
            wrap.removeAttribute("tabindex");
            wrap.removeAttribute("role");
            wrap.removeAttribute("aria-label");
          }
        }
      });
      for (const wrap of document.querySelectorAll<HTMLElement>(".table-wrap, .diagram-scroll")) scrolling.observe(wrap);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" data-pagefind-body={indexed ? "" : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
