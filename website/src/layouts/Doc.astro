---
// A documentation page. Sidebar of every published document, the body, and the page's headings.
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import { docsNav } from "../lib/docs-nav";

interface Props {
  title: string;
  description?: string;
  repo?: string;
  headings?: MarkdownHeading[];
}

const { title, description, repo, headings = [] } = Astro.props;
const nav = await docsNav();
const path = Astro.url.pathname;
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base title={title} description={description}>
  <div class="wrap doc">
    <article class="body">
      <header class="doc-header">
        <p class="jump"><a href="#docs-nav">All documentation</a></p>
        <slot name="before-title" />
        <h1 class="page-title">{title}</h1>
        {repo && <p class="source legend">Source <code>{repo}</code></p>}
        <slot name="after-title" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
    <div class="sidebar" id="docs-nav">
      <nav aria-label="Documentation">
        {
          nav.map((group) => (
            <div class="group">
              <p class="legend">{group.name}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    {
      toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <p class="legend">On this page</p>
          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .doc {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-6);
  }

  .sidebar {
    border-top: 1px solid var(--ink);
    padding-top: var(--s-3);
  }

  .jump {
    font-size: var(--t-2);
  }

  .group {
    margin-top: var(--s-4);
  }

  .group .legend {
    color: var(--ink-2);
    margin-bottom: var(--s-1);
  }

  .sidebar ul,
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar a {
    display: block;
    padding: var(--s-1) var(--s-3);
    border-left: 2px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--t-2);
    line-height: var(--lh-2);
  }

  .sidebar a:hover {
    border-left-color: var(--ink-2);
  }

  .sidebar a[aria-current="page"] {
    border-left-color: var(--ink);
    font-weight: 700;
  }

  .body {
    min-width: 0;
  }

  .doc-header {
    padding-bottom: var(--s-4);
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--ink);
  }

  .source {
    margin-top: var(--s-2);
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  .source code {
    font-size: var(--t-0);
  }

  .toc {
    display: none;
  }

  .toc .legend {
    color: var(--ink-2);
    margin-bottom: var(--s-2);
  }

  .toc a {
    display: block;
    padding: 2px 0;
    font-size: var(--t-1);
    line-height: var(--lh-1);
    color: var(--ink-2);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--signal);
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .doc {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--s-7);
    }

    .sidebar {
      grid-column: 1;
      grid-row: 1;
      border-top: 0;
      padding-top: 0;
    }

    .body {
      grid-column: 2;
      grid-row: 1;
    }

    .jump {
      display: none;
    }

    .sidebar {
      position: sticky;
      top: var(--s-5);
      align-self: start;
      max-height: calc(100dvh - var(--s-6));
      overflow-y: auto;
    }
  }

  @media (min-width: 1280px) {
    .doc {
      grid-template-columns: 220px minmax(0, 1fr) 200px;
    }

    .toc {
      grid-column: 3;
      grid-row: 1;
    }

    .toc {
      display: block;
      position: sticky;
      top: var(--s-5);
      align-self: start;
    }
  }
</style>
