---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { MarkdownHeading } from "astro";
import "../styles/prose.css";
import "../styles/trace.css";
import { PRODUCT_NAME } from "../config/brand";
import { editUrl } from "../config/site";
import type { SideGroup } from "../lib/nav-types";
import { starlightSidebar } from "../lib/starlight-nav";

type HeadEntry = { tag: "title" | "base" | "link" | "style" | "meta" | "script" | "noscript" | "template"; attrs?: Record<string, string | boolean | undefined>; content?: string };

interface Props {
  title: string;
  description?: string;
  repo?: string;
  headings?: MarkdownHeading[];
  sidebar?: SideGroup[];
  canonical?: string;
  noindex?: boolean;
  wide?: boolean;
  pager?: boolean;
  number?: string;
  mono?: boolean;
  search?: boolean;
  type?: "website" | "article";
  home?: boolean;
  head?: HeadEntry[];
}

const { title, description, repo, headings = [], sidebar = [], canonical, noindex = false, wide = false, pager = true, number, mono = true, search = true, type = "website", home = false, head = [] } = Astro.props;
const own = new URL(Astro.url.pathname, Astro.site);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const indexed = search && !noindex && canonicalUrl.pathname === own.pathname;
const extra: HeadEntry[] = [
  { tag: "meta", attrs: { property: "og:type", content: type } },
  ...(canonical ? [{ tag: "link" as const, attrs: { rel: "canonical", href: canonicalUrl.href } }] : []),
  ...(noindex ? [{ tag: "meta" as const, attrs: { name: "robots", content: "noindex" } }] : []),
  ...head,
];
const frontmatter = {
  title,
  description,
  template: home ? ("splash" as const) : ("doc" as const),
  ...(home ? { hero: { title: PRODUCT_NAME } } : {}),
  editUrl: repo ? editUrl(repo) : (false as const),
  tableOfContents: wide || home ? (false as const) : undefined,
  pagefind: indexed,
  number,
  mono,
  head: extra,
  ...(pager ? {} : { prev: false as const, next: false as const }),
};
---

<StarlightPage frontmatter={frontmatter} sidebar={starlightSidebar(sidebar)} headings={headings} hasSidebar>
  {
    home ? (
      <div class="not-content oh-content oh-home" id="_top">
        <slot />
      </div>
    ) : (
      <div class:list={["not-content", "oh-content", { "oh-wide": wide }]}>
        {
          Astro.slots.has("after-title") && (
            <div class="oh-lede">
              <slot name="after-title" />
            </div>
          )
        }
        <div class={wide ? "data" : "prose"}>
          <slot />
        </div>
      </div>
    )
  }
</StarlightPage>
